---
/**
 * Inline SVG icon from the open-source lucide set (@iconify-json/lucide), resolved at build time.
 * No CDN, no runtime fetch. Decorative by default; pass `label` to make it an announced image.
 *
 * Props: name (lucide icon name, e.g. "sprout"), size (px, default 24), label?, class?
 */
import lucide from '@iconify-json/lucide/icons.json';
import { CUSTOM_ICONS } from '../lib/custom-icons';

interface Props {
  name: string;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 24, label, class: className } = Astro.props;

const icons: Record<string, { body: string }> = lucide.icons;
const aliases: Record<string, { parent: string }> = lucide.aliases;

function resolveBody(iconName: string): string | undefined {
  const custom = CUSTOM_ICONS[iconName];
  if (custom) return custom;
  const direct = icons[iconName];
  if (direct) return direct.body;
  const alias = aliases[iconName];
  if (alias) return icons[alias.parent]?.body;
  return undefined;
}

const body = resolveBody(name);
if (body === undefined) {
  throw new Error(`Icon "${name}" is not in the lucide set or src/lib/custom-icons.ts`);
}
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>
