---
/**
 * "Sponsored by Reveltek" band shown above the footer on every page (BaseLayout renders it).
 * Ink-wash mountains behind (cream version in light theme, dark version in dark theme) and the
 * official Reveltek logo (colour on cream, white on dark).
 *
 * Props: sponsor (default "Reveltek"), href (default "/sponsors")
 */
import Picture from './Picture.astro';

interface Props {
  sponsor?: string;
  href?: string;
}
const { sponsor = 'Reveltek', href = '/sponsors' } = Astro.props;
---

<section class="sponsor-band" aria-label={`Sponsored by ${sponsor}`}>
  <div class="backdrop" aria-hidden="true">
    <span class="only-light"><Picture base="mountains-band" fallback="png" width={2400} height={220} /></span>
    <span class="only-dark"><Picture base="mountains-band-dark" fallback="png" width={2400} height={220} /></span>
  </div>
  <div class="container inner">
    <span class="lead">Sponsored by</span>
    <span class="rule" aria-hidden="true"></span>
    <a class="sponsor" href={href}>
      <img class="only-light" src="/images/reveltek-logo.svg" alt={sponsor} width="134" height="79" />
      <img class="only-dark" src="/images/reveltek-logo-white.svg" alt={sponsor} width="134" height="79" />
    </a>
    <span class="rule" aria-hidden="true"></span>
  </div>
</section>

<style>
  .sponsor-band {
    position: relative;
    isolation: isolate;
    background: var(--paper);
    padding-block: var(--space-7) var(--space-6);
    overflow: hidden;
  }
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .backdrop span {
    position: absolute;
    inset: 0;
  }
  .backdrop :global(picture) {
    display: block;
    height: 100%;
  }
  .backdrop :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .lead {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-xl);
  }
  .rule {
    flex: 0 1 clamp(2rem, 8vw, 6rem);
    height: 2px;
    background: var(--ink-muted);
    opacity: 0.6;
  }
  .sponsor {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }
  .sponsor img {
    height: 84px;
    width: auto;
  }
  /* Full-colour logo sits on a paper plate so it keeps its true colours against the ink-wash hills. */
  .sponsor img.only-light {
    box-sizing: content-box;
    padding: 0.9rem 1.6rem;
    background: #fffaf0;
    border: 1px solid rgb(122 106 74 / 0.35);
    border-radius: 1rem;
    box-shadow: 0 6px 18px rgb(60 48 28 / 0.18);
  }
  @media (max-width: 40rem) {
    .rule {
      display: none;
    }
  }
</style>
