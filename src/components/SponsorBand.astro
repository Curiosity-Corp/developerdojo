---
/**
 * "Sponsored by Reveltek" band shown above the footer on every page (BaseLayout renders it).
 *
 * Props:
 *  - image?: URL of the ink-mountain backdrop. Defaults to public/images/mountains-band.* if present,
 *    otherwise the built-in SVG placeholder.
 *  - logo?: URL of the sponsor logo. Defaults to public/images/reveltek-logo.* if present,
 *    otherwise a plain text wordmark.
 *  - sponsor (default "Reveltek"), href (default "/sponsors")
 */
import MountainsArt from './MountainsArt.astro';
import { findImage } from '../lib/images';

interface Props {
  image?: string;
  logo?: string;
  sponsor?: string;
  href?: string;
}
const {
  image = findImage('mountains-band'),
  logo = findImage('reveltek-logo'),
  sponsor = 'Reveltek',
  href = '/sponsors',
} = Astro.props;
---

<section class="sponsor-band" aria-label={`Sponsored by ${sponsor}`}>
  <div class="backdrop" style={image ? `background-image:url('${image}')` : undefined} aria-hidden="true">
    {!image && <MountainsArt />}
  </div>
  <div class="container inner">
    <span class="lead">Sponsored by</span>
    <span class="rule" aria-hidden="true"></span>
    <a class="sponsor" href={href}>
      {logo ? <img src={logo} alt={sponsor} height="40" /> : <span class="wordmark">{sponsor.toUpperCase()}</span>}
    </a>
    <span class="rule" aria-hidden="true"></span>
  </div>
</section>

<style>
  .sponsor-band {
    position: relative;
    isolation: isolate;
    background: var(--paper);
    padding-block: var(--space-7) var(--space-6);
    overflow: hidden;
  }
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center bottom;
    background-repeat: no-repeat;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .lead {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-xl);
  }
  .rule {
    flex: 0 1 clamp(2rem, 8vw, 6rem);
    height: 2px;
    background: var(--ink-muted);
    opacity: 0.6;
  }
  .sponsor {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }
  .sponsor img {
    display: block;
    height: 40px;
    width: auto;
  }
  .wordmark {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1.7rem;
    letter-spacing: 0.22em;
    color: var(--rust-text);
  }
  @media (max-width: 40rem) {
    .rule {
      display: none;
    }
  }
</style>
