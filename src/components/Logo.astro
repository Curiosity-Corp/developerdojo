---
/**
 * Wordmark (gold brackets + DEVELOPERDOJO) as the outlined SVG files. Links home. Prop: href (default "/").
 * The header and footer are dark bands in both themes, so the on-dark wordmark is the default; pass
 * surface="paper" to get the cream-surface wordmark in light theme and the on-dark one in dark theme.
 */
interface Props {
  href?: string;
  surface?: 'band' | 'paper';
}
const { href = '/', surface = 'band' } = Astro.props;
---

<a class="logo" href={href} aria-label="Developer Dojo, home">
  {
    surface === 'paper' ? (
      <>
        <img class="only-light" src="/images/logo-light.svg" alt="" width="365" height="40" />
        <img class="only-dark" src="/images/logo-dark.svg" alt="" width="365" height="40" />
      </>
    ) : (
      <img src="/images/logo-dark.svg" alt="" width="365" height="40" />
    )
  }
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    flex: none;
    text-decoration: none;
  }
  .logo img {
    display: block;
    height: 30px;
    width: auto;
  }
  @media (max-width: 30rem) {
    .logo img {
      height: 24px;
    }
  }
  /* Under about 18.5rem (a 390px phone at 200% zoom) the full wordmark cannot share the bar with the search and
     menu buttons, and the page would scroll sideways. Show only the gold brackets; the link keeps its name. */
  @media (max-width: 18.5rem) {
    .logo {
      width: 1.75rem;
      overflow: hidden;
    }
    .logo img {
      flex: none;
      max-width: none;
    }
  }
</style>
