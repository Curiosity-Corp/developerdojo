---
/** Wordmark: gold angle brackets + DEVELOPERDOJO. Links home. Prop: href (default "/"). */
interface Props {
  href?: string;
}
const { href = '/' } = Astro.props;
---

<a class="logo" href={href} aria-label="Developer Dojo, home">
  <svg class="mark" viewBox="0 0 40 40" width="30" height="30" aria-hidden="true" focusable="false">
    <path
      d="M15 5 5 20l10 15M25 5l10 15-10 15"
      fill="none"
      stroke="currentColor"
      stroke-width="3.2"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="word" aria-hidden="true">DEVELOPER<span class="dojo">DOJO</span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--band-text);
    text-decoration: none;
  }
  .mark {
    color: var(--gold);
    flex: none;
  }
  .word {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: 0.01em;
  }
  .dojo {
    color: var(--band-muted);
    font-weight: 700;
  }
</style>
