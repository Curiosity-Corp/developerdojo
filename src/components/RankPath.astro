---
/**
 * Developer -> Master Developer -> Sensei cards with icons and arrows (data in src/lib/ranks.ts).
 *
 * Props:
 *  - highlight?: RankId to emphasise (e.g. "sensei" on the Sensei page)
 *  - compact?: icon + name only, for hero side cards
 *  - descriptions?: Partial<Record<RankId, string>> to override the default copy per page
 *  - linked?: make each card a link to rank.href (default false)
 */
import Icon from './Icon.astro';
import { RANKS, type RankId } from '../lib/ranks';

interface Props {
  highlight?: RankId;
  compact?: boolean;
  descriptions?: Partial<Record<RankId, string>>;
  linked?: boolean;
}
const { highlight, compact = false, descriptions = {}, linked = false } = Astro.props;
---

<ol class:list={['rank-path', { compact }]}>
  {
    RANKS.map((rank, index) => {
      const Card = linked ? 'a' : 'div';
      return (
        <>
          <li class:list={['rank', `tone-${rank.tone}`, { highlighted: highlight === rank.id }]}>
            <Card class="card" href={linked ? rank.href : undefined}>
              <img
                class="tile"
                src={`/images/rank-${rank.id}.svg`}
                alt=""
                aria-hidden="true"
                width={compact ? 44 : 56}
                height={compact ? 44 : 56}
              />
              <span class="text">
                <span class="name">{rank.name}</span>
                {!compact && <span class="desc">{descriptions[rank.id] ?? rank.description}</span>}
              </span>
            </Card>
          </li>
          {index < RANKS.length - 1 && (
            <li class="arrow" aria-hidden="true">
              <Icon name="arrow-right" size={24} />
            </li>
          )}
        </>
      );
    })
  }
</ol>

<style>
  .rank-path {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    align-items: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 62rem) {
    .rank-path {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
  .rank {
    display: flex;
  }
  .card {
    display: grid;
    flex: 1;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'tile name'
      'desc desc';
    column-gap: var(--space-3);
    row-gap: var(--space-2);
    align-items: center;
    align-content: start;
    padding: var(--space-4);
    background: var(--paper-raised);
    color: var(--ink);
    border: 1px solid var(--line);
    border-bottom: 6px solid var(--tone);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    text-decoration: none;
  }
  a.card:hover {
    border-color: var(--tone);
  }
  .highlighted .card {
    background: color-mix(in srgb, var(--tone) 12%, var(--paper-raised));
    border-color: var(--tone);
  }
  .tile {
    grid-area: tile;
    display: block;
    width: 56px;
    height: 56px;
  }
  .text {
    display: contents;
  }
  .name {
    display: block;
    font-family: var(--font-serif);
    font-weight: 700;
    grid-area: name;
    font-size: var(--text-xl);
    line-height: 1.15;
  }
  .desc {
    grid-area: desc;
    display: block;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.5;
  }
  .arrow {
    display: grid;
    place-items: center;
    color: var(--ink-muted);
    /* Decorative. When it is turned on its side (phone widths) its box lies over the middle of the cards,
       so it must not catch taps meant for the card link. */
    pointer-events: none;
  }
  @media (max-width: 61.99rem) {
    .arrow {
      transform: rotate(90deg);
      padding-block: 0;
    }
  }
  .compact .card {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'tile' 'name';
    justify-items: center;
    text-align: center;
    padding: var(--space-3);
    gap: var(--space-2);
  }
  .compact .tile {
    width: 44px;
    height: 44px;
  }
  .compact .name {
    font-size: var(--text-base);
  }
  .compact {
    gap: var(--space-2);
  }
  @media (min-width: 40rem) {
    .compact {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    }
    .compact .arrow {
      transform: none;
    }
  }
  .tone-olive {
    --tone: var(--tone-olive);
  }
  .tone-gold {
    --tone: var(--tone-gold);
  }
  .tone-rust {
    --tone: var(--tone-rust);
  }
</style>
