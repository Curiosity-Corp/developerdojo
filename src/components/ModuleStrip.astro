---
/**
 * A titled strip of numbered training modules, each linking to its library page and (with JS)
 * carrying a "Mark complete" toggle that ProgressPanel's script wires up. Works without JS: the
 * links still work and the toggles stay hidden.
 *
 * Props:
 *  - title, note?: strip heading and right-hand note
 *  - icon: lucide icon for the strip heading
 *  - tone: "olive" (Developer) | "rust" (Master Developer)
 *  - modules: TrainModule[] (src/lib/progress.ts)
 *  - wide: columns when the strip is wide (6 for Developer weeks, 4 for Master modules)
 */
import Icon from './Icon.astro';
import type { TrainModule } from '../lib/progress';

interface Props {
  title: string;
  note?: string;
  icon: string;
  tone?: 'olive' | 'rust';
  modules: readonly TrainModule[];
  wide: 4 | 6;
  id?: string;
}
const { title, note, icon, tone = 'olive', modules, wide, id } = Astro.props;
---

<section class:list={['strip', `tone-${tone}`, `wide-${wide}`]} id={id} aria-labelledby={id ? `${id}-title` : undefined}>
  <header class="strip-head">
    <Icon name={icon} size={26} />
    <h2 id={id ? `${id}-title` : undefined}>{title}</h2>
    {note && <p>{note}</p>}
  </header>
  <ol class="modules">
    {
      modules.map((module) => (
        <li class="module" data-module-card={module.id}>
          <a class="module-link" href={module.href}>
            <span class="tag">{module.label}</span>
            <Icon name={module.icon} size={30} />
            <span class="module-title">{module.title}</span>
            <span class="module-desc">{module.description}</span>
          </a>
          <button class="mark" type="button" data-module={module.id} aria-pressed="false" hidden>
            <Icon name="circle" size={16} class="off" />
            <Icon name="circle-check-big" size={16} class="on" />
            <span class="mark-label">Mark complete</span>
            <span class="visually-hidden">: {module.label}, {module.title}</span>
          </button>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .strip {
    --strip: var(--tone-olive);
    container: strip / inline-size;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .tone-rust {
    --strip: var(--rust);
  }
  .strip-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--band);
    color: var(--band-text);
    border-bottom: 3px solid var(--strip);
  }
  .tone-rust .strip-head {
    background: color-mix(in srgb, var(--rust) 78%, #000);
  }
  .strip-head h2 {
    margin: 0;
    font-size: var(--text-xl);
    color: inherit;
  }
  .strip-head p {
    margin: 0 0 0 auto;
    font-size: var(--text-sm);
    color: var(--band-muted);
  }
  .tone-rust .strip-head p {
    color: #f6e6d2;
  }
  .modules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-4);
    list-style: none;
  }
  @container strip (min-width: 34rem) {
    .modules {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .wide-4 .modules {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @container strip (min-width: 44rem) {
    .wide-4 .modules {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @container strip (min-width: 66rem) {
    .wide-6 .modules {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  .module {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .module.done {
    border-color: var(--strip);
    background: color-mix(in srgb, var(--strip) 12%, var(--paper));
  }
  .module-link {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-2) var(--space-2);
    text-align: center;
    color: var(--ink);
    text-decoration: none;
  }
  .module-link:hover .module-title {
    text-decoration: underline;
  }
  .module-link :global(svg) {
    color: var(--strip);
  }
  .tag {
    padding: 0.1rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--strip) 18%, var(--paper-raised));
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink);
  }
  .module-title {
    font-family: var(--font-serif);
    font-weight: 700;
    line-height: 1.2;
  }
  .module-desc {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.35;
  }
  .mark {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin: 0 var(--space-2) var(--space-2);
    padding: 0.4rem 0.5rem;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1.5px solid var(--line-strong);
    border-radius: 8px;
    cursor: pointer;
  }
  .mark[hidden] {
    display: none;
  }
  .mark:hover {
    border-color: var(--ink);
  }
  .mark :global(.on) {
    display: none;
  }
  .mark[aria-pressed='true'] {
    background: color-mix(in srgb, var(--strip) 24%, var(--paper-raised));
    border-color: var(--strip);
  }
  .mark[aria-pressed='true'] :global(.on) {
    color: var(--strip);
    display: inline-block;
  }
  .mark[aria-pressed='true'] :global(.off) {
    display: none;
  }
  .mark:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
