---
import Icon from './Icon.astro';
const steps = [
  { title: 'You', icon: 'user-round' },
  { title: 'AI assistant', icon: 'bot' },
  { title: 'Check', icon: 'shield-check' },
  { title: 'Your result', icon: 'sparkles' },
] as const;
---
<div class="quick-stack" aria-label="Your first development stack">
  <p class="label">Your first stack</p>
  <ol>
    {steps.map((step) => <li><span class="icon"><Icon name={step.icon} size={25} /></span><strong>{step.title}</strong></li>)}
  </ol>
</div>
<style>
  .quick-stack { padding: var(--space-4); border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper-raised); }
  .label { color: var(--ink-muted); font-size: var(--text-sm); font-weight: 700; margin: 0 0 var(--space-3); }
  ol { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-2); padding: 0; margin: 0; list-style: none; }
  li { display: grid; justify-items: center; align-content: start; text-align: center; gap: var(--space-2); font-size: var(--text-sm); overflow-wrap: anywhere; }
  .icon { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: var(--paper-sunk); color: var(--olive-text); }
  @media (max-width: 24rem) { ol { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
