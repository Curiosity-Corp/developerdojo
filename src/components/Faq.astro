---
/**
 * Accessible FAQ built on native <details>. Works without JavaScript.
 * Props: items: { question, answer }[]. `answer` is trusted, author-written HTML (links allowed).
 */
interface Item {
  question: string;
  answer: string;
}
interface Props {
  items: readonly Item[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p set:html={item.answer} />
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: var(--space-2);
  }
  details {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0 var(--space-4);
  }
  summary {
    cursor: pointer;
    padding: var(--space-3) 0;
    font-weight: 700;
    list-style-position: outside;
  }
  details[open] summary {
    border-bottom: 1px solid var(--line);
  }
  p {
    margin: var(--space-3) 0;
    color: var(--ink-muted);
  }
  p :global(a) {
    color: var(--link);
    font-weight: 600;
  }
</style>
