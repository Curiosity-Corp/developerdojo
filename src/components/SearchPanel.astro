---
/**
 * Search box with results, backed by the Pagefind index that `npm run build` writes to /pagefind.
 * Without JavaScript (or in `astro dev`, where there is no index) it explains itself instead of failing.
 * The behaviour lives in the script below and attaches to every [data-search] root on the page.
 *
 * Props: id (unique prefix for element ids), label? (visible label), autofocus? (dialog use)
 */
interface Props {
  id: string;
  label?: string;
}
const { id, label = 'Search the whole site' } = Astro.props;
---

<div class="search-panel" data-search data-pagefind-ignore>
  <form role="search" aria-label={label} data-search-form>
    <label for={`${id}-input`}>{label}</label>
    <input
      id={`${id}-input`}
      type="search"
      placeholder="Try: design, cloud, audio, agents"
      autocomplete="off"
      spellcheck="false"
      maxlength="160"
      aria-describedby={`${id}-status`}
      data-search-input
    />
  </form>
  <p id={`${id}-status`} class="status" role="status" aria-live="polite" data-search-status></p>
  <div class="suggestions" data-search-suggestions></div>
  <div class="results" data-search-results></div>
  <noscript><p>Search needs JavaScript. You can still browse the <a href="/library">library</a>.</p></noscript>
</div>

<script>
  import { SEARCH_GROUP_LABELS, SEARCH_GROUP_ORDER, classifyUrl } from '../lib/search-groups';
  import { correctSearch, relatedSearches } from '../lib/search-guidance';

  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: { title?: string; group?: string };
  }
  interface PagefindSearch {
    results: { data: () => Promise<PagefindResultData> }[];
  }
  interface PagefindApi {
    init: () => Promise<void>;
    search: (term: string) => Promise<PagefindSearch>;
    debouncedSearch: (term: string, options?: object, wait?: number) => Promise<PagefindSearch | null>;
  }

  let vocabulary: Promise<string[]> | undefined;
  function loadVocabulary(): Promise<string[]> {
    vocabulary ??= fetch('/search-vocabulary.json').then(async (response) => {
      if (!response.ok) return [];
      const value: unknown = await response.json();
      return Array.isArray(value) ? value.filter((item): item is string => typeof item === 'string') : [];
    }).catch(() => []);
    return vocabulary;
  }

  let pagefind: Promise<PagefindApi> | undefined;
  function loadPagefind(): Promise<PagefindApi> {
    // The index is generated after the Astro build, so the bundler must not try to resolve it.
    const url = '/pagefind/pagefind.js';
    pagefind ??= import(/* @vite-ignore */ url).then(async (api: PagefindApi) => {
      await api.init();
      return api;
    }).catch((error: unknown) => {
      // A failed preload must not permanently poison the shared promise.
      pagefind = undefined;
      throw error;
    });
    return pagefind;
  }

  const MAX_RESULTS = 24;
  const FIRST_RESULTS = 6;

  function appendResults(container: HTMLElement, items: PagefindResultData[]): void {
    for (const item of items) {
      const group = classifyUrl(item.url);
      let section = container.querySelector<HTMLElement>(`[data-result-group="${group}"]`);
      if (!section) {
        section = document.createElement('section');
        section.dataset.resultGroup = group;
        const heading = document.createElement('h3');
        heading.textContent = SEARCH_GROUP_LABELS[group];
        section.append(heading, document.createElement('ul'));
        // Keep groups in the documented order without replacing a link the learner is using.
        const groupIndex = SEARCH_GROUP_ORDER.indexOf(group);
        const next = SEARCH_GROUP_ORDER.slice(groupIndex + 1)
          .map((name) => container.querySelector(`[data-result-group="${name}"]`))
          .find((element) => element !== null);
        container.insertBefore(section, next ?? null);
      }
      const list = section.querySelector('ul');
      if (list) {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = item.url;
        link.textContent = item.meta.title ?? item.url;
        li.append(link);
        if (item.meta.group) {
          const where = document.createElement('span');
          where.className = 'where';
          where.textContent = item.meta.group;
          li.append(where);
        }
        const snippet = document.createElement('p');
        // Pagefind returns the excerpt as escaped text with <mark> around the matches.
        snippet.innerHTML = item.excerpt;
        li.append(snippet);
        list.append(li);
      }
    }
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-search]')) {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const form = root.querySelector<HTMLFormElement>('[data-search-form]');
    const status = root.querySelector<HTMLElement>('[data-search-status]');
    const results = root.querySelector<HTMLElement>('[data-search-results]');
    const suggestions = root.querySelector<HTMLElement>('[data-search-suggestions]');
    if (!input || !form || !status || !results || !suggestions) continue;

    let latest = 0;
    const run = async (): Promise<void> => {
      const term = input.value.trim();
      const ticket = ++latest;
      if (term.length === 0) {
        status.textContent = '';
        results.replaceChildren();
        suggestions.replaceChildren();
        return;
      }
      status.textContent = 'Searching…';
      results.replaceChildren();
      suggestions.replaceChildren();
      const related = relatedSearches(term);
      if (related.length) {
        const label = document.createElement('p');
        label.textContent = 'Explore related searches';
        const list = document.createElement('div');
        list.className = 'suggestion-list';
        for (const relatedTerm of related) {
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = relatedTerm;
          button.addEventListener('click', () => {
            input.value = relatedTerm;
            input.focus();
            void run();
          });
          list.append(button);
        }
        suggestions.append(label, list);
      }
      try {
        const api = await loadPagefind();
        let search = await api.debouncedSearch(term, {}, 150);
        if (search === null || ticket !== latest) return; // a newer keystroke replaced this search
        let correction: string | null = null;
        if (search.results.length === 0) {
          const proposed = correctSearch(term, await loadVocabulary());
          if (ticket !== latest) return;
          if (proposed) {
            const close = await api.search(proposed);
            if (ticket !== latest) return;
            if (close.results.length > 0) {
              correction = proposed;
              search = close;
            }
          }
        }
        const selected = search.results.slice(0, MAX_RESULTS);
        const data = await Promise.all(selected.slice(0, FIRST_RESULTS).map((result) => result.data()));
        if (ticket !== latest) return;
        appendResults(results, data);
        status.textContent =
          correction
            ? `No results for "${term}". Showing ${search.results.length} close ${search.results.length === 1 ? 'match' : 'matches'} for "${correction}".`
            : search.results.length === 0
            ? `No results for "${term}". Try a shorter or different word.`
            : `${search.results.length} ${search.results.length === 1 ? 'result' : 'results'} for "${term}"`;
        // Fetch the rest after showing the first results, without replacing focused links.
        const remaining = await Promise.allSettled(selected.slice(FIRST_RESULTS).map((result) => result.data()));
        if (ticket !== latest) return;
        appendResults(results, remaining.flatMap((result) => result.status === 'fulfilled' ? [result.value] : []));
        if (remaining.some((result) => result.status === 'rejected')) {
          status.textContent += ' Some results could not load; try again.';
        }
      } catch (error) {
        if (ticket !== latest) return;
        console.warn('Search is not available:', error);
        status.textContent = 'Search is not available here. It works on the published site.';
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      void run();
    });
    // Start loading on explicit search intent, so it can initialize while the learner types.
    input.addEventListener('focus', () => { void loadPagefind().catch(() => undefined); });
    input.addEventListener('input', () => void run());
  }
</script>

<style>
  .search-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    color: var(--ink);
  }
  form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
  }
  label {
    font-weight: 700;
  }
  input {
    min-width: 0;
    font: inherit;
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--paper-raised);
    color: inherit;
  }
  input:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .status {
    margin: 0;
    min-height: 1.5em;
    color: var(--ink-muted);
  }
  .suggestions:empty { display: none; }
  .suggestions p { margin: 0 0 var(--space-2); font-weight: 700; }
  .suggestion-list { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .suggestion-list :global(button) {
    font: inherit;
    color: inherit;
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }
  .suggestion-list :global(button:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .results {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  .results :global(h3) {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }
  .results :global(ul) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .results :global(li a) {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
  }
  .results :global(.where) {
    margin-left: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .results :global(li p) {
    margin: var(--space-1) 0 0;
    color: var(--ink-muted);
  }
  .results :global(mark) {
    background: var(--gold);
    color: var(--gold-ink);
    padding-inline: 0.1em;
    border-radius: 3px;
  }
</style>
