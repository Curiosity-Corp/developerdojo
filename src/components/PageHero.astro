---
/**
 * Dark hero band with dojo art, enso brush circle, title, subtitle, CTAs and an optional side card.
 *
 * Props:
 *  - title: the h1 text (every page has exactly one h1; it lives here)
 *  - accent?: punctuation rendered in gold right after the title, e.g. "."
 *  - eyebrow?: small caps line above the title
 *  - highlight?: gold lead-in for the subtitle, e.g. "Free training"
 *  - subtitle?: paragraph text (after the highlight)
 *  - ctas?: { label, href, variant?: "primary"|"ghost", icon? }[]
 *  - art?: base name of the hero art in public/images (default "hero-dojo"; its "-mobile" crop is used on phones)
 *  - compact?: smaller vertical padding for inner pages
 * Slots:
 *  - default: extra content under the CTAs
 *  - side: card on the right (e.g. <NoteCard/> or a rank mini-path)
 */
import Button from './Button.astro';
import Picture from './Picture.astro';
import { hasImage } from '../lib/images';

interface Cta {
  label: string;
  href: string;
  variant?: 'primary' | 'ghost';
  icon?: string;
}
interface Props {
  title: string;
  accent?: string;
  eyebrow?: string;
  highlight?: string;
  subtitle?: string;
  ctas?: Cta[];
  art?: string;
  compact?: boolean;
}

const {
  title,
  accent,
  eyebrow,
  highlight,
  subtitle,
  ctas = [],
  art = 'hero-dojo',
  compact = false,
} = Astro.props;
const hasSide = Astro.slots.has('side');
const hasArt = hasImage(art, 'jpg');
---

<section class:list={['hero', { compact, 'has-side': hasSide }]}>
  <div class="art" aria-hidden="true">
    {
      hasArt ? (
        <Picture
          class="art-img"
          base={art}
          mobile={{ base: `${art}-mobile` }}
          width={2400}
          height={900}
          eager
        />
      ) : (
        <div class="placeholder">
          <span class="window" />
        </div>
      )
    }
  </div>
  <div class="scrim" aria-hidden="true"></div>
  <div class="enso" aria-hidden="true">
    <Picture base="enso" fallback="png" width={800} height={800} eager />
  </div>
  <div class="container grid">
    <div class="copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}{accent && <span class="accent">{accent}</span>}</h1>
      {
        (highlight || subtitle) && (
          <p class="subtitle">
            {highlight && <strong class="highlight">{highlight}</strong>}
            {highlight && subtitle ? ' ' : ''}
            {subtitle}
          </p>
        )
      }
      {
        ctas.length > 0 && (
          <div class="ctas">
            {ctas.map((cta) => (
              <Button href={cta.href} variant={cta.variant ?? 'primary'} icon={cta.icon}>
                {cta.label}
              </Button>
            ))}
          </div>
        )
      }
      <slot />
    </div>
    {
      hasSide && (
        <div class="side">
          <slot name="side" />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--band);
    color: var(--band-text);
    padding-block: var(--space-7);
  }
  .hero.compact {
    padding-block: var(--space-6);
  }
  .art,
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .art :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .art :global(.art-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 100% 47%;
    display: block;
  }
  .placeholder {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(60% 90% at 78% 40%, rgb(217 164 65 / 0.28), transparent 70%),
      linear-gradient(180deg, #1d2e27, var(--band));
    position: relative;
  }
  .window {
    position: absolute;
    top: 8%;
    right: 6%;
    bottom: 8%;
    width: min(46%, 640px);
    border: 3px solid rgb(244 236 216 / 0.16);
    border-radius: 4px;
    background:
      repeating-linear-gradient(90deg, transparent 0 calc(25% - 3px), rgb(244 236 216 / 0.14) calc(25% - 3px) 25%),
      repeating-linear-gradient(0deg, transparent 0 calc(33.33% - 3px), rgb(244 236 216 / 0.14) calc(33.33% - 3px) 33.33%),
      linear-gradient(180deg, rgb(140 170 120 / 0.22), rgb(217 164 65 / 0.12));
  }
  .scrim {
    z-index: -1;
    background: linear-gradient(90deg, rgb(11 17 15 / 0.92) 0%, rgb(11 17 15 / 0.78) 38%, rgb(11 17 15 / 0.15) 75%);
  }
  .enso {
    position: absolute;
    z-index: -1;
    /* A whole brush circle sitting behind the headline, inside the page gutter. */
    left: 1rem;
    top: 50%;
    height: 94%;
    max-height: 30rem;
    aspect-ratio: 1;
    transform: translateY(-50%);
    pointer-events: none;
    opacity: 0.42;
  }
  .enso :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .has-side .grid {
    grid-template-columns: minmax(0, 1fr) 19rem;
  }
  .copy {
    max-width: 40rem;
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--gold);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  h1 {
    color: var(--band-text);
    margin-bottom: var(--space-4);
  }
  .accent {
    color: var(--gold);
  }
  .subtitle {
    font-size: var(--text-lg);
    color: var(--band-text);
    max-width: 36rem;
  }
  .highlight {
    color: var(--gold);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .side {
    justify-self: end;
    width: 100%;
    max-width: 19rem;
  }
  @media (max-width: 61.99rem) {
    .has-side .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .side {
      justify-self: stretch;
      max-width: none;
    }
    .scrim {
      background: linear-gradient(180deg, rgb(11 17 15 / 0.9), rgb(11 17 15 / 0.78));
    }
    .enso {
      display: none;
    }
    .window {
      display: none;
    }
  }
</style>
