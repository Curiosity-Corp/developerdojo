---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { fields } from '../lib/fields';
import { loadContent } from '../lib/content';
import { validateKataCatalog } from '../lib/kata-catalog';
import { kataCatalog, kataDimensions } from '../data/kata-catalog';
import KataRecipeLinks from '../components/KataRecipeLinks.astro';
import LifecycleNotice from '../components/LifecycleNotice.astro';
import { loadCatalogLifecycle } from '../lib/catalog-lifecycle-content';
import { loadKataRecipes } from '../lib/kata-recipe-content';
import { sectorGroups } from '../data/sector-taxonomy';
import { sectorPacks } from '../data/sector-packs';
import { COVERAGE_LABELS, sectorCoverage } from '../lib/sector-taxonomy';

const recipes = await loadKataRecipes();
const recipesFor = (fieldId: string) => recipes.filter(({ recipe }) => recipe.metadata.domainIds.includes(fieldId) || recipe.metadata.crossFieldTransfers.includes(fieldId));

const { resources, tracks } = await loadContent();
const validatedKatas = validateKataCatalog(kataCatalog, {
  fields: fields.map((field) => field.id), resources: resources.map((resource) => resource.id),
  pathways: tracks.map((track) => track.id), ...kataDimensions,
});
const { katas: kataLifecycle } = await loadCatalogLifecycle();
const foundations = new Map(validatedKatas.filter((kata) => kata.metadata.layer === 'foundation').map((kata) => [kata.metadata.id, kata]));
const coverage = sectorCoverage(sectorGroups, fields, sectorPacks);
const practice: Record<string, { href: string; label: string }> = {
  science: { href: '/katas/industry-workshops#vegetation', label: 'Investigate a vegetation signal' },
  agriculture: { href: '/katas/industry-workshops#vegetation', label: 'Investigate a vegetation signal' },
  finance: { href: '/katas/industry-workshops#finance', label: 'Try the fictional invoice exercise' },
  robotics: { href: '/katas/industry-workshops#robotics', label: 'Plan a robot simulation' },
};
---
<BaseLayout title="Development fields" description="Explore fields where shared development foundations can be applied, from UX and BIM to science and manufacturing.">
  <PageHero compact eyebrow="Choose a field" title="Develop across industries" subtitle="The development stack is shared. Every field adds its own artifacts, specialist knowledge, standards and review." />
  <section class="section">
    <div class="container">
      <SectionHeader title="One foundation, many fields" intro="Explore the fields and start with the available practice. Not every field has a complete kata or belt pathway yet." />
      <ul class="fields">
        {fields.map((field) => (
          <li id={field.id}>
            <h2>{field.name}</h2>
            <p>{field.examples}</p>
            {field.trackHref && <a href={field.trackHref}>Explore a related existing track</a>}
            {practice[field.id] && <p><a href={practice[field.id]?.href}>{practice[field.id]?.label}</a></p>}
            {validatedKatas.filter((kata) => kata.metadata.domainIds.includes(field.id)).map((kata) => (
              <div class="practice"><p><a href={kata.href}>{kata.linkLabel}</a></p>
                {(() => { const view = kataLifecycle.get(kata.href); return view && <LifecycleNotice view={view} compact />; })()}
                {kata.metadata.foundationKataIds.map((id) => {
                  const foundation = foundations.get(id);
                  return foundation && <p>Related foundation: <a href={foundation.href}>{foundation.linkLabel}</a></p>;
                })}
              </div>
            ))}
            <KataRecipeLinks recipes={recipesFor(field.id)} title={`Kata recipes for ${field.name}`} headingLevel={3} />
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section" aria-labelledby="sector-plan-title" id="sector-plan">
    <div class="container">
      <h2 id="sector-plan-title">Sector plan and what is delivered</h2>
      <p class="plan-intro">Every field above sits in one of ten sector groups. A group in the plan is not a course: the last column shows only what you can follow today. A sector pathway is a run of katas on real, openly licensed files whose results CI recomputes, with a plain list of what was and was not checked.</p>
      <div class="table-wrap">
        <table data-sector-plan>
          <thead><tr><th scope="col">Sector group</th><th scope="col">Fields in the plan</th><th scope="col">Delivered today</th></tr></thead>
          <tbody>
            {coverage.map((row) => (
              <tr data-coverage={row.coverage} data-group={row.group.id}>
                <th scope="row">{row.group.name}</th>
                <td>{row.fields.map((field, index) => <>{index > 0 && ', '}<a href={'#' + field.id}>{field.name}</a></>)}</td>
                <td>
                  <strong>{COVERAGE_LABELS[row.coverage]}</strong>
                  {row.pathways.length > 0 && <ul>{row.pathways.map((pathway) => <li><a href={pathway.href}>{pathway.title}</a></li>)}</ul>}
                  {row.pathways.length === 0 && row.tracks.length > 0 && <ul>{row.tracks.map((track) => <li><a href={track.href}>{track.fieldName} track</a></li>)}</ul>}
                  <p class="next">Before a {row.pathways.length > 0 ? 'next' : 'first'} pathway: {row.group.nextPack}</p>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="section review">
    <div class="container">
      <SectionHeader title="Expert review matters" intro="In regulated or safety-critical work, a generated artifact needs independent validation and any approvals required from qualified professionals. Practice in the Dojo does not grant a license or authorize professional work." />
      <p><a href="/stack-lab">Explore shared foundations</a> · <a href="/katas">Learn about katas</a></p>
    </div>
  </section>
</BaseLayout>
<style>
  .fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: var(--space-4); padding: 0; margin: var(--space-5) 0 0; list-style: none; }
  .fields li { border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper-raised); padding: var(--space-4); scroll-margin-top: calc(var(--header-h) + var(--space-4)); }
  .fields h2 { font-size: var(--text-xl); margin: 0 0 var(--space-2); }
  .fields p { margin: 0 0 var(--space-3); }
  .fields a, .review a { font-weight: 700; }
  .review { background: var(--paper-raised); }
  .plan-intro { max-width: 68rem; }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; vertical-align: top; padding: var(--space-3); border-bottom: 1px solid var(--line); overflow-wrap: anywhere; }
  td ul { margin: var(--space-2) 0; padding-left: 1.25rem; }
  .next { margin: var(--space-2) 0 0; color: var(--ink-muted); }
  td a { font-weight: 700; }
</style>
