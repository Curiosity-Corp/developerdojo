---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { fields } from '../lib/fields';
import { loadContent } from '../lib/content';
import { validateKataCatalog } from '../lib/kata-catalog';
import { kataCatalog, kataDimensions } from '../data/kata-catalog';

const { resources } = await loadContent();
const validatedKatas = validateKataCatalog(kataCatalog, {
  fields: fields.map((field) => field.id), resources: resources.map((resource) => resource.id), ...kataDimensions,
});
const foundations = new Map(validatedKatas.filter((kata) => kata.metadata.layer === 'foundation').map((kata) => [kata.metadata.id, kata]));
const practice: Record<string, { href: string; label: string }> = {
  finance: { href: '/katas/industry-workshops#finance', label: 'Try the fictional invoice exercise' },
  robotics: { href: '/katas/industry-workshops#robotics', label: 'Plan a robot simulation' },
};
---
<BaseLayout title="Development fields" description="Explore fields where shared development foundations can be applied, from UX and BIM to science and manufacturing.">
  <PageHero compact eyebrow="Choose a field" title="Develop across industries" subtitle="The development stack is shared. Every field adds its own artifacts, specialist knowledge, standards and review." />
  <section class="section">
    <div class="container">
      <SectionHeader title="One foundation, many fields" intro="Explore the fields and start with the available practice. Not every field has a complete kata or belt pathway yet." />
      <ul class="fields">
        {fields.map((field) => (
          <li id={field.id}>
            <h2>{field.name}</h2>
            <p>{field.examples}</p>
            {field.trackHref && <a href={field.trackHref}>Explore a related existing track</a>}
            {practice[field.id] && <p><a href={practice[field.id]?.href}>{practice[field.id]?.label}</a></p>}
            {validatedKatas.filter((kata) => kata.metadata.domainIds.includes(field.id)).map((kata) => (
              <div class="practice"><p><a href={kata.href}>{kata.linkLabel}</a></p>
                {kata.metadata.foundationKataIds.map((id) => {
                  const foundation = foundations.get(id);
                  return foundation && <p>Related foundation: <a href={foundation.href}>{foundation.linkLabel}</a></p>;
                })}
              </div>
            ))}
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section review">
    <div class="container">
      <SectionHeader title="Expert review matters" intro="In regulated or safety-critical work, a generated artifact needs independent validation and any approvals required from qualified professionals. Practice in the Dojo does not grant a license or authorize professional work." />
      <p><a href="/stack-lab">Explore shared foundations</a> · <a href="/katas">Learn about katas</a></p>
    </div>
  </section>
</BaseLayout>
<style>
  .fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: var(--space-4); padding: 0; margin: var(--space-5) 0 0; list-style: none; }
  .fields li { border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper-raised); padding: var(--space-4); scroll-margin-top: calc(var(--header-h) + var(--space-4)); }
  .fields h2 { font-size: var(--text-xl); margin: 0 0 var(--space-2); }
  .fields p { margin: 0 0 var(--space-3); }
  .fields a, .review a { font-weight: 700; }
  .review { background: var(--paper-raised); }
</style>
