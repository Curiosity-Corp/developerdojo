---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SearchPanel from '../../components/SearchPanel.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { groupBySection } from '../../lib/library';
import { loadContent } from '../../lib/content';

const { lessons, tracks, resources } = await loadContent();
const sections = groupBySection(lessons);
const total = sections.reduce((sum, section) => sum + section.entries.length, 0);
---

<BaseLayout
  title="Library"
  description="Free guides, standards, templates and a learning path for the new kind of developer."
>
  <PageHero
    compact
    title="Library"
    subtitle="The rules of the dojo, the six-week Developer path, standards, templates and a free learning path."
  />
  <section class="section">
    <div class="container">
      <div class="site-search">
        <SearchPanel id="library-site-search" label="Search every lesson, track and resource" />
      </div>

      <form class="search" role="search" aria-label="Filter the library list" id="library-search">
        <label for="library-filter">Filter this list by title</label>
        <input
          id="library-filter"
          type="search"
          placeholder="Try: epic, licence, roadmap, persona"
          autocomplete="off"
          spellcheck="false"
        />
        <p id="library-status" role="status" aria-live="polite">{total} pages</p>
      </form>

      <ul class="hubs">
        <li>
          <a href="/library/tracks">Learning tracks</a>
          <p>{tracks.length === 0 ? 'Focused series of lessons, one skill at a time. Coming soon.' : `${tracks.length} focused series of lessons, one skill at a time.`}</p>
        </li>
        <li>
          <a href="/library/resources">Learning resources</a>
          <p>{resources.length === 0 ? 'Checked free courses, videos and docs from other publishers. Coming soon.' : `${resources.length} checked free courses, videos and docs from other publishers.`}</p>
        </li>
      </ul>

      <nav class="jump" aria-label="Library sections">
        {
          sections.map((section) => (
            <a href={`#section-${section.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{section.name}</a>
          ))
        }
      </nav>

      {
        sections.length === 0 ? (
          <p>The library is empty. Guides will be added here.</p>
        ) : (
          sections.map((section) => (
            <div
              class="group"
              data-section
              id={`section-${section.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
            >
              <SectionHeader eyebrow="Guides" title={section.name} />
              <ul>
                {section.entries.map((entry) => (
                  <li
                    data-entry
                    data-text={`${entry.data.title} ${entry.data.description} ${section.name}`.toLowerCase()}
                  >
                    <a href={`/library/${entry.id}`}>{entry.data.title}</a>
                    <p>{entry.data.description}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))
        )
      }
      <p id="library-empty" hidden>No page matches. Try a shorter word.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('library-search');
  const input = document.getElementById('library-filter');
  const status = document.getElementById('library-status');
  const empty = document.getElementById('library-empty');

  if (form instanceof HTMLFormElement && input instanceof HTMLInputElement && status && empty) {
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-section]'));
    const total = document.querySelectorAll('[data-entry]').length;

    const apply = (): void => {
      const words = input.value.toLowerCase().split(/\s+/).filter((word) => word.length > 0);
      let shown = 0;
      for (const group of groups) {
        let groupShown = 0;
        for (const item of Array.from(group.querySelectorAll<HTMLElement>('[data-entry]'))) {
          const text = item.dataset.text ?? '';
          const match = words.every((word) => text.includes(word));
          item.hidden = !match;
          if (match) groupShown += 1;
        }
        group.hidden = groupShown === 0;
        shown += groupShown;
      }
      empty.hidden = shown !== 0;
      status.textContent = words.length === 0 ? `${total} pages` : `${shown} of ${total} pages`;
    };

    form.addEventListener('submit', (event) => event.preventDefault());
    input.addEventListener('input', apply);
    apply();
  }
</script>

<style>
  .site-search {
    max-width: 48rem;
    margin-bottom: var(--space-6);
  }
  .search {
    display: grid;
    gap: var(--space-2);
    max-width: 40rem;
    margin-bottom: var(--space-5);
  }
  .search label {
    font-weight: 700;
  }
  .search input {
    font: inherit;
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-raised);
    color: inherit;
  }
  .search input:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .search p {
    margin: 0;
    color: var(--ink-muted);
  }
  .hubs {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    margin-bottom: var(--space-6);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-6);
  }
  .jump a {
    font-weight: 600;
  }
  .group {
    margin-bottom: var(--space-6);
  }
  ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  li a {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
  }
  li p {
    margin: 0;
    color: var(--ink-muted);
  }
</style>
