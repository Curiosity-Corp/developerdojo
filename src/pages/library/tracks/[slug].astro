---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import TrackProgress from '../../../components/TrackProgress.astro';
import { loadContent, lessonsOfTrack } from '../../../lib/content';
import { GROUP_LABELS, LESSON_LEVEL_LABELS, SKILL_LABELS } from '../../../lib/labels';

export async function getStaticPaths() {
  const { tracks, lessons } = await loadContent();
  return tracks.map((track) => ({
    params: { slug: track.id },
    props: {
      track,
      lessons: lessonsOfTrack(lessons, track.id).map((lesson) => ({
        id: lesson.id,
        title: lesson.data.title,
        description: lesson.data.description,
        duration: lesson.data.duration,
        level: lesson.data.level,
      })),
    },
  }));
}

const { track, lessons } = Astro.props;
const { Content } = await render(track);
const data = track.data;
---

<BaseLayout title={data.title} description={data.description}>
  <PageHero compact eyebrow={`Track · ${GROUP_LABELS[data.group]}`} title={data.title} subtitle={data.description} />
  <section class="section">
    <div class="container layout">
      <article class="prose">
        <Content />
      </article>
      <aside class="facts" aria-label="Track facts">
        <h2>At a glance</h2>
        <dl>
          <dt>Starting level</dt>
          <dd>{LESSON_LEVEL_LABELS[data.level]}</dd>
          <dt>Skills</dt>
          <dd>{data.skills.map((skill) => SKILL_LABELS[skill]).join(', ')}</dd>
        </dl>
        <h3>You will be able to</h3>
        <ul>
          {data.outcomes.map((outcome) => <li>{outcome}</li>)}
        </ul>
      </aside>
    </div>
  </section>
  <section class="section section--tight lessons">
    <div class="container">
      <SectionHeader eyebrow="Lessons" title="Lessons in order" />
      <TrackProgress lessonIds={lessons.map((lesson) => lesson.id)} />
      {
        lessons.length === 0 ? (
          <p>The lessons for this track are being written. Check back soon.</p>
        ) : (
          <ol class="lesson-list">
            {lessons.map((lesson) => (
              <li>
                <a href={`/library/${lesson.id}`}>{lesson.title}</a>
                <span class="done-badge" data-done-for={lesson.id} hidden>Done</span>
                {lesson.level && <span class="duration">{LESSON_LEVEL_LABELS[lesson.level]}</span>}
                {lesson.duration && <span class="duration">{lesson.duration}</span>}
                <p>{lesson.description}</p>
              </li>
            ))}
          </ol>
        )
      }
      <p class="back"><a href="/library/tracks">All tracks</a> · <a href="/library/resources">Learning resources</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  @media (min-width: 62rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 22rem;
    }
  }
  .facts {
    padding: var(--space-4) var(--space-5);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .facts h2 {
    margin-top: 0;
    font-size: var(--text-xl);
  }
  .facts h3 {
    font-size: var(--text-lg);
  }
  .facts dt {
    font-weight: 700;
  }
  .facts dd {
    margin: 0 0 var(--space-3);
  }
  .lesson-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding-left: var(--space-5);
    overflow-wrap: break-word;
  }
  .lesson-list a {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
  }
  .lesson-list p {
    margin: 0;
    color: var(--ink-muted);
  }
  .duration {
    margin-left: var(--space-3);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .back {
    margin-top: var(--space-5);
  }
</style>
