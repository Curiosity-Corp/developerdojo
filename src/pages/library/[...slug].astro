---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Icon from '../../components/Icon.astro';
import { groupBySection } from '../../lib/library';
import { loadContent, lessonsOfTrack } from '../../lib/content';
import { neighbours, readingMinutes, sectionAnchor } from '../../lib/lesson';
import { LESSON_LEVEL_LABELS, formatDate } from '../../lib/labels';

export async function getStaticPaths() {
  // loadContent also fails the build when a track or resource reference does not resolve.
  const { lessons, tracks, resources } = await loadContent();
  const sections = groupBySection(lessons);
  const lessonById = new Map(lessons.map((lesson) => [lesson.id, lesson]));
  const resourceById = new Map(resources.map((resource) => [resource.id, resource]));
  const trackById = new Map(tracks.map((track) => [track.id, track]));
  const toNeighbour = (entry: (typeof lessons)[number]) => ({ id: entry.id, title: entry.data.title });

  return lessons.map((entry) => {
    const track = entry.data.track ? trackById.get(entry.data.track) : undefined;
    // Inside a track the order is the track's reading order; otherwise it is the section's order.
    const ordered = track
      ? lessonsOfTrack(lessons, track.id)
      : (sections.find((section) => section.name === entry.data.section)?.entries ?? []);
    const { previous, next } = neighbours(ordered, entry.id, toNeighbour);
    const prerequisites = (entry.data.prerequisites ?? []).flatMap((id) => {
      const lesson = lessonById.get(id);
      return lesson ? [{ id, title: lesson.data.title }] : [];
    });
    const further = (entry.data.resources ?? []).flatMap((id) => {
      const resource = resourceById.get(id);
      return resource ? [resource] : [];
    });
    return {
      params: { slug: entry.id },
      props: {
        entry,
        previous,
        next,
        prerequisites,
        further,
        track: track ? { id: track.id, title: track.data.title } : undefined,
        minutes: readingMinutes(entry.body ?? ''),
        position: ordered.length > 1 ? { index: ordered.findIndex((item) => item.id === entry.id) + 1, total: ordered.length } : undefined,
      },
    };
  });
}

const { entry, previous, next, prerequisites, further, track, minutes, position } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;

const crumbs = track
  ? [
      { label: 'Library', href: '/library' },
      { label: 'Tracks', href: '/library/tracks' },
      { label: track.title, href: `/library/tracks/${track.id}` },
      { label: data.title },
    ]
  : [
      { label: 'Library', href: '/library' },
      { label: data.section, href: `/library#${sectionAnchor(data.section)}` },
      { label: data.title },
    ];
const groupLabel = track ? `${track.title}, lesson ${position?.index ?? 1} of ${position?.total ?? 1}` : data.section;
---

<BaseLayout title={data.title} description={data.description}>
  <PageHero compact eyebrow={track ? `Track · ${track.title}` : data.section} title={data.title} subtitle={data.description} />
  <article class="section">
    <div class="container lesson">
      <div class="main">
        <Breadcrumbs items={crumbs} />

        <ul class="facts" aria-label="About this lesson" data-pagefind-ignore>
          {data.level && <li><Icon name="signal" size={16} />{LESSON_LEVEL_LABELS[data.level]}</li>}
          {data.duration && <li><Icon name="clock" size={16} />{data.duration}</li>}
          <li><Icon name="book-open" size={16} />{minutes} min read</li>
          {data.updated && <li><Icon name="calendar-days" size={16} />Updated <time datetime={data.updated.toISOString().slice(0, 10)}>{formatDate(data.updated)}</time></li>}
        </ul>

        {
          (data.outcomes?.length ?? 0) > 0 && (
            <section class="box outcomes" aria-labelledby="outcomes-title">
              <h2 id="outcomes-title">After this lesson you can</h2>
              <ul>
                {data.outcomes?.map((outcome) => <li>{outcome}</li>)}
              </ul>
            </section>
          )
        }

        {
          prerequisites.length > 0 && (
            <section class="box" aria-labelledby="prereq-title">
              <h2 id="prereq-title">Read these first</h2>
              <ul>
                {prerequisites.map((item) => <li><a href={`/library/${item.id}`}>{item.title}</a></li>)}
              </ul>
            </section>
          )
        }

        <TableOfContents headings={headings} variant="inline" />

        <div class="prose">
          <Content />
        </div>

        {
          further.length > 0 && (
            <section class="further" aria-label="Further learning" data-pagefind-ignore>
              <SectionHeader eyebrow="Go deeper" title="Further learning" as="h2" />
              <p class="further-intro">Free or low-cost material from other publishers. We opened every link; check the cost label before you start.</p>
              <ul class="cards">
                {further.map((resource) => <li><ResourceCard resource={resource} compact /></li>)}
              </ul>
            </section>
          )
        }

        <nav class="pager" data-pagefind-ignore aria-label={`More in ${groupLabel}`}>
          {previous ? <a class="prev" href={`/library/${previous.id}`}><span>Previous</span>{previous.title}</a> : <span />}
          {next ? <a class="next" href={`/library/${next.id}`}><span>Next</span>{next.title}</a> : <span />}
        </nav>
        <p class="back">
          {track ? <a href={`/library/tracks/${track.id}`}>Back to the track: {track.title}</a> : <a href="/library">Back to the library</a>}
        </p>
      </div>
      <aside class="side" data-pagefind-ignore><TableOfContents headings={headings} variant="side" /></aside>
    </div>
  </article>
</BaseLayout>

<style>
  .lesson {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }
  .side {
    display: none;
  }
  @media (min-width: 70rem) {
    .side {
      display: block;
      align-self: stretch;
    }
    .lesson {
      grid-template-columns: minmax(0, 72ch) 16rem;
      justify-content: center;
    }
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .facts li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .box {
    margin-bottom: var(--space-4);
    padding: var(--space-3) var(--space-5);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-left: 5px solid var(--olive);
    border-radius: var(--radius);
  }
  .box h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }
  .box ul {
    margin: 0;
    padding-left: var(--space-5);
  }
  .further {
    margin-top: var(--space-7);
  }
  .further-intro {
    color: var(--ink-muted);
  }
  .cards {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pager {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    font-weight: 600;
    text-decoration: none;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .pager a:hover {
    border-color: var(--olive);
  }
  .pager a span {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .back {
    margin-top: var(--space-5);
  }
  .pager .next {
    text-align: right;
  }
</style>

<script>
  // Markdown checklists render bare checkboxes. Give each one its item text as an accessible name.
  for (const input of document.querySelectorAll<HTMLInputElement>('.prose .task-list-item > input[type="checkbox"]')) {
    const text = input.parentElement?.textContent?.trim();
    if (text) input.setAttribute('aria-label', text);
  }
</script>
