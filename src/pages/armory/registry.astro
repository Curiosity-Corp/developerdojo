---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { ARMORY_KINDS, ECOSYSTEMS, ECOSYSTEM_LABELS, KIND_LABELS, STATUS_LABELS, type ArmoryEntry } from '../../lib/armory';
import { loadArmory } from '../../lib/armory-content';
import LifecycleNotice from '../../components/LifecycleNotice.astro';

// Records, schema and listing rules: src/data/armory.ts and src/lib/armory.ts (docs/armory-registry.md).
const { armory, resources, usage } = await loadArmory();
const listed = armory.entries.filter((resolved) => resolved.listed);
const candidates = armory.entries.filter((resolved) => !resolved.listed);
const byId = new Map(armory.entries.map((resolved) => [resolved.entry.id, resolved]));
const kindsShown = ARMORY_KINDS.filter((kind) => armory.entries.some((resolved) => resolved.entry.kind === kind));

type Fact = string | { unavailable: string };
const missing = (value: unknown): value is { unavailable: string } => typeof value === 'object' && value !== null && 'unavailable' in value;
const factText = (value: Fact): string => missing(value) ? `Not confirmed: ${value.unavailable}` : value;
const longDate = (iso: string): string => new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const sourceLink = (source: ArmoryEntry['sources'][number]): { href: string; label: string } => {
  if (source.url) return { href: source.url, label: source.label };
  const resource = source.resourceId ? resources.get(source.resourceId) : undefined;
  if (!resource) throw new Error(`Armory source ${source.label} has no resolvable link`);
  return { href: resource.data.url, label: source.label };
};
const typeLine = (entry: ArmoryEntry): string => `${KIND_LABELS[entry.kind]} · ${STATUS_LABELS[entry.maintainer.status]}`;
const evidenceLabel = { 'smoke-test': 'Tested', documented: 'Documented, not tested' } as const;
---
<BaseLayout title="The Armory: capability registry" description="Harnesses, models, skills, MCP servers, CLIs and libraries with sources, versions, permissions and recorded smoke tests.">
  <PageHero compact eyebrow="Equip your agents" title="Choose your tools" accent="." subtitle="Each listed tool has a checked source, version, licence, permissions and a recorded smoke test. Everything else waits under Not listed yet, with what is missing." ctas={[
    { label: 'Explore the registry', href: '#registry', icon: 'arrow-right' },
    { label: 'See stack recipes', href: '#stack-recipes', variant: 'ghost', icon: 'play' },
  ]} />
  <section class="section" id="registry" aria-labelledby="registry-title"><div class="container">
    <h2 id="registry-title">Listed: checked and tested</h2>
    <p>An entry is listed only when its source, version, licence, platforms, cost and sign-in, permission scope, operations and setup are recorded, a smoke test passed, and executable code had a provenance review. Each entry shows the date it was checked. A smoke test shows one task worked once on one setup. It is not a security audit or a guarantee for yours.</p>
    <p data-registry-review-note role="status">Each entry shows when it was checked and when it is due again. Check the current source and terms before use.</p>
    <form class="filters" data-registry-filter hidden><label for="registry-kind">Show a type</label><select id="registry-kind" name="kind"><option value="all">All types</option>{kindsShown.map((kind) => <option value={kind}>{KIND_LABELS[kind]}</option>)}</select></form>
    <p data-registry-status role="status" aria-live="polite"></p>
    <div class="registry-grid">
      {listed.map(({ entry, lifecycle }) => {
        const used = usage.entries.get(entry.id) ?? [];
        const smoke = missing(entry.smokeTest) ? undefined : entry.smokeTest;
        const review = missing(entry.securityReview) ? undefined : entry.securityReview;
        const version = missing(entry.version) ? undefined : entry.version;
        return <article class="entry" id={entry.id} data-registry-entry data-listed="true" data-kind={entry.kind} data-review-next={entry.review.nextReview}>
          <p class="type">{typeLine(entry)}</p><h3>{entry.name}</h3>
          <p class="by">{entry.maintainer.name}{entry.maintainer.note ? ` · ${entry.maintainer.note}` : ''}</p>
          <p>{entry.summary}</p>
          <p class="checked">Checked <time datetime={entry.review.lastVerified}>{longDate(entry.review.lastVerified)}</time>{version ? ` · version ${version.value}` : ''}. <span data-review-due hidden>Review due: check the source before relying on this entry.</span></p>
          <LifecycleNotice view={lifecycle} compact />
          <details><summary>Versions, permissions and evidence</summary>
            <dl>
              <div><dt>Version</dt><dd>{version ? `${version.value}. ${version.how}` : ''}</dd></div>
              <div><dt>Licence</dt><dd>{factText(entry.license)}</dd></div>
              <div><dt>Platforms</dt><dd>{factText(entry.platforms)}</dd></div>
              <div><dt>Cost and plan</dt><dd>{factText(entry.cost)}</dd></div>
              <div><dt>Sign-in</dt><dd>{factText(entry.auth)}</dd></div>
            </dl>
            <h4>Supported combinations</h4>
            <ul>{entry.compatibility.map((row) => <li>{row.harness}{row.model ? ` with ${row.model}` : ''} on {row.platform} <span class="badge" data-evidence={row.evidence}>{evidenceLabel[row.evidence]}</span></li>)}</ul>
            <h4>Permissions</h4>
            <dl>
              <div><dt>Reads</dt><dd>{factText(entry.permissions.read)}</dd></div>
              <div><dt>Writes</dt><dd>{factText(entry.permissions.write)}</dd></div>
              <div><dt>Runs code</dt><dd>{factText(entry.permissions.execute)}</dd></div>
              <div><dt>Network</dt><dd>{factText(entry.permissions.network)}</dd></div>
              <div><dt>Least access</dt><dd>{factText(entry.permissions.minimal)}</dd></div>
            </dl>
            <h4>What it does</h4>
            <ul>{entry.operations.map((operation) => <li><strong>{operation.action}</strong>: {operation.description} <span class="badge" data-evidence={operation.evidence}>{evidenceLabel[operation.evidence]}</span></li>)}</ul>
            {!missing(entry.setup) && <><h4>Setup</h4><ol>{entry.setup.map((step) => <li>{step}</li>)}</ol></>}
            {smoke && <div data-smoke-test><h4>Smoke test, <time datetime={smoke.date}>{longDate(smoke.date)}</time>: {smoke.result}</h4>
              <dl>
                <div><dt>Setup</dt><dd>{smoke.environment}</dd></div>
                <div><dt>Action</dt><dd>{smoke.action}</dd></div>
                <div><dt>Expected</dt><dd>{smoke.expected}</dd></div>
                <div><dt>Observed</dt><dd>{smoke.observed}</dd></div>
              </dl>
              <p>Evidence: {smoke.evidence.map((path, index) => <>{index > 0 && ', '}<a href={path}>{path.slice(path.lastIndexOf('/') + 1)}</a></>)}</p>
            </div>}
            {review && <div data-security-review><h4>{review.scope === 'provenance' ? 'Provenance review' : 'Provenance and source review'}, <time datetime={review.date}>{longDate(review.date)}</time></h4>
              <p>{review.checked}</p><ul>{review.findings.map((finding) => <li>{finding}</li>)}</ul><p><strong>Not checked:</strong> {review.notChecked}</p>
            </div>}
            <h4>Limitations</h4>
            <ul>{entry.limitations.map((limitation) => <li>{limitation}</li>)}</ul>
            <h4>Sources</h4>
            <ul>{entry.sources.map((source) => { const link = sourceLink(source); return <li><a href={link.href}>{link.label} ↗</a></li>; })}</ul>
            <p class="by">{entry.review.checked} Next review <time datetime={entry.review.nextReview}>{longDate(entry.review.nextReview)}</time>.</p>
          </details>
          {used.length > 0 && <p class="used">Used in: {used.map((kata, index) => <>{index > 0 && ', '}<a href={kata.href}>{kata.title}</a></>)}</p>}
        </article>;
      })}
    </div>
  </div></section>

  <section class="section" id="stack-recipes" aria-labelledby="recipes-title"><div class="container">
    <h2 id="recipes-title">Stack recipes</h2>
    <p>A recipe names the tools a kata expects. Where you choose the tool yourself, the recipe says so instead of naming a product.</p>
    <div class="registry-grid">
      {armory.recipes.map(({ recipe }) => {
        const used = usage.recipes.get(recipe.id) ?? [];
        return <article class="entry" id={`recipe-${recipe.id}`} data-stack-recipe={recipe.id}>
          <h3>{recipe.title}</h3><p>{recipe.summary}</p>
          <ul>{recipe.components.map((component) => {
            if ('entryId' in component) {
              const target = byId.get(component.entryId);
              const name = target?.entry.name ?? component.entryId;
              return <li><a href={`#${component.entryId}`}>{name}</a>{target && !target.listed ? ' (not listed yet)' : ''}: {component.role}</li>;
            }
            return <li>Your choice: {component.learnerChoice}. {component.role}</li>;
          })}</ul>
          <p class="used">{used.length ? <>Used in {used.length} {used.length === 1 ? 'kata' : 'katas'}: {used.map((kata, index) => <>{index > 0 && ', '}<a href={kata.href}>{kata.title}</a></>)}</> : 'No published kata uses it yet.'}</p>
        </article>;
      })}
    </div>
  </div></section>

  <section class="section" id="candidates" aria-labelledby="candidates-title"><div class="container">
    <h2 id="candidates-title">Not listed yet</h2>
    <p>These are real tools with checked sources, but something is missing before they can be listed: usually a recorded smoke test. They are shown so you can see what is known and what is not. No setup is given, because none has been tested.</p>
    <div class="registry-grid">
      {candidates.map(({ entry, gaps, lifecycle }) => {
        const review = missing(entry.securityReview) ? undefined : entry.securityReview;
        return <article class="entry candidate" id={entry.id} data-registry-entry data-listed="false" data-kind={entry.kind} data-review-next={entry.review.nextReview}>
          <p class="type">{typeLine(entry)} · not listed</p><h3>{entry.name}</h3>
          <p class="by">{entry.maintainer.name}{entry.maintainer.note ? ` · ${entry.maintainer.note}` : ''}</p>
          <p>{entry.summary}</p>
          {entry.ecosystems.length > 0 && <p class="tags">{entry.ecosystems.map((ecosystem) => <span class="badge">{ECOSYSTEM_LABELS[ecosystem]}</span>)}</p>}
          <p class="checked">Sources checked <time datetime={entry.review.lastVerified}>{longDate(entry.review.lastVerified)}</time>. <span data-review-due hidden>Review due.</span></p>
          <LifecycleNotice view={lifecycle} compact />
          <details><summary>What is known and what is missing</summary>
            <h4>Missing before listing</h4>
            <ul data-gaps>{gaps.map((gap) => <li>{gap}</li>)}</ul>
            <dl>
              <div><dt>Version</dt><dd>{missing(entry.version) ? factText(entry.version) : `${entry.version.value}. ${entry.version.how}`}</dd></div>
              <div><dt>Licence</dt><dd>{factText(entry.license)}</dd></div>
              <div><dt>Reads</dt><dd>{factText(entry.permissions.read)}</dd></div>
              <div><dt>Writes</dt><dd>{factText(entry.permissions.write)}</dd></div>
              <div><dt>Runs code</dt><dd>{factText(entry.permissions.execute)}</dd></div>
              <div><dt>Network</dt><dd>{factText(entry.permissions.network)}</dd></div>
            </dl>
            {review && <div data-security-review><h4>{review.scope === 'provenance' ? 'Provenance review' : 'Provenance and source review'}, <time datetime={review.date}>{longDate(review.date)}</time></h4>
              <p>{review.checked}</p><ul>{review.findings.map((finding) => <li>{finding}</li>)}</ul><p><strong>Not checked:</strong> {review.notChecked}</p>
            </div>}
            <h4>Limitations</h4>
            <ul>{entry.limitations.map((limitation) => <li>{limitation}</li>)}</ul>
            <p class="by">{entry.review.checked}</p>
          </details>
          <p>{entry.sources.map((source, index) => { const link = sourceLink(source); return <>{index > 0 && ' · '}<a href={link.href}>{link.label} ↗</a></>; })}</p>
        </article>;
      })}
    </div>
  </div></section>

  <section class="section" id="ecosystems" aria-labelledby="ecosystems-title"><div class="container narrow">
    <h2 id="ecosystems-title">Specialist ecosystems</h2>
    <p>Tools for building models, maps, simulations, media, numbers and hardware, with their current status here.</p>
    <dl class="ecosystems">
      {ECOSYSTEMS.map((ecosystem) => {
        const members = armory.entries.filter((resolved) => resolved.entry.ecosystems.includes(ecosystem));
        return <div data-ecosystem={ecosystem}><dt>{ECOSYSTEM_LABELS[ecosystem]}</dt><dd>{members.length ? members.map((resolved, index) => <>{index > 0 && ', '}<a href={`#${resolved.entry.id}`}>{resolved.entry.name}</a> ({resolved.listed ? 'listed' : 'not listed yet'})</>) : 'Nothing recorded yet.'}</dd></div>;
      })}
    </dl>
    <p><a href="/armory">Back to the Armory</a> · <a href="/library/resources">Browse more learning resources</a> · <a href="/katas/industry-workshops">Explore industry workshops</a></p>
  </div></section>

  <section class="section safety" aria-labelledby="choose-title"><div class="container narrow">
    <h2 id="choose-title">Choose a stack for your task</h2>
    <ol><li>Name the outcome and choose an assistant or harness you can access.</li><li>List the data, files and actions the task actually needs. A skill is instructions; an MCP server or CLI may provide actions.</li><li>Inspect the source, version, licence, permissions and compatibility. Start with fictional data and the smallest useful access.</li><li>Check the output and record what you tested. A successful installation or a model’s assurance does not prove the result is correct.</li></ol>
    <p><a href="https://modelcontextprotocol.io/docs/tutorials/security/security_best_practices">Read the MCP security guidance ↗</a></p>
  </div></section>
</BaseLayout>
<script>
  const today = new Date().toISOString().slice(0, 10);
  for (const entry of document.querySelectorAll<HTMLElement>('[data-review-next]')) {
    const due = entry.querySelector<HTMLElement>('[data-review-due]');
    if (due && entry.dataset.reviewNext && entry.dataset.reviewNext < today) due.hidden = false;
  }
  const form = document.querySelector<HTMLFormElement>('[data-registry-filter]');
  const status = document.querySelector<HTMLElement>('[data-registry-status]');
  const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-registry-entry]'));
  if (form && status) {
    const select = form.querySelector<HTMLSelectElement>('select');
    if (select) {
      form.hidden = false;
      const update = (): void => {
        let listed = 0; let candidates = 0;
        for (const entry of entries) {
          const show = select.value === 'all' || entry.dataset.kind === select.value;
          entry.hidden = !show;
          if (show && entry.dataset.listed === 'true') listed += 1;
          else if (show) candidates += 1;
        }
        status.textContent = `${listed} listed and ${candidates} not listed yet shown.`;
      };
      select.addEventListener('change', update);
      update();
    }
  }
</script>
<style>
  .registry-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: var(--space-4); margin-block: var(--space-5); }
  .entry { min-width: 0; padding: var(--space-4); border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper-raised); overflow-wrap: anywhere; }
  .candidate { background: var(--paper); border-style: dashed; }
  .entry[hidden], .filters[hidden], [data-review-due][hidden] { display: none; }
  .entry h3 { font-size: var(--text-xl); margin-block: var(--space-2); }
  .entry h4 { font-size: var(--text-base); margin-block: var(--space-3) var(--space-1); }
  .type { color: var(--rust-text); font-size: var(--text-sm); font-weight: 800; text-transform: uppercase; letter-spacing: .06em; }
  .by, .checked, .used { color: var(--ink-muted); font-size: var(--text-sm); }
  [data-review-due] { color: var(--rust-text); font-weight: 700; }
  .badge { display: inline-block; font-size: var(--text-sm); font-weight: 700; padding: 0 .4rem; border: 1px solid var(--line-strong); border-radius: var(--radius); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  summary { font-weight: 700; cursor: pointer; }
  dt { font-weight: 700; } dd { margin: .25rem 0 var(--space-3); }
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .filters label { font-weight: 700; }
  select { color: var(--ink); background: var(--paper); font: inherit; padding: .6rem; border: 1px solid var(--line-strong); border-radius: var(--radius); }
  .safety { background: var(--paper-sunk); } .narrow { max-width: 70rem; } li + li { margin-top: var(--space-2); }
</style>
