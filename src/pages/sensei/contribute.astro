---
/**
 * The Sensei contribution page (#94): the three worksheets, the review criteria, the feedback process, the
 * boundaries, and the public contribution log (src/data/sensei-contributions.ts). loadContributions checks the
 * log against the recipes, the Arena records and the mission playbook, and fails the build when one disagrees.
 * Published text: no names, issue references or repository paths.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { senseiContributions } from '../../data/sensei-contributions';
import { missionPlaybook } from '../../data/mission-playbook';
import { arenaRecordFiles } from '../../lib/arena-content';
import { loadKataRecipes } from '../../lib/kata-recipe-content';
import { isUnavailable } from '../../lib/kata-recipe';
import { loadContributions, type Outcome } from '../../lib/sensei-contributions';
import { formatDate } from '../../lib/labels';

const resolved = await loadKataRecipes();
const contributions = loadContributions(senseiContributions, {
  recipes: resolved.map(({ slug, recipe }) => ({
    slug,
    id: recipe.metadata.id,
    roles: isUnavailable(recipe.agents) ? [] : recipe.agents.roles,
    changes: recipe.changes,
  })),
  arenaRecordIds: arenaRecordFiles().flatMap(({ data }) => {
    const id = typeof data === 'object' && data !== null && 'id' in data ? data.id : undefined;
    return typeof id === 'string' ? [id] : [];
  }),
  routed: missionPlaybook.workedMission.retrospective.improvements.map((item) => ({ ...item.evidence, status: item.status })),
});
const recipeBySlug = new Map(resolved.map((item) => [item.slug, item] as const));
const OUTCOME: Record<Outcome, string> = {
  proposed: 'Proposed; not yet decided',
  'changes-requested': 'Changes requested by the reviewer',
  applied: 'Applied by the maintainers; not yet accepted, because no independent review has been recorded',
  accepted: 'Accepted after an independent review',
  declined: 'Declined, with the reason recorded',
};
const KIND = { 'kata-improvement': 'Kata improvement', 'benchmark-correction': 'Benchmark correction', 'mentoring-feedback': 'Mentoring feedback' } as const;
const day = (value: string) => formatDate(new Date(`${value}T00:00:00Z`));
const targetLink = (item: (typeof contributions)[number]) => {
  if (item.target.part === 'arena-record') return { href: '/arena/evidence', label: `Arena evidence record ${item.target.record}` };
  const found = recipeBySlug.get(item.target.recipe);
  return { href: found ? `${found.href}#changes` : '/katas/recipes', label: found ? `${found.recipe.metadata.id}, ${item.target.role}` : item.target.recipe };
};
---
<BaseLayout title="Improve a kata" description="Prepare a reproducible kata improvement, benchmark correction or private mentoring review, see how it is reviewed, and read the contributions made so far.">
  <PageHero compact eyebrow="Sensei · share the practice" title="Make the next kata better" subtitle="Choose one improvement, show the evidence and help someone else repeat it." ctas={[{ label: 'Choose a contribution', href: '#choose', icon: 'arrow-right' }, { label: 'See a real contribution', href: '#record', variant: 'ghost', icon: 'play' }]} />
  <section class="section outcome" id="example"><div class="container content">
    <p class="eyebrow">See the outcome first</p><h2>Turn one failed update into a lesson</h2>
    <p>The <a href="/katas/open-source-patch-lab">open-source patch lab</a> lets a learner compare a successful change with a conflicting upstream update. A useful improvement would identify the exact step, show a repeatable input and result, explain what failed and make the independent check easier to follow.</p>
    <div class="moves"><div><strong>1 · Observe</strong><span>Point to the step and evidence.</span></div><div><strong>2 · Reproduce</strong><span>Record the setup and actual result.</span></div><div><strong>3 · Improve</strong><span>Suggest one testable change.</span></div><div><strong>4 · Review</strong><span>Another person checks the work.</span></div></div>
    <p>This is an illustration of the contribution process, not a claim that a particular learner submitted a proposal or that an independent review happened. A real contribution, with its record, is <a href="#record">further down this page</a>.</p>
  </div></section>
  <section class="section" id="choose"><div class="container content"><p class="eyebrow">Your turn</p><h2>Choose what you want to improve</h2>
    <article><h3>Improve a kata</h3><p>Record the learner outcome, source and usage rights, a reproducible stack, what was actually checked, and how the technique transfers to another field.</p><p><a href="/examples/sensei/kata-improvement.md" download>Download the kata improvement worksheet</a> · <a href="/examples/sensei/kata-improvement.md">Open and copy on a phone</a></p></article>
    <article><h3>Correct benchmark evidence</h3><p>Point to the exact claim and original dated source. Show what you observed, what changed and what remains unknown; retain the historical evidence.</p><p><a href="/examples/sensei/benchmark-correction.md" download>Download the benchmark correction worksheet</a> · <a href="/examples/sensei/benchmark-correction.md">Open and copy on a phone</a></p></article>
    <article><h3>Give private mentoring feedback</h3><p>Describe the work you saw, why it matters and a question that lets the learner choose a next step. Keep identifying details and private evidence in the agreed location. Mentoring feedback is never published, here or anywhere else.</p><p><a href="/examples/sensei/mentoring-feedback.md" download>Download the private feedback worksheet</a> · <a href="/examples/sensei/mentoring-feedback.md">Open and copy on a phone</a></p></article>
    <p>The worksheets are blank and remain yours. This site does not save or submit them. Ask the maintainer how to share a proposal through an approved channel; do not post private learner or customer material in a public issue or send it to an AI service without permission.</p>
  </div></section>
  <section class="section outcome" id="criteria"><div class="container content"><p class="eyebrow">Equip the reviewer</p><h2>How a contribution is reviewed</h2>
    <p>Every kata improvement and benchmark correction is checked against the same five criteria, plus the transfer question. The worksheets ask for each one. A reviewer records which criteria the evidence meets and which it does not.</p>
    <ol class="criteria">
      <li><strong>Provenance and rights.</strong> Record source, author, revision, date, licence and permission for every example or asset. Unknown rights remain unknown.</li>
      <li><strong>Security of anything that runs.</strong> Name the harness, model, instructions, skills, tools and permissions actually used. Review executable code, skills and integrations before running them, with the least access that works. A change to something that runs is not accepted without that review.</li>
      <li><strong>Reproduced evidence.</strong> Keep the steps, actual outcomes, failures and untested checks separate, so someone else can repeat them. Accessibility, device, security and domain checks depend on the work. A measurement nobody took is unavailable, never zero.</li>
      <li><strong>Independent review.</strong> A reviewer who is not the author inspects the evidence and records the decision and any unresolved concern. A reviewer is not implied until this happens; until then the review is shown as unavailable.</li>
      <li><strong>Version and change history.</strong> The change records what it replaced, when, why, and who reviewed it, on the kata or evidence page itself. Historical evidence is kept, not overwritten.</li>
      <li><strong>A technique that transfers.</strong> Say what the technique teaches, what stays the same in another field and what changes there, including any specialist validation or qualified professional approval.</li>
    </ol>
    <p>Use any assistant available on a phone or computer to draft a proposal, with only authorized context. The assistant does not become the reviewer; you and any independent reviewer remain responsible for the decisions.</p>
  </div></section>
  <section class="section" id="process"><div class="container content"><p class="eyebrow">What happens next</p><h2>The feedback process</h2>
    <p>The roles are the ones the Dojo already uses for certificates: a reviewer who is not the author looks at the evidence, and the Maintainer decides. Nobody reviews or approves their own contribution.</p>
    <ol class="criteria">
      <li><strong>Prepare.</strong> Fill in the worksheet. Leave the review fields blank.</li>
      <li><strong>Send it through an approved channel.</strong> Maintainers open it in the project tracker with the matching template. Mentoring feedback goes only into a confidential record or stays with the learner.</li>
      <li><strong>Check the five criteria.</strong> The reviewer reproduces what can be reproduced and writes down what could not be.</li>
      <li><strong>Get a decision.</strong> The outcome is one of: proposed, changes requested, applied, accepted or declined. Each comes with the reason. "Accepted" needs a recorded independent review; a change made without one is labelled "applied".</li>
      <li><strong>Record the change.</strong> An applied or accepted change goes through the normal reviewed merge with all site checks, and adds an entry to the kata's change history.</li>
      <li><strong>Hear back.</strong> The contributor gets the decision and the reviewer's feedback in the same record, written with the <a href="/library/sensei-feedback-sentences">feedback guide</a>: what was observed, why it matters, and a question about the next step.</li>
    </ol>
  </div></section>
  <section class="section outcome" id="record" aria-labelledby="record-title"><div class="container content"><p class="eyebrow">Contributions so far</p><h2 id="record-title">The contribution record</h2>
    <p>Every kata improvement and benchmark correction taken through this process, with its evidence and its review state. Mentoring feedback is private and never listed.</p>
    {contributions.map((item) => {
      const link = targetLink(item);
      return (
        <article class="record" data-contribution={item.id} data-outcome={item.review.outcome}>
          <h3>{item.title}</h3>
          <dl class="pairs">
            <div><dt>Kind</dt><dd>{KIND[item.kind]}</dd></div>
            <div><dt>Changes</dt><dd><a href={link.href}>{link.label}</a></dd></div>
            <div><dt>Where it came from</dt><dd>{item.origin}</dd></div>
            <div><dt>Source</dt><dd>{item.provenance.source}</dd></div>
            <div><dt>Rights</dt><dd>{item.provenance.rights}</dd></div>
            <div><dt>Confidentiality</dt><dd>{item.provenance.confidentiality}</dd></div>
            <div><dt>Security</dt><dd>{item.security.executable ? 'Changes something that runs. ' : 'Changes nothing that runs. '}{isUnavailable(item.security.review) ? <span data-unavailable><strong>Unavailable.</strong> {item.security.review.unavailable}</span> : item.security.review}</dd></div>
            <div><dt>Reproduced on</dt><dd><time datetime={item.reproduction.checkedOn}>{day(item.reproduction.checkedOn)}</time></dd></div>
          </dl>
          <h4>How to reproduce it</h4>
          <ol>{item.reproduction.steps.map((step) => <li>{step}</li>)}</ol>
          <p><strong>Observed:</strong> {item.reproduction.observed}</p>
          <div class="change">
            <p><strong>Before:</strong> {item.change.before}</p>
            <p><strong>After:</strong> {item.change.after}</p>
          </div>
          <h4>Review</h4>
          <dl class="pairs">
            <div><dt>Author</dt><dd>{item.review.author}</dd></div>
            <div data-independent-review><dt>Independent review</dt><dd>{isUnavailable(item.review.independent) ? <span data-unavailable><strong>Unavailable.</strong> {item.review.independent.unavailable}</span> : item.review.independent}</dd></div>
            <div><dt>Outcome</dt><dd>{OUTCOME[item.review.outcome]}</dd></div>
            <div><dt>Decision</dt><dd>{item.review.decision}</dd></div>
            <div><dt>Corrections during review</dt><dd>{item.review.corrections.length > 0 ? <ul>{item.review.corrections.map((entry) => <li><strong>Observed:</strong> {entry.observed} <strong>Correction:</strong> {entry.correction}</li>)}</ul> : 'None recorded.'}</dd></div>
            <div><dt>Change history</dt><dd>{item.history ? <>Recorded on <a href={link.href}>the kata page</a>, dated <time datetime={item.history.changedOn}>{day(item.history.changedOn)}</time>.</> : 'Nothing has changed yet.'}</dd></div>
            <div><dt>AI use</dt><dd>{item.aiUse}</dd></div>
          </dl>
        </article>
      );
    })}
  </div></section>
  <section class="section" id="boundaries"><div class="container content"><p class="eyebrow">Know the limits</p><h2>What a contribution is, and is not</h2>
    <ul class="criteria" data-contribution-boundaries>
      <li><strong>Contribution counts alone do not confer mastery.</strong> The number of proposals, accepted changes or reviews a person has made never awards a belt, a rank or the title of Sensei. Only reviewed evidence of real work, assessed against the published rubrics, informs that decision.</li>
      <li><strong>Contributions protect learner and customer confidentiality.</strong> A public contribution contains no learner names, private work, customer material, credentials or identifying details. Mentoring feedback stays private. Nothing private goes into an AI service without permission.</li>
      <li><strong>A contribution is not a credential or an approval.</strong> Preparing a worksheet does not make someone a Sensei, award a belt or establish a professional qualification. Sensei applications and formal assessment follow the existing program process.</li>
      <li><strong>Regulated work keeps its own review.</strong> A kata change does not approve regulated or safety-critical work; that needs a qualified professional, separate from any Dojo review.</li>
    </ul>
    <p><a href="/library/sensei-feedback-sentences">Read the feedback guide</a> · <a href="/library/sensei-privacy-and-conduct">Privacy and conduct</a> · <a href="/katas/arena-run-card">Record a benchmark run</a> · <a href="/mission-playbook">Mission playbook</a> · <a href="/sensei">Back to Sensei</a></p>
  </div></section>
</BaseLayout>
<style>
  .content { max-width: 70rem; } .outcome { background: var(--paper-raised); }
  .eyebrow { color: var(--rust-text); font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .moves { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: var(--space-3); margin-block: var(--space-4); }
  .moves div { display: grid; gap: var(--space-2); padding: var(--space-4); border: 1px solid var(--line); border-top: 4px solid var(--tone-gold); border-radius: var(--radius); background: var(--paper); }
  .moves span { color: var(--ink-muted); } article { padding-block: var(--space-3); border-bottom: 1px solid var(--line); } li + li { margin-top: var(--space-2); }
  .record { overflow-wrap: anywhere; }
  .pairs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--space-3); margin: 0 0 var(--space-4); }
  .pairs div { min-width: 0; padding: var(--space-3); background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); }
  dt { font-weight: 800; } dd { margin: var(--space-1) 0 0; } dd ul { margin: 0; padding-left: var(--space-5); }
  h4 { margin: var(--space-4) 0 var(--space-2); }
  .change { padding: var(--space-3) var(--space-4); border-left: 4px solid var(--tone-gold); background: var(--paper); }
  .change p { margin: 0; } .change p + p { margin-top: var(--space-2); }
</style>
