---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RankPath from '../components/RankPath.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ModuleStrip from '../components/ModuleStrip.astro';
import ProgressPanel from '../components/ProgressPanel.astro';
import DeviceData from '../components/DeviceData.astro';
import DarkPanel from '../components/DarkPanel.astro';
import EventList from '../components/EventList.astro';
import ChallengeList from '../components/ChallengeList.astro';
import Icon from '../components/Icon.astro';
import { DEVELOPER_MODULES, MASTER_MODULES } from '../lib/progress';

const developerChecks = [
  'Customer discovery and problem validation',
  'Product roadmap and agile execution',
  'Stakeholder communication and alignment',
  'Building with AI agents to move faster',
  'A final Product Package you present',
];
const masterChecks = [
  'Whole-product ownership (product, engineering and delivery)',
  'Platform design and architecture basics',
  'Operations, monitoring and reliability',
  'Launch to production and real user adoption',
  'AI-agent orchestration across the product lifecycle',
  'Continuous improvement with data and feedback',
];
---

<BaseLayout
  title="Train: develop outcomes across fields"
  description="Build shared agent development skills and explore the existing Developer and Master Developer product paths. Track your progress in your browser."
>
  <PageHero
    compact
    title="Train to develop outcomes"
    accent="."
    highlight="Free training"
    subtitle="to choose and equip an agent stack, develop an outcome, and verify the result. The same foundations can support many fields; each field adds its own tools, standards and expertise."
    ctas={[
      { label: 'Explore katas', href: '/katas', icon: 'arrow-right' },
      { label: 'See the training path', href: '#developer-path', variant: 'ghost', icon: 'play' },
    ]}
  >
    <div slot="side" class="ladder"><RankPath compact linked /></div>
  </PageHero>

  <section class="section tight" aria-labelledby="foundations-title">
    <div class="container">
      <div id="foundations-title"><SectionHeader eyebrow="One foundation, many fields" title="Learn the stack. Apply it to your field." /></div>
      <p>A developer is an orchestrator: you define the outcome, choose harnesses and models, equip agents with context and tools, and verify the work. These foundations can transfer across software, design, construction, science and other fields.</p>
      <p>Specialized practice adds the artifacts, standards and qualified review each field needs. The new kata curriculum is being developed; the existing product paths below are available now.</p>
      <p class="track-links"><a class="path-link" href="/katas">Explore the kata approach <Icon name="arrow-right" size={16} /></a><a class="path-link" href="/library/tracks/working-with-ai-agents">Study the existing AI agents track <Icon name="arrow-right" size={16} /></a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="paths-title">
    <div class="container paths">
      <div class="paths-intro">
        <div id="paths-title">
          <SectionHeader
            eyebrow="Existing product curriculum"
            title="Explore the product development paths."
            intro="These established Developer and Master Developer paths focus on owning and delivering a product. Your progress here stays on this device as the wider Dojo grows."
          />
          <p class="role-link"><a class="path-link" href="/library/the-2030-product-development-manager">What a 2030 Product Development Manager does <Icon name="arrow-right" size={16} /></a></p>
        </div>
      </div>

      <article class="path tone-olive" id="developer">
        <header>
          <span class="tile"><Icon name="sprout" size={32} /></span>
          <div>
            <h2>Developer<span class="visually-hidden">, </span> <span class="chip">6 weeks</span></h2>
            <p>Learn to own one product from idea to launch.</p>
          </div>
        </header>
        <ul class="checks">
          {developerChecks.map((item) => <li><Icon name="square-check-big" size={18} /><span>{item}</span></li>)}
        </ul>
        <a class="path-link" href="/library/developer-path-overview">Read the six-week plan <Icon name="arrow-right" size={16} /></a>
      </article>

      <article class="path tone-gold" id="master-developer">
        <header>
          <span class="tile"><Icon name="mountain" size={32} /></span>
          <div>
            <h2>Master Developer<span class="visually-hidden">, </span> <span class="chip">Advanced</span></h2>
            <p>Own the whole product end to end and run it in the real world.</p>
          </div>
        </header>
        <ul class="checks">
          {masterChecks.map((item) => <li><Icon name="square-check-big" size={18} /><span>{item}</span></li>)}
        </ul>
        <a class="path-link" href="/library/master-developer-overview">What a Master Developer learns <Icon name="arrow-right" size={16} /></a>
      </article>
    </div>
  </section>

  <section class="section tight" aria-label="Modules and your progress">
    <div class="container modules-grid">
      <div class="strips">
        <ModuleStrip
          id="developer-path"
          icon="code-xml"
          title="Developer product path: 6-week training"
          note="Turn an idea into a launched product in 6 weeks."
          tone="olive"
          modules={DEVELOPER_MODULES}
          wide={6}
        />
        <ModuleStrip
          id="master-modules"
          icon="mountain"
          title="Master Developer product path: advanced modules"
          note="Go deeper, run it in the real world, and keep improving."
          tone="rust"
          modules={MASTER_MODULES}
          wide={4}
        />
      </div>
      <div class="side-col">
        <aside class="not-coding">
          <h2>Development crosses fields.</h2>
          <p>The existing product curriculum teaches planning, delivery and operation. Its current rules ask people to write epics and roadmaps and disclose AI use; those rules remain available while program policy is reviewed.</p>
          <a href="/library/the-way-five-rules">Read The Way: our five rules</a>
        </aside>
        <ProgressPanel />
        <DeviceData />
      </div>
    </div>
  </section>

  <section class="section tight" aria-label="Learning tracks">
    <div class="container">
      <SectionHeader
        eyebrow="Go deeper"
        title="Learning tracks"
        intro="Focused series of lessons on one skill at a time, each with the best free courses and videos from other publishers."
      />
      <p class="track-links">
        <a class="path-link" href="/library/tracks">Browse the learning tracks <Icon name="arrow-right" size={16} /></a>
        <a class="path-link" href="/library/resources">Free courses and videos we recommend <Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
  </section>

  <section class="section tight">
    <div class="container two-up">
      <DarkPanel
        split
        art="bamboo"
        icon="calendar-days"
        title="Upcoming live builds"
        text="Build real products together, live. Learn by doing, with guidance from Sensei and the community."
      >
        <EventList limit={3} />
      </DarkPanel>
      <DarkPanel
        split
        icon="trophy"
        title="Challenges"
        text="Apply what you learn, build in public, and earn recognition."
      >
        <ChallengeList />
      </DarkPanel>
    </div>
  </section>
</BaseLayout>

<style>
  .track-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
  }
  .ladder {
    padding: var(--space-4);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.35);
    color: var(--ink);
  }
  .tight {
    padding-block: var(--space-4);
  }
  .paths {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 62rem) {
    .paths {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .paths-intro {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 80rem) {
    .paths {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr) minmax(0, 1.1fr);
    }
    .paths-intro {
      grid-column: auto;
    }
  }
  .path {
    --tone: var(--tone-olive);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    align-content: start;
    height: 100%;
    padding: var(--space-4) var(--space-5);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-bottom: 6px solid var(--tone);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }
  .path.tone-gold {
    --tone: var(--tone-gold);
  }
  .path header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }
  .path header > div {
    flex: 1 1 8rem;
    min-width: 0;
    overflow-wrap: break-word;
  }
  .tile {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 8px;
    background: var(--tone);
    color: #fff;
  }
  .tone-gold .tile {
    color: var(--gold-ink);
  }
  .path h2 {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin: 0;
    font-size: var(--text-xl);
  }
  .path header p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .chip {
    padding: 0.1rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--tone) 20%, var(--paper-raised));
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink);
  }
  .checks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }
  .checks li {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }
  .checks :global(svg) {
    flex: none;
    margin-top: 0.1rem;
    color: var(--olive-text);
  }
  .path-link {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .modules-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 62rem) {
    .modules-grid {
      grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr);
    }
  }
  .strips,
  .side-col {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    min-width: 0;
  }
  .strips :global(.strip) {
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }
  .not-coding {
    padding: var(--space-5);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .not-coding h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-2xl);
    /* Keep long words inside the padded card at high zoom. */
    overflow-wrap: break-word;
  }
  .not-coding p {
    margin: 0 0 var(--space-3);
  }
  .not-coding a {
    font-weight: 700;
  }
  .two-up {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  @media (min-width: 62rem) {
    .two-up {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
