---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectorPackEvidence from '../../components/SectorPackEvidence.astro';
import { PRODUCT, SCREENS, STATES, TRANSITIONS, START_STATE, stateById } from '../../data/pocket-invoice';
import tokenFile from '../../data/pocket-invoice-tokens.json';
import { flattenTokens } from '../../lib/design-tokens';
import flowChecks from '../../../public/examples/ux-pathway/generated/flow-checks.json';
import manifest from '../../../public/examples/ux-pathway/generated/manifest.json';
import fidelity from '../../../public/examples/ux-pathway/generated/fidelity-report.json';
import randori from '../../../public/examples/ux-pathway/generated/randori/rounds.json';
import usability from '../../../public/examples/ux-pathway/generated/usability/tasks.json';
import unseen from '../../../public/examples/ux-pathway/inputs/randori-unseen.json';
import unseenRubric from '../../../public/examples/ux-pathway/generated/randori-unseen/rubric.json';

// The sitemap below is rendered from the same flow the Penpot file and the working example are built from.
const tokenCount = flattenTokens(tokenFile).length;
// The open files (#91): generated by public/examples/ux-pathway/tools/ux_pathway.mjs, rerun and diffed by the ux_pathway CI job.
const flowChecksPassed = flowChecks.checks.filter((check) => check.pass).length;
const drawings: Record<string, { width: number; height: number }> = manifest.drawings;
// The high-fidelity files (UX-004, UX-005): drawn by tools/ux_hifi.mjs from the tokens and inputs/brand.json, audited
// in generated/fidelity-report.json.
const hifiPassed = fidelity.files.filter((entry) => entry.pass).length;
const componentCount = fidelity.files.find((entry) => entry.file === 'components.svg')?.components.length ?? 0;
const hifiScreenCount = manifest.outputs.filter((name) => name.startsWith('screens/')).length;
// The worked Randori rounds (UX-R01): checked by tools/ux_randori.mjs in the same CI job.
const RANDORI = '/examples/ux-pathway/generated/randori/';
if (!randori.pass) throw new Error('The UX Randori record says a round failed; rerun tools/ux_pathway.mjs');
// The usability walkthrough (UX-008): tools/ux_usability.mjs in the same CI job; e2e/ux-usability.spec.ts replays
// each path in the clickable prototype.
const USABILITY = '/examples/ux-pathway/generated/usability/';
// The unseen Randori round (UX-R01, round U): its brief and rubric, written by tools/ux_review.mjs in the same CI job.
// No answer is published; the job runs the review tool on a reference answer kept out of the site.
const UNSEEN = '/examples/ux-pathway/generated/randori-unseen/';
const JUDGE: Record<string, string> = { script: 'the review script', reviewer: 'a reviewer', partner: 'the partner', learner: 'you' };
if (!usability.pass) throw new Error('The usability walkthrough says a task failed; rerun tools/ux_pathway.mjs');
const stateTitle: Record<string, string> = Object.fromEntries(STATES.map((state) => [state.id, state.title]));
const usabilityPassed = usability.tasks.filter((task) => task.pass).length;
const usabilityFindings = usability.tasks.flatMap((task) => task.findings.map((finding) => ({ task: task.id, ...finding })));
const changeCount = (diff: Record<string, string[]>): number => Object.values(diff).reduce((total, items) => total + items.length, 0);
const ratio = (value: number | null): string => (value === null ? 'not measured' : value.toFixed(2));
const hifiShots = [
  { name: 'screens/phone/signup.svg', alt: 'High-fidelity sign-up screen at 390 px: the Pocket Invoice app bar, the heading Create your workspace, two labelled fields and a full-width blue Create workspace button.' },
  { name: 'screens/phone/invoice-new-error.svg', alt: 'High-fidelity new invoice screen at 390 px with errors: a red-bordered box titled There is a problem lists two errors, and the client name and amount fields have a red bar and an error message.' },
  { name: 'screens/desktop/invoice-review.svg', alt: 'High-fidelity Check your invoice screen at 1440 px: a white card under the app bar with the invoice details in two columns and the Send invoice and Change details buttons side by side.' },
];
const kindLabel: Record<string, string> = { screen: 'Screen', error: 'Error', empty: 'Empty state', overlay: 'Dialog', success: 'Success', boundary: 'Outside this flow' };
const transitionLabel: Record<string, string> = { forward: 'Forward', branch: 'Branch', error: 'Error', recover: 'Recover', back: 'Back', 'overlay-open': 'Open dialog', 'overlay-close': 'Close dialog' };
const steps = [
  { id: 'UX-001', href: '/katas/ux-001-sitemap', title: 'Map a sitemap with branches and error states', does: 'List every state, the ways in and out, and how each error recovers.' },
  { id: 'UX-002', href: '/katas/ux-002-low-fidelity', title: 'Draw low-fidelity screens and wire the flow', does: 'Greyscale 390 px boards, one per state, clickable in Penpot View mode.' },
  { id: 'UX-003', href: '/katas/ux-003-tokens', title: 'Define design tokens', does: 'Colour, type and spacing as a JSON token file, with every pair checked for contrast.' },
  { id: 'UX-004', href: '/katas/ux-004-components', title: 'Build components from tokens', does: 'Buttons, fields, an error summary and a dialog, used on every high-fidelity screen.' },
  { id: 'UX-005', href: '/katas/ux-005-implement-and-qa', title: 'Implement the screens and check accessibility', does: 'A working page from the same flow and tokens, checked with axe, a keyboard and reflow at 320 px.' },
  { id: 'UX-006', href: '/katas/ux-006-clickable-prototype', title: 'Wire a clickable prototype with overlays and back paths', does: 'Every transition as a link, the dialog as an overlay, Escape and the browser’s Back button as back paths.' },
  { id: 'UX-007', href: '/katas/ux-007-visual-fidelity', title: 'Check the build against the design', does: 'Compare the built page with the drawings and the style guide, value by value, at two widths.' },
  { id: 'UX-008', href: '/katas/ux-008-usability-walkthrough', title: 'Walk usability tasks and plan a session', does: 'Write tasks as scenarios, walk their shortest paths through the flow, and prepare a moderated session.' },
  { id: 'UX-009', href: '/katas/ux-009-transfer', title: 'Transfer task: from user need to a tested prototype', does: 'Repeat the whole path on a product of your own, from a user need to a walked prototype.' },
  { id: 'UX-R01', href: '/katas/ux-r01-randori', title: 'UX Randori: an unseen flow with a hidden constraint', does: 'Map and wire a flow you have not seen; a partner reveals one constraint after you start.' },
];
const shots = [
  { src: '/examples/ux-pathway/screens/low-signup.png', w: 390, h: 844, alt: 'Low-fidelity sign-up screen in greys: heading Create your workspace, email and workspace fields, a Create workspace button and a link to sign in.' },
  { src: '/examples/ux-pathway/screens/low-invoice-new-error.png', w: 390, h: 886, alt: 'Low-fidelity new invoice screen with errors: a box listing two problems sits above the heading, and the client name and amount fields are marked with their error messages.' },
  { src: '/examples/ux-pathway/screens/high-signup.png', w: 390, h: 844, alt: 'High-fidelity sign-up screen: dark text on a light grey page, labelled fields with a hint, and a blue Create workspace button.' },
  { src: '/examples/ux-pathway/screens/high-invoice-new-error.png', w: 390, h: 902, alt: 'High-fidelity new invoice screen with errors: a red-bordered summary titled There is a problem links to Enter the client name and Enter an amount greater than 0; both fields have a red bar and an Error message.' },
  { src: '/examples/ux-pathway/screens/high-invoice-review.png', w: 390, h: 844, alt: 'High-fidelity Check your invoice screen: a summary list of client, email, work, amount and due date, with Send invoice and Change details buttons.' },
  { src: '/examples/ux-pathway/screens/high-discard-dialog.png', w: 1000, h: 1400, alt: 'Penpot View mode showing the Discard this invoice? dialog over the new invoice screen, with Keep editing and Discard buttons.' },
  { src: '/examples/ux-pathway/screens/journey.png', w: 2000, h: 700, alt: 'Penpot View mode showing page 05: all eleven high-fidelity phone screens in a row, joined above by numbered arrows, solid for forward steps and dashed for errors and back paths, with the numbered list of transitions underneath.' },
];
const sources = {
  penpotPricing: 'https://penpot.app/pricing',
  penpotDocker: 'https://help.penpot.app/technical-guide/getting-started/docker/',
  penpotSelfHost: 'https://help.penpot.app/technical-guide/getting-started/',
  penpotTokens: 'https://help.penpot.app/user-guide/design-systems/design-tokens/',
  penpotFormat: 'https://help.penpot.app/user-guide/export-import/penpot-file-format/',
  penpotPlugins: 'https://help.penpot.app/plugins/create-a-plugin/',
  penpotMcp: 'https://help.penpot.app/mcp/',
  penpotLicence: 'https://github.com/penpot/penpot/blob/develop/LICENSE',
  penpotExport: 'https://help.penpot.app/user-guide/export-import/export-import-files/',
  figmaPricing: 'https://www.figma.com/pricing/',
  figmaSvg: 'https://help.figma.com/hc/en-us/articles/360040030374-Import-files-into-the-file-browser',
  penpotMigration: 'https://help.penpot.app/user-guide/first-steps/migration-guide/',
  govukErrorSummary: 'https://design-system.service.gov.uk/components/error-summary/',
  penpotReleases: 'https://github.com/penpot/penpot/releases',
  penpotPluginsUse: 'https://help.penpot.app/user-guide/plugins/',
  penpotConfig: 'https://help.penpot.app/technical-guide/configuration/',
  figmaMcpLimits: 'https://developers.figma.com/docs/figma-mcp-server/rate-limits-access/',
  figmaMcpWrite: 'https://developers.figma.com/docs/figma-mcp-server/write-to-canvas/',
  figmaPlugins: 'https://developers.figma.com/docs/plugins/',
  figmaRest: 'https://developers.figma.com/docs/rest-api/',
  figmaTerms: 'https://www.figma.com/legal/tos/',
};
---
<BaseLayout title="UX pathway: from sitemap to a tested SaaS screen" description="Follow a SaaS UX pathway end to end: sitemap with error states, low-fidelity screens, design tokens, components and an accessible, tested implementation, with an editable Penpot file.">
  <PageHero compact eyebrow="SaaS UX · Pathway" title="From sitemap to a tested screen" accent="." subtitle={'Follow one small product, ' + PRODUCT.name + ', through every UX step. Each step has a real file you can open, edit and check.'} ctas={[
    { label: 'Try the working example', href: '/examples/pocket-invoice/', icon: 'arrow-right' },
    { label: 'Start with UX-001', href: '/katas/ux-001-sitemap', variant: 'ghost', icon: 'play' },
  ]} />

  <section class="section" aria-labelledby="outcome-title"><div class="container narrow">
    <p class="eyebrow">01 / See the outcome</p>
    <h2 id="outcome-title">{PRODUCT.name}: one job, every state</h2>
    <p><strong>The job:</strong> {PRODUCT.job} <strong>For:</strong> {PRODUCT.audience}</p>
    <p>{PRODUCT.name} is invented for practice. The same flow is drawn in an editable Penpot file and built as a working page, so you can compare the design and the result screen by screen.</p>
    <ul class="links">
      <li><a href="/examples/pocket-invoice/">Use the working example</a>: every screen and error state, with a keyboard or a mouse.</li>
      <li><a href="/examples/ux-pathway/pocket-invoice.penpot" download>Download the Penpot file</a> (.penpot, about 0.8 MB): five pages. 01 the sitemap with its branches and errors; 02 every state in low fidelity, clickable; 03 the tokens and main components; 04 every state in high fidelity at 390 px, clickable, and every screen at 1280 px; 05 the whole high-fidelity journey on one canvas, joined by numbered arrows. In Penpot, choose Import in Projects, open each page once, then press Play on page 02 or 04.</li>
      <li><a href="/examples/ux-pathway/pocket-invoice-tokens.json" download>Download the design tokens</a> (JSON, {tokenCount} tokens, Penpot’s token format).</li>
      <li><a href="/examples/ux-pathway/penpot-import-check.json">Read the Penpot import check</a> (JSON): what was checked in Penpot, including an export from Penpot and a second import, and what was not.</li>
      <li><a href="/examples/ux-pathway/README.md">Read the file guide</a> (Markdown): every file, how to open it, its source and its licence.</li>
      <li><a href="/examples/ux-pathway/qa-report.md">Read the accessibility and responsive QA report</a> (Markdown): every state of the working page, from the site’s browser tests.</li>
      <li>Read the visual-fidelity report of the working page against its design, <a href="/examples/ux-pathway/build-fidelity-phone.md">at 390 px</a> and <a href="/examples/ux-pathway/build-fidelity-desktop.md">at 1440 px</a> (Markdown): every element in every state, value by value. The browser tests fail if these files differ from what they measure.</li>
      <li><a href="/examples/ux-pathway/qa-checklist.md">Use the QA checklist</a> (Markdown) on your own build: accessibility, responsive and usability items, each with how the example was checked.</li>
    </ul>
    <div class="shots">
      {shots.map((shot) => <figure><img src={shot.src} width={shot.w} height={shot.h} alt={shot.alt} loading="lazy" /></figure>)}
    </div>
    <p class="note">Screenshots from Penpot View mode, taken by the import check after the file was imported into a self-hosted Penpot 2.19.5.</p>
  </div></section>

  <section class="section" aria-labelledby="sitemap-title"><div class="container narrow">
    <p class="eyebrow">02 / The sitemap</p>
    <h2 id="sitemap-title">{STATES.length} states, {TRANSITIONS.length} ways between them</h2>
    <p>Every state is reachable from <strong>{stateById(START_STATE).title}</strong>, and every error has a way back. Page 01 of the Penpot file draws this map; the lists below are the same flow as text.</p>
    {SCREENS.map((screen) => (
      <div class="screen-group">
        <h3>{screen.name}</h3>
        <ul>
          {STATES.filter((state) => state.screen === screen.id).map((state) => <li><strong>{state.title}</strong> <span class="kind">({kindLabel[state.kind]})</span>: {state.purpose}</li>)}
        </ul>
      </div>
    ))}
    <div class="table-wrap" tabindex="0" role="region" aria-labelledby="transitions-caption">
      <table>
        <caption id="transitions-caption">Every transition in the flow</caption>
        <thead><tr><th scope="col">#</th><th scope="col">From</th><th scope="col">To</th><th scope="col">Kind</th><th scope="col">What causes it</th></tr></thead>
        <tbody>
          {TRANSITIONS.map((transition, index) => <tr><td>{index + 1}</td><td>{stateById(transition.from).title}</td><td>{stateById(transition.to).title}</td><td>{transitionLabel[transition.kind]}</td><td>{transition.trigger}</td></tr>)}
        </tbody>
      </table>
    </div>
  </div></section>

  <section class="section" aria-labelledby="files-title"><div class="container narrow">
    <p class="eyebrow">03 / Open files and a clickable prototype</p>
    <h2 id="files-title">The same flow as plain files you can edit</h2>
    <p>The flow is also a JSON file. A small script with no dependencies reads it with the token file and draws the sitemap, a one-canvas journey and one greyscale 390 px screen per state as SVG, then checks the flow: {flowChecks.checks.length} checks, {flowChecksPassed} passed, {flowChecks.contrast.length} colour pairs among them. CI reruns it on every pipeline and fails if any file differs from the ones here. Change the flow file, run <code>node tools/ux_pathway.mjs . out</code> in a copy of this folder, and the drawings follow.</p>
    <figure class="drawing">
      <img src="/examples/ux-pathway/generated/sitemap.svg" width={drawings['sitemap.svg']?.width} height={drawings['sitemap.svg']?.height} alt={'Sitemap of ' + PRODUCT.name + ': ' + STATES.length + ' states grouped by screen, joined by ' + TRANSITIONS.length + ' numbered arrows; error and recovery arrows are dashed.'} loading="lazy" />
      <figcaption>The sitemap, drawn from the flow file. Numbers match the transition table above.</figcaption>
    </figure>
    <figure class="drawing">
      <img src="/examples/ux-pathway/generated/journey.svg" width={drawings['journey.svg']?.width} height={drawings['journey.svg']?.height} alt={'Journey canvas: every low-fidelity screen of ' + PRODUCT.name + ' at half size, with numbered arrows from each button to the screen it opens.'} loading="lazy" />
      <figcaption>The journey: every screen on one canvas, each arrow starting at the button that causes it.</figcaption>
    </figure>
    <ul class="links">
      <li><a href="/examples/pocket-invoice-prototype/">Click through the low-fidelity prototype</a> (or <a href="/examples/pocket-invoice-prototype/?fidelity=high">in high fidelity</a>): every state and all {TRANSITIONS.length} transitions in the browser, including the dialog and the Back button.</li>
      <li>Low-fidelity screens (SVG, one per state): {STATES.map((state, index) => <>{index > 0 && ', '}<a href={'/examples/ux-pathway/generated/wireframes/' + state.id + '.svg'}>{state.title}</a></>)}.</li>
      <li><a href="/examples/ux-pathway/inputs/pocket-invoice-flow.json" download>Download the flow file</a> (JSON) and <a href="/examples/ux-pathway/inputs/contrast-pairs.json" download>the colour pairs</a> it checks (JSON).</li>
      <li><a href="/examples/ux-pathway/tools/ux_pathway.mjs" download>Download the script</a> (JavaScript for Node.js, no packages to install).</li>
      <li><a href="/examples/ux-pathway/generated/summary.md">Read the check summary</a> (Markdown), <a href="/examples/ux-pathway/generated/flow-checks.json">the checks</a> and <a href="/examples/ux-pathway/generated/manifest.json">the manifest</a> (JSON, with the SHA-256 of each input).</li>
    </ul>
    <p class="note">Both Penpot and Figma document SVG as a way to bring drawings in from other tools (see the tools table below). Nobody has tried that with these files yet, so it is proposed, not run.</p>
  </div></section>

  <section class="section" aria-labelledby="hifi-title"><div class="container narrow">
    <p class="eyebrow">04 / High fidelity</p>
    <h2 id="hifi-title">A style guide, components and screens at two widths, from the same tokens</h2>
    <p>The same script also reads a small brand file and draws the style guide, a sheet of {componentCount} components, and every state at a phone width (390 px) and a desktop width (1440 px): {hifiScreenCount} screens. Every colour, size, weight, corner and border in them is a value from the token file. The script then audits each drawing as plain text: token use, text contrast against the shape under it, control boundaries and sizes, and whether each element of the flow is drawn as a component. Of {fidelity.files.length} drawings, {hifiPassed} passed; the lowest text contrast is {ratio(fidelity.totals.minTextContrast)}:1 and the lowest control boundary {ratio(fidelity.totals.minControlContrast)}:1. The site’s browser tests then measure every line of text in the screens, and click through the prototype in high fidelity.</p>
    <figure class="drawing">
      <img src="/examples/ux-pathway/generated/style-guide.svg" width={drawings['style-guide.svg']?.width} height={drawings['style-guide.svg']?.height} alt={'Style guide for ' + PRODUCT.name + ': the wordmark, voice and rules, the semantic colours with their token names, contrast samples, the type scale, spacing steps, corners and borders.'} loading="lazy" />
      <figcaption>The style guide (UX-004), drawn from the token file and the brand file. <a href="/examples/ux-pathway/generated/style-guide.md">The same guide as text</a>.</figcaption>
    </figure>
    <figure class="drawing">
      <img src="/examples/ux-pathway/generated/components.svg" width={drawings['components.svg']?.width} height={drawings['components.svg']?.height} alt={'Component sheet: ' + componentCount + ' named components, from the app bar, headings and buttons to fields with and without an error, an error summary, a summary list, a table and a dialog, plus a focus ring sample.'} loading="lazy" />
      <figcaption>The components (UX-004). Each screen is built only from these, and the report checks it.</figcaption>
    </figure>
    <div class="shots">
      {hifiShots.map((shot) => <figure><img src={'/examples/ux-pathway/generated/' + shot.name} width={drawings[shot.name]?.width} height={drawings[shot.name]?.height} alt={shot.alt} loading="lazy" /></figure>)}
    </div>
    <figure class="drawing">
      <img src="/examples/ux-pathway/generated/journey-high.svg" width={drawings['journey-high.svg']?.width} height={drawings['journey-high.svg']?.height} alt={'High-fidelity journey: every phone screen of ' + PRODUCT.name + ' at half size, with numbered arrows from each button to the screen it opens.'} loading="lazy" />
      <figcaption>The high-fidelity journey (UX-005): the same arrows as the low-fidelity one, over the finished screens.</figcaption>
    </figure>
    <ul class="links">
      <li><a href="/examples/pocket-invoice-prototype/?fidelity=high">Click through the prototype in high fidelity</a>: the same links, drawn with the tokens.</li>
      <li>Phone screens (SVG, 390 px): {STATES.map((state, index) => <>{index > 0 && ', '}<a href={'/examples/ux-pathway/generated/screens/phone/' + state.id + '.svg'}>{state.title}</a></>)}.</li>
      <li>Desktop screens (SVG, 1440 px): {STATES.map((state, index) => <>{index > 0 && ', '}<a href={'/examples/ux-pathway/generated/screens/desktop/' + state.id + '.svg'}>{state.title}</a></>)}.</li>
      <li><a href="/examples/ux-pathway/generated/fidelity-report.md">Read the fidelity report</a> (Markdown) or <a href="/examples/ux-pathway/generated/fidelity-report.json">its data</a> (JSON): each drawing, what was checked, and what was not measured.</li>
      <li><a href="/examples/ux-pathway/inputs/brand.json" download>Download the brand file</a> (JSON: name, wordmark, voice, rules and layout widths), <a href="/examples/ux-pathway/tools/ux_hifi.mjs" download>the high-fidelity script</a> and <a href="/examples/ux-pathway/tools/design_tokens.mjs" download>the token reader</a> it shares with the flow script.</li>
    </ul>
    <div class="table-wrap" tabindex="0" role="region" aria-labelledby="unmeasured-caption">
      <table>
        <caption id="unmeasured-caption">What the fidelity report does not measure</caption>
        <thead><tr><th scope="col">What</th><th scope="col">Status</th><th scope="col">Why</th></tr></thead>
        <tbody>
          {fidelity.notMeasured.map((item) => <tr><td>{item.what}</td><td>{item.status}</td><td>{item.why}</td></tr>)}
        </tbody>
      </table>
    </div>
  </div></section>

  <section class="section" aria-labelledby="randori-title"><div class="container narrow">
    <p class="eyebrow">05 / Randori</p>
    <h2 id="randori-title">{randori.rounds.length} worked Randori rounds: what each hidden constraint changed</h2>
    <p>In the <a href="/katas/ux-r01-randori">UX Randori</a>, a partner reads you a brief you have not seen, and reveals one constraint only after your first sitemap. These rounds answer {randori.rounds.length} of the partner cards twice: the first sitemap, and the one that meets the constraint. The flow script checks both: each must pass every structural check, the adapted one must pass a check written for its constraint, and the first must fail it. The round that plays the two screen cards (focus order, one action per screen) is also written as one HTML page per screen, and a browser walks each page with the Tab key on every pipeline.</p>
    <p class="note"><strong>Do your own round first.</strong> The maintainers who wrote the cards also wrote these answers, so the constraint was not hidden from them, and no partner has walked these flows yet.</p>
    <div class="table-wrap" tabindex="0" role="region" aria-labelledby="randori-caption">
      <table>
        <caption id="randori-caption">Each round: the brief, the hidden constraint, and what the flow check found before and after it</caption>
        <thead><tr><th scope="col">Round</th><th scope="col">Brief</th><th scope="col">Hidden constraint</th><th scope="col">Before</th><th scope="col">After</th><th scope="col">Changes</th><th scope="col">Drawings</th></tr></thead>
        <tbody>
          {randori.rounds.map((round) => (
            <tr data-randori-round={round.id}>
              <th scope="row">{round.id}</th>
              <td>{round.brief}</td>
              <td>{round.constraint.text}</td>
              <td>{round.first.states} states; {round.first.constraint.failures.length} {round.first.constraint.failures.length === 1 ? 'problem' : 'problems'}</td>
              <td>{round.adapted.states} states; {round.adapted.constraint.pass ? 'constraint met' : 'constraint missed'}</td>
              <td>{changeCount(round.diff)} states and transitions added or removed</td>
              <td><a href={RANDORI + round.id + '-first-sitemap.svg'}>first sitemap</a>, <a href={RANDORI + round.id + '-adapted-sitemap.svg'}>adapted sitemap</a>, <a href={RANDORI + round.id + '-adapted-journey.svg'}>adapted screens</a>{round.screens.first.length > 0 && <>; keyboard pages: <a href={'/examples/ux-pathway/generated/' + round.screens.first[0]}>first</a>, <a href={'/examples/ux-pathway/generated/' + round.screens.adapted[0]}>adapted</a></>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="links">
      <li><a href={RANDORI + 'randori.md'}>Read the rounds</a> (Markdown): what each check found before the constraint, and every state and transition it changed.</li>
      <li><a href={RANDORI + 'rounds.json'}>The result</a> (JSON) and <a href="/examples/ux-pathway/inputs/randori-rounds.json">the flows</a> (JSON), in the same format as the Pocket Invoice flow.</li>
    </ul>
    <h3 id="unseen-title">The unseen round: {unseen.brief.product}</h3>
    <p data-unseen-round={unseen.id}>Every card above now has a published answer, so this round is the one to do cold. <strong>The brief:</strong> {unseen.brief.text} You have {unseen.timeBoxMinutes} minutes and no assistant. Your partner holds a sealed card and shows it after your first sitemap. No answer to this round is published: you hand in both sitemaps as flow files, a reviewer marks them against the rubric, and a script judges the rows it can.</p>
    <div class="table-wrap" tabindex="0" role="region" aria-labelledby="unseen-caption">
      <table>
        <caption id="unseen-caption">The review rubric: what each row asks and who judges it</caption>
        <thead><tr><th scope="col">Row</th><th scope="col">Criterion</th><th scope="col">Judged by</th><th scope="col">Passes when</th></tr></thead>
        <tbody>
          {unseenRubric.rows.map((row) => <tr data-rubric-row={row.id}><th scope="row">{row.id}</th><td>{row.criterion}</td><td>{JUDGE[row.judge] ?? row.judge}</td><td>{row.pass}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p>{unseen.result}</p>
    <ul class="links">
      <li><a href={UNSEEN + 'brief.md'}>The brief</a> (Markdown), for you: who it is for, what the flow must include and what to hand in.</li>
      <li><a href={UNSEEN + 'rubric.md'}>The rubric</a> (Markdown) or <a href={UNSEEN + 'rubric.json'}>its data</a> (JSON), and <a href={UNSEEN + 'review-sheet.md'}>the blank review sheet</a>. They do not reveal the card.</li>
      <li><a href="/examples/ux-pathway/tools/ux_review.mjs" download>Download the review script</a> (JavaScript for Node.js, no packages to install; it needs the other scripts in the tools folder beside it). Run <code>node tools/ux_review.mjs . adapted.json --first first.json --out review.md</code> in a copy of this folder: it fills in the script rows and lists what the card changed.</li>
      <li><a href={UNSEEN + 'partner-card.md'}>The sealed card</a> (Markdown), <strong>for the partner only</strong>. If you open it first, the round is no longer unseen.</li>
    </ul>
    <p class="note">The maintainers wrote the card and a reference answer, which CI runs through the review script on every pipeline but the site does not publish. Nobody has done this round unseen yet.</p>
  </div></section>

  <section class="section" aria-labelledby="walk-title"><div class="container narrow">
    <p class="eyebrow">06 / Prototype, style guide and usability</p>
    <h2 id="walk-title">Walk it end to end: flow, tokens, style guide, prototype, QA</h2>
    <p>Open these in order. Each one is built from the one before it, and each has a check that runs on every pipeline.</p>
    <ol class="walk" data-ux-walk>
      <li><strong>The flow.</strong> <a href="/examples/ux-pathway/inputs/pocket-invoice-flow.json">The flow file</a> (JSON) and <a href="/examples/ux-pathway/generated/sitemap.svg">its sitemap</a>: {STATES.length} states, {TRANSITIONS.length} transitions, every error with a way back.</li>
      <li><strong>The tokens.</strong> <a href="/examples/ux-pathway/pocket-invoice-tokens.json">The token file</a> (JSON, {tokenCount} tokens): colour, type, spacing, corners and borders.</li>
      <li><strong>The style guide.</strong> <a href="/examples/pocket-invoice-style-guide/">The style guide as a web page</a>: every token rendered with its name and CSS property, the brand rules, the contrast pairs, and a working specimen of each of the {componentCount} components. Open your browser’s inspector on any specimen to see which token it uses.</li>
      <li><strong>The prototype.</strong> <a href="/examples/pocket-invoice-prototype/?fidelity=high">The clickable prototype</a>: a link for every transition, the discard dialog as an overlay that Escape closes, and the browser’s Back button as a back path. The address bar names the screen, so any state can be bookmarked.</li>
      <li><strong>The build.</strong> <a href="/examples/pocket-invoice/">The working page</a>, built from the same flow and tokens, and its visual-fidelity reports against the high-fidelity design <a href="/examples/ux-pathway/build-fidelity-phone.md">at 390 px</a> and <a href="/examples/ux-pathway/build-fidelity-desktop.md">at 1440 px</a>.</li>
      <li><strong>The QA.</strong> <a href="/examples/ux-pathway/qa-report.md">The accessibility and responsive QA report</a> from the working example, <a href="/examples/ux-pathway/generated/fidelity-report.md">the drawings’ fidelity report</a>, the usability walkthrough below, and <a href="/examples/ux-pathway/qa-checklist.md">the QA checklist</a> to run on your own build.</li>
    </ol>
    <h3>Usability walkthrough</h3>
    <p>{usability.tasks.length} tasks, each written as a scenario a participant would hear, with the most clicks the team accepts. A script finds the shortest path the design allows for each, checks that every step is a button on the screen, and that every error on the way leads back to the goal. {usabilityPassed} of {usability.tasks.length} tasks passed. The site’s browser tests then click each path in the prototype at 1440 px, 390 px and 320 px.</p>
    <div class="table-wrap" tabindex="0" role="region" aria-labelledby="usability-caption">
      <table>
        <caption id="usability-caption">Each usability task: the shortest path and the errors on the way</caption>
        <thead><tr><th scope="col">Task</th><th scope="col">Scenario</th><th scope="col">Steps (budget)</th><th scope="col">Path</th><th scope="col">Errors on the way</th></tr></thead>
        <tbody>
          {usability.tasks.map((task) => (
            <tr data-usability-task={task.id}>
              <th scope="row">{task.id}</th>
              <td>{task.scenario}</td>
              <td>{task.stepCount} ({task.maxSteps})</td>
              <td>{task.steps.map((step) => step.control ?? step.trigger).join(' → ') || 'none'}</td>
              <td>{[...task.recoveries.map((r) => (stateTitle[r.error] ?? r.error) + ': ' + r.steps + ' back'), ...task.findings.map((f) => f.item + ': no way to the goal (finding)')].join('; ') || 'none'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {usabilityFindings.length > 0 && <>
      <h3>Findings</h3>
      <ul data-usability-findings>
        {usabilityFindings.map((finding) => <li><strong>{finding.task}, {finding.item}:</strong> {finding.decision}</li>)}
      </ul>
    </>}
    <ul class="links">
      <li><a href={USABILITY + 'walkthrough.md'}>Read the walkthrough</a> (Markdown) or <a href={USABILITY + 'tasks.json'}>its data</a> (JSON), and <a href="/examples/ux-pathway/inputs/usability-tasks.json">the tasks</a> (JSON).</li>
      <li><a href={USABILITY + 'session-sheet.md'}>The moderated session sheet</a> (Markdown): consent, the scenarios to read aloud and what to watch for. No session has been run with it.</li>
      <li><a href="/examples/ux-pathway/tools/ux_usability.mjs" download>Download the walkthrough script</a> (JavaScript for Node.js, no packages to install).</li>
    </ul>
    <p class="note">A walkthrough shows what the design allows, not what people do. Nobody has done these tasks, so no completion rate or time on task is claimed.</p>
  </div></section>

  <section class="section" aria-labelledby="steps-title"><div class="container narrow">
    <p class="eyebrow">07 / The steps</p>
    <h2 id="steps-title">{steps.length} katas, in order</h2>
    <p>Each kata has a brief, prompts, the checks that prove it is done and the evidence for the checks the Dojo has run. They are drafts: the Dojo built and checked the worked example, and no learner has run them yet. Do the foundations first: <a href="/katas/compare-instructions">Compare AI instructions</a>, <a href="/katas/context-trap">Spot a context trap</a> and <a href="/katas/fnd-001-stack-comparison">Build a working prototype, then change one stack variable</a>. Each kata also credits an outside exercise, from Penpot’s guides, the GOV.UK Service Manual or the W3C, under that publisher’s own terms; do it on the publisher’s site, and follow its rules on AI assistance.</p>
    <ol class="steps">
      {steps.map((step) => <li><a href={step.href}><span class="step-id">{step.id}</span> {step.title}</a><p>{step.does}</p></li>)}
    </ol>
  </div></section>

  <section class="section" aria-labelledby="tools-title"><div class="container narrow">
    <p class="eyebrow">08 / The tools</p>
    <h2 id="tools-title">Penpot, and what Figma would cost</h2>
    <p>The pathway uses Penpot because it is open source, runs in a browser, can be self-hosted, and its free plan has no file limits. Facts below are from each publisher’s own pages. The release, plans, licence, hosting, plugin, MCP and API rows were checked on 28 November 2026; the file format and token rows on 27 November 2026; the SVG row on 21 November 2026. Plans change: check the source before you rely on one. The Armory keeps the full <a href="/armory/registry#penpot">Penpot record</a>: version, licence, plans, permissions and the smoke test.</p>
    <div class="table-wrap" tabindex="0" role="region" aria-labelledby="tools-caption">
      <table>
        <caption id="tools-caption">Plans, hosting and agent access, from official pages</caption>
        <thead><tr><th scope="col">Fact</th><th scope="col">Penpot</th><th scope="col">Figma</th></tr></thead>
        <tbody>
          <tr><th scope="row">Version</th><td>2.19.5, released 24 November 2026 (<a href={sources.penpotReleases}>releases</a>); the example file was checked on 2.19.5</td><td>A hosted service with no version to pin</td></tr>
          <tr><th scope="row">Free plan</th><td>Professional: $0, “Free and fully featured”, up to 8 team members and unlimited viewers, 10 GB, 7 days of autosaved versions and file recovery (<a href={sources.penpotPricing}>pricing</a>)</td><td>Starter: free, unlimited drafts, 150 AI credits a day up to 500 a month (<a href={sources.figmaPricing}>pricing</a>)</td></tr>
          <tr><th scope="row">Paid plans</th><td>Unlimited: $7 per editor a month, capped at $175 a month, 25 GB, 30 days of versions; Enterprise: $25 per member a month, unlimited storage, 90 days (<a href={sources.penpotPricing}>pricing</a>)</td><td>Professional: Full seat $16, Dev $12, Collab $3 a month; Organization and Enterprise cost more (<a href={sources.figmaPricing}>pricing</a>)</td></tr>
          <tr><th scope="row">File limits</th><td>“No file limits” on every plan (<a href={sources.penpotPricing}>pricing</a>)</td><td>Unlimited files and projects on Professional and above (<a href={sources.figmaPricing}>pricing</a>)</td></tr>
          <tr><th scope="row">Self-hosting</th><td>Yes: Docker Compose, Kubernetes and other paths (<a href={sources.penpotSelfHost}>technical guide</a>, <a href={sources.penpotDocker}>Docker</a>)</td><td>Not offered on the pricing page</td></tr>
          <tr><th scope="row">Own file format</th><td>.penpot: a ZIP archive with the pages, shapes, components, library and tokens as JSON; import limit 1 GB; boards also export as PNG, JPEG, WEBP, SVG or PDF (<a href={sources.penpotFormat}>file format</a>, <a href={sources.penpotExport}>export and import</a>). Export and re-import of the Pocket Invoice file was run on 2.19.5</td><td>Not checked for this pathway</td></tr>
          <tr><th scope="row">Licence</th><td>Mozilla Public License 2.0 (<a href={sources.penpotLicence}>licence</a>)</td><td>Proprietary: a limited, revocable right to use the service (<a href={sources.figmaTerms}>terms</a>)</td></tr>
          <tr><th scope="row">Design tokens</th><td>W3C Design Tokens Community Group draft format; importing replaces the file’s global token set (<a href={sources.penpotTokens}>guide</a>)</td><td>Not checked for this pathway</td></tr>
          <tr><th scope="row">SVG from other tools</th><td>The migration guide says to export static assets as SVG, PNG or JPG “and place them in Penpot”; it does not say whether they stay editable (<a href={sources.penpotMigration}>migration guide</a>). Proposed, not run with these files</td><td>Recommends SVG “when moving content between design tools”; SVG marker and pattern elements are not imported (<a href={sources.figmaSvg}>import guide</a>). Proposed, not run with these files</td></tr>
          <tr><th scope="row">Installing a plugin</th><td>From the Plugin Manager by its manifest URL, or from Penpot Hub; installed per user. The user grants the permissions it asks for (content:read, content:write, library:read, library:write, user:read, comment:read, comment:write, allow:downloads), and is asked again when an update needs new ones (<a href={sources.penpotPluginsUse}>plugins</a>, <a href={sources.penpotPlugins}>permissions</a>). On a self-hosted server with a strict content security policy, plugins need 'unsafe-eval' (<a href={sources.penpotConfig}>configuration</a>)</td><td>A plugin runs only when the user starts it, and can view, create and change layers; its manifest permissions cover users, payments and team libraries, not writing to the file (<a href={sources.figmaPlugins}>plugins</a>)</td></tr>
          <tr><th scope="row">MCP server</th><td>Official, free and open. Remote (turned on under Account, Integrations) or local (<code>npx @penpot/mcp@stable</code>); it acts through a Penpot plugin in one open browser tab, on the focused page, and can create, change and delete elements, tokens and components. It signs in with a personal token that expires, one per user, and the documentation names no scopes (<a href={sources.penpotMcp}>MCP</a>). A self-hosted server needs the enable-mcp flag and its own MCP container (<a href={sources.penpotConfig}>configuration</a>)</td><td>Starter, and View or Collab seats on any plan: up to 20 tool calls a month; Full or Dev seats: from 200 a day (<a href={sources.figmaMcpLimits}>limits</a>). Writing to the canvas is in beta on Professional and above with edit access, a Full seat outside your drafts, and is to become a paid, usage-based feature (<a href={sources.figmaMcpWrite}>write to canvas</a>)</td></tr>
          <tr><th scope="row">REST API</th><td>Not checked for this pathway beyond importing and exporting whole .penpot files through the server’s API, which the import check does</td><td>No documented endpoint creates or edits layers; writes are limited to comments, variables (Enterprise), dev resources and webhooks (<a href={sources.figmaRest}>REST API</a>)</td></tr>
          <tr><th scope="row" id="native-write">Native write, run for this pathway</th><td>Proven through the Plugin API on a self-hosted 2.19.5, checked 28 November 2026: a plugin installed from its manifest URL, with "Read and modify the content of files that users have access to" allowed in Penpot's dialog, added a board, a rectangle and a text to the imported file, and a new session read them back and found them in the export (<a href="/examples/ux-pathway/penpot-plugin-write-check.json">the record</a>). Not run: the MCP server, penpot.app, and Penpot with its content security policy enforced, where a plugin's own window needs its origin allowed. Browser tests of the site do not prove native write access</td><td>Not run: no Figma account or seat is used for this pathway, and the example file is Penpot-only</td></tr>
        </tbody>
      </table>
    </div>
  </div></section>

