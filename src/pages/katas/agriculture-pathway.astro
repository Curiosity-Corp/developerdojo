---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectorPackEvidence from '../../components/SectorPackEvidence.astro';
// Every number on this page is read from the files CI recomputes
// (/examples/agriculture-pathway/tools/agri_pathway.py, job agriculture_pathway).
import manifest from '../../../public/examples/agriculture-pathway/generated/manifest.json';
import inspection from '../../../public/examples/agriculture-pathway/generated/inspection.json';
import referenceChecks from '../../../public/examples/agriculture-pathway/generated/reference-checks.json';
import monthly from '../../../public/examples/agriculture-pathway/generated/et0-monthly.json';
import irrigation from '../../../public/examples/agriculture-pathway/generated/irrigation.json';
import cards from '../../../public/examples/agriculture-pathway/generated/randori/cards.json';

const EX = '/examples/agriculture-pathway';
const GEN = `${EX}/generated`;
const RECORD = 'inputs/noaa-ghcnd-USW00093193-2023.csv';
const recordSha = manifest.inputs[RECORD];
if (!recordSha) throw new Error(`The agriculture manifest has no hash for ${RECORD}`);
const elements = Object.entries(inspection.elements);
const missing = elements.reduce((total, [, element]) => total + element.missing, 0);
const qualityFlags = elements.reduce((total, [, element]) => total + Object.values(element.qualityFlags as Record<string, number>).reduce((a, b) => a + b, 0), 0);
const traceDays = inspection.elements.PRCP.measurementFlags.T ?? 0;
const steps = [
  { id: 'AGR-001', href: '/katas/agr-001-inspect-weather-record', title: 'Inspect a daily weather record', does: 'Station, dates, units, missing values and every flag, before any number is used.' },
  { id: 'AGR-002', href: '/katas/agr-002-reference-et', title: 'Estimate reference evapotranspiration', does: 'Reproduce FAO’s worked examples, then compute daily ET0 from temperature alone and compare two methods.' },
  { id: 'AGR-003', href: '/katas/agr-003-irrigation-need', title: 'Estimate a crop’s irrigation need', does: 'Maize crop coefficients by growth stage, effective rain, and the net irrigation need by month.' },
  { id: 'AGR-R01', href: '/katas/agr-r01-randori', title: 'Agriculture Randori: an unseen change', does: 'A partner reveals one changed assumption after you start; predict its effect, then recompute.' },
];
const cardRows = Object.entries(cards).map(([id, card]) => ({ id, ...card }));
const signed = (value: number) => (value > 0 ? `+${value.toFixed(1)}` : value.toFixed(1));
const ratio = (value: number | null) => (value === null ? 'unavailable' : value.toFixed(2));
const sources = {
  record: 'https://www.ncei.noaa.gov/access/services/data/v1?dataset=daily-summaries&stations=USW00093193&startDate=2023-01-01&endDate=2023-12-31&dataTypes=PRCP,TMAX,TMIN&units=metric&format=csv&includeStationLocation=1&includeAttributes=true',
  ghcnd: 'https://www.ncei.noaa.gov/products/land-based-station/global-historical-climatology-network-daily',
  ghcndMetadata: 'https://www.ncei.noaa.gov/metadata/geoportal/rest/metadata/item/gov.noaa.ncdc:C00861/xml',
  ghcndDoi: 'https://doi.org/10.7289/V5D21VHZ',
  fao56: 'https://www.fao.org/4/x0490e/x0490e00.htm',
  tm3: 'https://www.fao.org/4/s2022e/s2022e08.htm',
  usc105: 'https://www.copyright.gov/title17/92chap1.html#105',
};
---
<BaseLayout title="Agriculture pathway: from a weather record to a checked irrigation estimate" description="Follow an agriculture pathway on a real NOAA weather record: inspect it, estimate reference evapotranspiration with FAO-56, and estimate a maize crop's irrigation need, with every result computed in CI.">
  <PageHero compact eyebrow="Agriculture · Pathway" title="From a weather record to a checked estimate" accent="." subtitle="Four katas on one year of real daily weather. Each step has a file you can open and a result that CI computes again on every pipeline." ctas={[
    { label: 'Start with AGR-001', href: '/katas/agr-001-inspect-weather-record', icon: 'play' },
    { label: 'Download the record', href: `${EX}/${RECORD}`, variant: 'ghost', icon: 'arrow-right' },
  ]} />

  <section class="section" aria-labelledby="outcome-title"><div class="container narrow">
    <p class="eyebrow">01 / The files</p>
    <h2 id="outcome-title">One station, one year, one crop</h2>
    <p>The record is NOAA’s daily summary for weather station <strong>{inspection.station.id}</strong> (Fresno Yosemite International, California; {inspection.station.latitude}, {inspection.station.longitude}, {inspection.station.elevation_m} m) from {inspection.first} to {inspection.last}: maximum and minimum temperature and rain, in metric units, with NOAA’s flags on every value. The crop is maize for grain, planted on {irrigation.planting}, with FAO’s general crop values. Nothing was grown; this is a practice estimate.</p>
    <ul class="links">
      <li><a href={`${EX}/${RECORD}`} download>The weather record</a> (CSV, as NOAA’s data service returned it), unchanged.</li>
      <li><a href={`${GEN}/et0-daily.csv`} download>Daily results</a> (CSV): radiation, Penman-Monteith and Hargreaves reference evapotranspiration for every day.</li>
      <li><a href={`${GEN}/summary.md`}>The result summary</a> (Markdown) and every result as JSON under <a href={`${GEN}/manifest.json`}>the manifest</a>, with the method and the input hash.</li>
      <li><a href={`${EX}/tools/agri_pathway.py`}>The pathway script</a> (Python 3.12, standard library only, MIT), so you can rerun every number yourself.</li>
      <li><a href={`${EX}/README.md`}>README</a>: sources, terms, how to rerun the checks, and what they do not cover.</li>
    </ul>
  </div></section>

  <section class="section" aria-labelledby="record-title"><div class="container narrow">
    <p class="eyebrow">02 / What is in the record</p>
    <h2 id="record-title">{inspection.rows} days, {missing} missing values</h2>
    <div class="table-wrap" tabindex="0" role="region" aria-labelledby="record-caption">
      <table>
        <caption id="record-caption">Elements, from the CI inspection of the record</caption>
        <thead><tr><th scope="col">Element</th><th scope="col">Unit</th><th scope="col">Values</th><th scope="col">Missing</th><th scope="col">Range</th><th scope="col">Quality flags</th></tr></thead>
        <tbody>
          {elements.map(([name, element]) => <tr><th scope="row">{name}</th><td>{element.unit}</td><td>{element.values}</td><td>{element.missing}</td><td>{element.min} to {element.max}</td><td>{Object.keys(element.qualityFlags).length === 0 ? 'none' : JSON.stringify(element.qualityFlags)}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p>{traceDays} rain values carry the measurement flag T (a trace, recorded as 0 mm). The station has no humidity, sunshine or wind in this record, so those are estimated as FAO-56 describes for missing data. <a href={`${GEN}/inspection.json`}>Full inspection (JSON)</a>.</p>
  </div></section>

  <section class="section" aria-labelledby="steps-title"><div class="container narrow">
    <p class="eyebrow">03 / The steps</p>
    <h2 id="steps-title">Four katas, in order</h2>
    <p>Each kata has a brief, prompts, checks and the evidence for the checks the Dojo has run. They are drafts: the Dojo built the example and CI checks it, and no learner has run them yet. Do the foundations first: <a href="/katas/compare-instructions">Compare AI instructions</a> and <a href="/katas/context-trap">Spot a context trap</a>.</p>
    <ol class="steps">
      {steps.map((step) => <li><a href={step.href}><span class="step-id">{step.id}</span> {step.title}</a><p>{step.does}</p></li>)}
    </ol>
  </div></section>

  <section class="section" aria-labelledby="checks-title"><div class="container narrow">
    <p class="eyebrow">04 / The checks</p>
    <h2 id="checks-title">Reproduce the method, then use it</h2>
    <p>These results come from CI: the pipeline reruns <code>/examples/agriculture-pathway/tools/agri_pathway.py</code> and fails if any output differs from the published files.</p>

    <h3 id="reference-title">Reference checks: FAO’s own worked examples</h3>
    <div class="table-wrap" tabindex="0" role="region" aria-labelledby="reference-caption">
      <table>
        <caption id="reference-caption">Published values and the script’s values, rounded as published</caption>
        <thead><tr><th scope="col">Source</th><th scope="col">Quantity</th><th scope="col">Published</th><th scope="col">Computed</th><th scope="col">Result</th></tr></thead>
        <tbody>
          {referenceChecks.checks.map((check) => <tr><td>{check.source}</td><td>{check.quantity}</td><td>{check.published}</td><td>{check.computed}</td><td data-reference-check={check.id}>{check.status === 'pass' ? 'Pass' : 'Fail'}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p><strong>{referenceChecks.passed} passed, {referenceChecks.failed} failed.</strong> The script stops without writing any result if one check fails, so every number below was computed by code that reproduces FAO’s examples. <a href={`${GEN}/reference-checks.json`}>Result (JSON)</a>.</p>

    <h3 id="et-title">Reference evapotranspiration (AGR-002)</h3>
    <p>{manifest.method.reference}. Humidity: {manifest.method.humidity}. Radiation: {manifest.method.radiation}. Wind: {manifest.method.wind}. The Hargreaves equation is a second, simpler estimate; where the two disagree, neither is measured truth.</p>
    <div class="table-wrap" tabindex="0" role="region" aria-labelledby="et-caption">
      <table>
        <caption id="et-caption">Monthly reference evapotranspiration, mm</caption>
        <thead><tr><th scope="col">Month</th><th scope="col">Penman-Monteith</th><th scope="col">Hargreaves</th><th scope="col">Hargreaves ÷ PM</th><th scope="col">Rain</th><th scope="col">Days unavailable</th></tr></thead>
        <tbody>
          {monthly.map((month) => <tr><th scope="row">{month.month}</th><td>{month.et0_pm_mm ?? 'unavailable'}</td><td>{month.et0_hargreaves_mm ?? 'unavailable'}</td><td>{ratio(month.hargreavesOverPm)}</td><td>{month.rain_mm ?? 'unavailable'}</td><td>{month.daysUnavailable}</td></tr>)}
        </tbody>
      </table>
    </div>

    <h3 id="irrigation-title">Irrigation need (AGR-003)</h3>
    <p>{irrigation.crop}, planted {irrigation.planting}, harvested {irrigation.harvest} ({irrigation.seasonDays} days); crop coefficient {irrigation.kc.initial} at the start, {irrigation.kc.mid} at mid-season and {irrigation.kc.end} at harvest. Effective rain uses FAO’s simple monthly formula; net irrigation need is crop evapotranspiration minus effective rain.</p>
    <div class="table-wrap" tabindex="0" role="region" aria-labelledby="irrigation-caption">
      <table>
        <caption id="irrigation-caption">Monthly crop water need, mm</caption>
        <thead><tr><th scope="col">Month</th><th scope="col">ET0</th><th scope="col">ETc (maize)</th><th scope="col">Rain</th><th scope="col">Effective rain</th><th scope="col">Irrigation need</th></tr></thead>
        <tbody>
          {irrigation.months.map((month) => <tr><th scope="row">{month.month}</th><td>{month.et0_mm ?? 'unavailable'}</td><td>{month.etc_mm ?? 'unavailable'}</td><td>{month.rain_mm ?? 'unavailable'}</td><td>{month.effectiveRain_mm ?? 'unavailable'}</td><td>{month.irrigationNeed_mm ?? 'unavailable'}</td></tr>)}
          <tr><th scope="row">Season</th><td>{irrigation.season.et0_mm}</td><td>{irrigation.season.etc_mm}</td><td>{irrigation.season.rain_mm}</td><td>{irrigation.season.effectiveRain_mm}</td><td data-season-need>{irrigation.season.irrigationNeed_mm}</td></tr>
        </tbody>
      </table>
    </div>
    <p>The season had almost no rain, so effective rain is 0 mm in every month and the whole crop need falls to irrigation. That is the net need only: a real system also loses water to its own inefficiency, which is not estimated here. <a href={`${GEN}/irrigation.json`}>Result (JSON)</a>.</p>

    <h3 id="randori-title">Randori cards</h3>
    <div class="table-wrap" tabindex="0" role="region" aria-labelledby="randori-caption">
      <table>
        <caption id="randori-caption">Each card changes one assumption; season irrigation need, mm</caption>
        <thead><tr><th scope="col">Card</th><th scope="col">Change</th><th scope="col">Need</th><th scope="col">Change in need</th></tr></thead>
        <tbody>
          {cardRows.map((card) => <tr><th scope="row">{card.id}</th><td>{card.title}</td><td>{card.season.irrigationNeed_mm}</td><td data-randori-card={card.id}>{signed(card.changeInIrrigationNeed_mm)}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p>The partner keeps this table hidden until the learner has written a prediction; see <a href="/katas/agr-r01-randori">AGR-R01</a>. <a href={`${GEN}/randori/cards.json`}>Result (JSON)</a>.</p>
  </div></section>

  <section class="section" aria-labelledby="tools-title"><div class="container narrow">
    <p class="eyebrow">05 / The tools and sources</p>
    <h2 id="tools-title">No packages, public sources</h2>
    <p>The script uses only the Python 3.12 standard library, so it runs offline with nothing to install. A spreadsheet works for checking single days by hand. The Armory lists the stack recipe <a href="/armory/registry#recipe-python-standard-library">Python standard library</a>.</p>
    <ul class="links">
      <li><a href={sources.fao56}>FAO Irrigation and Drainage Paper 56, Crop evapotranspiration</a> (FAO, 1998): the Penman-Monteith method, the missing-data estimates, Hargreaves, crop coefficients, and Examples 8 and 18. The equations and table values are used; no text is copied.</li>
      <li><a href={sources.tm3}>FAO Irrigation Water Management Training Manual 3, Irrigation Water Needs</a>, section 4.2: the effective-rainfall formula and its worked question.</li>
      <li><a href={sources.ghcnd}>NOAA NCEI GHCN-Daily</a>: <a href={sources.ghcndMetadata}>dataset metadata and terms</a>, cited as GHCN-Daily version 3, <a href={sources.ghcndDoi}>doi:10.7289/V5D21VHZ</a>, with the dataset overview paper doi:10.1175/JTECH-D-11-00103.1.</li>
    </ul>
  </div></section>

  <SectorPackEvidence pack="agriculture" eyebrow="06 / What is checked" facts={{ recordSha: recordSha.slice(0, 12), referenceChecks: referenceChecks.passed, days: inspection.rows, missing, qualityFlags }} />

  <section class="section" aria-labelledby="credits-title"><div class="container narrow">
    <p class="eyebrow">07 / Credits</p>
    <h2 id="credits-title">Credits and terms</h2>
    <ul>
      <li>Weather record: <a href={sources.record}>NOAA National Centers for Environmental Information, GHCN-Daily</a>, station USW00093193, retrieved 21 November 2026. A work of the US federal government, not under copyright in the US (<a href={sources.usc105}>17 U.S.C. 105</a>); NCEI asks users to cite the dataset and gives no warranty.</li>
      <li>Method and reference values: FAO-56 and FAO Training Manual 3, © FAO. Cited and linked; read FAO’s own terms before you copy their text or figures.</li>
      <li>The pathway script and its outputs: Developer Dojo, MIT licence.</li>
    </ul>
  </div></section>
</BaseLayout>

<style>
  .narrow { max-width: 68rem; }
  .eyebrow { color: var(--rust-text); font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .links li { margin-bottom: var(--space-2, .5rem); }
  .table-wrap { overflow-x: auto; margin-block: var(--space-6, 1.5rem); }
  .table-wrap:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
  table { width: 100%; border-collapse: collapse; }
  caption { text-align: left; font-weight: 800; margin-bottom: var(--space-2, .5rem); }
  th, td { text-align: left; vertical-align: top; padding: .5rem .75rem .5rem 0; border-bottom: 1px solid var(--line); overflow-wrap: anywhere; }
  code { overflow-wrap: anywhere; }
  /* Long words ("evapotranspiration" in a heading) and the DOI link would push the page past a 195 px viewport. */
  h2, h3, p, li, a { overflow-wrap: anywhere; }
  .steps { padding-left: 0; list-style: none; display: grid; gap: var(--space-4, 1rem); }
  .steps li { min-width: 0; padding: var(--space-4, 1rem); background: var(--paper-raised); border: 1px solid var(--line); border-radius: var(--radius); }
  .steps a { font-weight: 800; }
  .steps p { margin: .25rem 0 0; }
  .step-id { display: inline-block; min-width: 4.5rem; color: var(--rust-text); }
</style>
