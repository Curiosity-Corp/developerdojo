---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';

const pathways = [
  { title: 'See an outcome', text: 'Start with real examples as the Gallery grows.', href: '/gallery', link: 'Explore the Gallery' },
  { title: 'Learn the stack', text: 'Study the foundation shared by every field.', href: '/stack-lab', link: 'Enter the Stack Lab' },
  { title: 'Choose a field', text: 'See what changes when a technique enters a new domain.', href: '/fields', link: 'Explore fields' },
  { title: 'Equip your agents', text: 'Learn how harnesses, skills and integrations fit together.', href: '/armory', link: 'Visit the Armory' },
  { title: 'Compare with evidence', text: 'Understand how to evaluate a complete stack.', href: '/arena', link: 'Visit the Arena' },
  { title: 'Demonstrate capability', text: 'Discover the vision for domain-specific belts.', href: '/belts', link: 'Explore belts' },
  { title: 'Try an unfamiliar challenge', text: 'Choose your own approach through Randori.', href: '/randori', link: 'Explore Randori' },
  { title: 'Apply and share', text: 'Take practice into real work and learn from the outcome.', href: '/missions', link: 'Explore missions' },
] as const;
---

<BaseLayout
  title="Katas: practice developing outcomes"
  description="Discover the kata approach: shared agent stack foundations, specialized practice and independent verification."
>
  <PageHero
    compact
    eyebrow="Practice with purpose"
    title="Learn through katas"
    accent="."
    subtitle="Pick something you want to make. Follow a short recipe and try it with an AI assistant."
    ctas={[
      { label: 'Build a prototype', href: '/katas/first-prototype', icon: 'arrow-right' },
      { label: 'Turn an idea into a plan', href: '/katas/spark-ideas', variant: 'ghost', icon: 'play' },
    ]}
  />

  <section class="section first-katas" aria-labelledby="start-title">
    <div class="container">
      <div id="start-title"><SectionHeader eyebrow="Start now" title="Choose your first result" intro="Start with a beginner kata or try a workshop in your field." /></div>
      <div class="starter-grid">
        <article class="starter-card">
          <div class="starter-copy"><span>About 15 minutes</span><h3>Make a clickable prototype</h3><p>Build a small interactive experience and make it your own.</p><a href="/katas/first-prototype">Start the prototype kata <Icon name="arrow-right" size={16} /></a></div>
          <div class="starter-demo"><iframe src="/examples/pocket-garden.html" title="Pocket Garden working prototype example" loading="lazy" sandbox="allow-scripts"></iframe></div>
        </article>
        <article class="starter-card idea-card">
          <div class="starter-copy"><span>About 10 minutes</span><h3>Turn an idea into a plan</h3><p>Use an AI assistant to turn a spark into a clear one-page project brief.</p><a href="/katas/spark-ideas">Start the idea kata <Icon name="arrow-right" size={16} /></a></div>
          <img src="/images/kata-spark.webp" width="1672" height="941" alt="" loading="lazy" />
        </article>
        <article class="starter-card">
          <div class="starter-copy"><span>About 10 minutes</span><h3>Rescue messy data</h3><p>Clean a fictional dataset and make a report you can check.</p><a href="/katas/data-rescue">Start the data kata <Icon name="arrow-right" size={16} /></a></div>
        </article>
        <article class="starter-card">
          <div class="starter-copy"><span>Real-world 3D showcase</span><h3>Turn a room into a world</h3><p>Explore an interactive 3D room and study the agent workflow behind it.</p><a href="/katas/scan-a-room">Explore the 3D room <Icon name="arrow-right" size={16} /></a></div>
        </article>
        <article class="starter-card">
          <div class="starter-copy"><span>SaaS UX</span><h3>Design a user journey</h3><p>Try a working prototype, map its states and design your own.</p><a href="/katas/ux-journey">Start the UX kata <Icon name="arrow-right" size={16} /></a></div>
        </article>
        <article class="starter-card">
          <div class="starter-copy"><span>Universal foundation</span><h3>Compare AI instructions</h3><p>Run two prompts on the same task and check the evidence.</p><a href="/katas/compare-instructions">Start the stack experiment <Icon name="arrow-right" size={16} /></a></div>
        </article>
        <article class="starter-card">
          <div class="starter-copy"><span>Official training · Dojo practice</span><h3>Make something in your field</h3><p>Explore design, business, media and more with provider training and an AI assistant.</p><a href="/katas/industry-workshops">Explore industry workshops <Icon name="arrow-right" size={16} /></a></div>
        </article>
        <article class="starter-card">
          <div class="starter-copy"><span>Official provider training</span><h3>Build in the cloud</h3><p>Learn with Azure, AWS, Oracle or Google Cloud, then try a Dojo follow-up.</p><a href="/katas/cloud-workshops">Explore cloud workshops <Icon name="arrow-right" size={16} /></a></div>
        </article>
        <article class="starter-card">
          <div class="starter-copy"><span>About 10 minutes</span><h3>Spot the AI mistakes</h3><p>Check a report against the evidence and fix what is wrong.</p><a href="/katas/error-clinic">Start the error clinic <Icon name="arrow-right" size={16} /></a></div>
        </article>
      </div>
      <p>More practice: <a href="/katas/decision-replay">Decision Replay</a> · <a href="/katas/constraint-roulette">Constraint Roulette</a> · <a href="/katas/budget-boss">Compare two stacks</a> · <a href="/katas/portfolio">Make a portfolio</a> · <a href="/katas/pocket-dojo">Practice offline</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="foundation-title">
    <div class="container content">
      <div id="foundation-title">
        <SectionHeader eyebrow="One foundation, many fields" title="Learn the stack. Apply it anywhere." />
      </div>
      <p>The orchestrator is the developer. Shared foundations include harnesses, models, instructions, context, memory, skills, integrations, delegation and verification. You choose and equip the system, then take responsibility for the outcome.</p>
      <p>Specializations add the artifacts, tools, standards and review needed in each field. The same foundation can support software, UX, 3D and BIM, construction, science, manufacturing, education and more. The catalog is being developed; these fields are directions for future practice, not a claim that all are available today.</p>
      <p>In safety-critical or regulated work, an agent-generated artifact needs independent validation and any required approval from qualified professionals. A Dojo belt does not grant a professional license.</p>
    </div>
  </section>

  <section class="section pathway-section" aria-labelledby="pathway-title">
    <div class="container">
      <div id="pathway-title">
        <SectionHeader eyebrow="Your route through the Dojo" title="Choose where to begin" intro="Explore the spaces that support practice. Collections, demonstrations and assessments will grow as their evidence is verified." />
      </div>
      <div class="pathway-grid">
        {pathways.map((pathway) => (
          <article class="pathway-card">
            <h3>{pathway.title}</h3>
            <p>{pathway.text}</p>
            <a href={pathway.href}>{pathway.link} <Icon name="arrow-right" size={16} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section journey" id="journey" aria-labelledby="journey-title">
    <div class="container content">
      <div id="journey-title">
        <SectionHeader eyebrow="The practice" title="From outcome to independent mastery" intro="The kata experience is being built. This is the learning journey it is designed to support." />
      </div>
      <ol>
        <li><strong>See an outcome and study the kata.</strong> Start with a real result, then work backward through its source, stack and evidence.</li>
        <li><strong>Assemble the stack and equip the agents.</strong> Choose a harness, model, instructions, context, skills and permitted tools for the task.</li>
        <li><strong>Execute and verify.</strong> Follow the recipe, check the outcome against clear criteria and investigate failures.</li>
        <li><strong>Adapt.</strong> Change a constraint, tool or goal and learn which parts of the technique transfer.</li>
        <li><strong>Demonstrate capability.</strong> Future domain belts will assess evidence of skill; Randori will challenge you to choose your own approach to an unfamiliar goal.</li>
        <li><strong>Apply and teach.</strong> Missions put techniques to work; Senseis help others improve and refine the katas.</li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="first-title">
    <div class="container content">
      <div id="first-title">
        <SectionHeader eyebrow="First foundation kata in development" title="Same goal, different stack" />
      </div>
      <p>The first planned kata will compare how a chosen outcome changes as a learner varies a harness, model, instruction or other stack component. It will use a real source exercise and recorded evidence, with controlled comparisons wherever practical. The exercise and its verified recipe are still being prepared.</p>
      <p>While it is in development, explore the existing <a href="/library/tracks/working-with-ai-agents">Working with AI agents track</a> and <a href="/library/resources">free resource library</a>. The existing <a href="/train">Developer and Master Developer training</a> remains available.</p>
      <p>Still discovering what interests you? <a href="https://ignitecuriosity.org/">Explore with Ignite Curiosity</a>, our sibling learning community. You can start at either site.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .first-katas { padding-block: var(--space-6); }
  .starter-grid { display: grid; gap: var(--space-4); grid-template-columns: minmax(0, 1fr); margin-top: var(--space-5); }
  .starter-card { display: grid; grid-template-columns: minmax(0, 1fr); overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper-raised); box-shadow: var(--shadow); }
  .starter-copy { display: grid; justify-items: start; align-content: start; gap: var(--space-3); padding: var(--space-5); }
  .starter-copy span { color: var(--olive-text); font-size: var(--text-sm); font-weight: 700; }
  .starter-copy h3 { margin: 0; font-size: var(--text-2xl); overflow-wrap: anywhere; }
  .starter-copy p { margin: 0; }
  .starter-copy a { display: inline-flex; gap: var(--space-2); align-items: center; padding: .75rem 1rem; background: #294333; color: #fff; border-radius: var(--radius); font-weight: 700; text-decoration: none; }
  .starter-copy a:hover { text-decoration: underline; }
  .starter-demo { padding: var(--space-4); background: var(--paper-sunk); }
  .starter-demo iframe { display: block; width: 100%; height: 21rem; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .idea-card img { display: block; width: 100%; height: 14rem; object-fit: cover; }
  @media (min-width: 62rem) { .starter-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .content {
    max-width: 60rem;
  }
  .content p {
    max-width: 70ch;
  }
  .pathway-section {
    background: var(--paper-sunk);
  }
  .pathway-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .pathway-card {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-top: 4px solid var(--tone-gold);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }
  .pathway-card h3 { margin: 0; font-size: var(--text-xl); }
  .pathway-card p { margin: 0 0 var(--space-2); color: var(--ink-muted); }
  .pathway-card a { display: inline-flex; align-items: center; gap: var(--space-2); font-weight: 700; }
  @media (min-width: 40rem) {
    .pathway-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 80rem) {
    .pathway-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .journey {
    background: var(--paper-raised);
  }
  ol {
    max-width: 70ch;
    padding-left: 1.5rem;
  }
  li + li {
    margin-top: var(--space-3);
  }
</style>
