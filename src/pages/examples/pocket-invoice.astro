---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRODUCT, stateById, type Element, type StateId } from '../../data/pocket-invoice';
import tokenFile from '../../data/pocket-invoice-tokens.json';
import { cssCustomProperties, resolveTokens } from '../../lib/design-tokens';

// Every visible string below comes from the flow in src/data/pocket-invoice.ts, the same source the
// Penpot file is generated from, so the design and the build cannot say different things.
const tokenStyle = cssCustomProperties(resolveTokens(tokenFile), 'pi');
const elements = (id: StateId): readonly Element[] => stateById(id).elements;
function heading(id: StateId): string {
  const found = elements(id).find((item) => item.type === 'heading');
  if (!found || found.type !== 'heading') throw new Error('Pocket Invoice: ' + id + ' has no heading');
  return found.text;
}
function paragraph(id: StateId, index = 0): string {
  const found = elements(id).filter((item) => item.type === 'text')[index];
  if (!found || found.type !== 'text') throw new Error('Pocket Invoice: ' + id + ' has no text ' + index);
  return found.text;
}
function button(id: StateId, to: StateId): string {
  const found = elements(id).find((item) => item.type === 'button' && item.to === to);
  if (!found || found.type !== 'button') throw new Error('Pocket Invoice: ' + id + ' has no button to ' + to);
  return found.label;
}
function field(id: StateId, label: string): { label: string; hint?: string } {
  const found = elements(id).find((item) => item.type === 'field' && item.label === label);
  if (!found || found.type !== 'field') throw new Error('Pocket Invoice: ' + id + ' has no field ' + label);
  return { label: found.label, ...(found.hint ? { hint: found.hint } : {}) };
}
function errorSummaryItems(id: StateId): readonly string[] {
  const found = elements(id).find((item) => item.type === 'error-summary');
  if (!found || found.type !== 'error-summary') throw new Error('Pocket Invoice: ' + id + ' has no error summary');
  return found.items;
}
const tableColumns = (() => {
  const found = elements('invoices-list').find((item) => item.type === 'table');
  if (!found || found.type !== 'table') throw new Error('Pocket Invoice: invoices-list has no table');
  return found.columns;
})();
const summaryKeys = (() => {
  const found = elements('invoice-review').find((item) => item.type === 'summary');
  if (!found || found.type !== 'summary') throw new Error('Pocket Invoice: invoice-review has no summary');
  return found.rows.map(([key]) => key);
})();

interface FieldDef { name: string; id: string; type: 'email' | 'text'; autocomplete: string; inputmode?: 'decimal'; label: string; hint?: string }
const signupFields: FieldDef[] = [
  { name: 'email', id: 'pi-email', type: 'email', autocomplete: 'email', ...field('signup', 'Email address') },
  { name: 'workspace', id: 'pi-workspace', type: 'text', autocomplete: 'organization', ...field('signup', 'Workspace name') },
];
const invoiceFields: FieldDef[] = [
  { name: 'client', id: 'pi-client', type: 'text', autocomplete: 'off', ...field('invoice-new', 'Client name') },
  { name: 'clientEmail', id: 'pi-client-email', type: 'email', autocomplete: 'off', ...field('invoice-new', 'Client email') },
  { name: 'work', id: 'pi-work', type: 'text', autocomplete: 'off', ...field('invoice-new', 'What the work was') },
  { name: 'amount', id: 'pi-amount', type: 'text', autocomplete: 'off', inputmode: 'decimal', ...field('invoice-new', 'Amount in US dollars') },
];
const sendError = errorSummaryItems('send-error')[0] ?? '';
---
<BaseLayout title="Pocket Invoice: working example" description="A small, accessible example of a SaaS flow: create a workspace, write an invoice, check it and send it, with every error state working.">
  <section class="section intro" aria-labelledby="pi-page-title"><div class="container narrow">
    <p class="eyebrow">UX pathway · Working example</p>
    <h1 id="pi-page-title">Pocket Invoice</h1>
    <p>{PRODUCT.job} Pocket Invoice is invented for practice: it is not a product, and nothing you type leaves this page. Nothing is saved; reload the page to start again.</p>
    <p>Try the errors as well as the happy path: leave a field empty, type an amount of 0, or give a client email ending in <code>.invalid</code> to see a failed send. Everything works with a keyboard.</p>
    <p><a href="/katas/ux-pathway">Back to the UX pathway</a> · <a href="/examples/ux-pathway/pocket-invoice.penpot" download>Download the Penpot design file</a></p>
  </div></section>

  <section class="section" aria-label="Pocket Invoice example"><div class="container">
    <noscript><p class="pi-noscript">This example needs JavaScript to move between screens. The first screen is shown below.</p></noscript>
    <div class="pi" style={tokenStyle} data-pocket-invoice data-current-state="signup">
      <div class="pi-bar" aria-hidden="true"><span class="pi-mark">P</span><span data-wordmark>Pocket Invoice</span></div>
      <div class="pi-body">

        <section class="pi-screen" data-screen="start" aria-labelledby="pi-start-title">
          <div class="pi-error-summary" data-error-summary tabindex="-1" aria-labelledby="pi-start-errors" hidden>
            <h3 id="pi-start-errors" class="pi-error-title">There is a problem</h3>
            <ul data-error-list></ul>
          </div>
          <h2 id="pi-start-title" tabindex="-1">{heading('signup')}</h2>
          <form data-form="signup" novalidate>
            {signupFields.map((item) => (
              <div class="pi-field" data-field={item.name}>
                <label for={item.id}>{item.label}</label>
                {item.hint && <p class="pi-hint" id={item.id + '-hint'}>{item.hint}</p>}
                <p class="pi-error" id={item.id + '-error'} hidden></p>
                <input id={item.id} name={item.name} type={item.type} autocomplete={item.autocomplete} spellcheck="false" aria-describedby={item.hint ? item.id + '-hint' : undefined} />
              </div>
            ))}
            <button class="pi-button" type="submit">{button('signup', 'invoices-empty')}</button>
          </form>
          <p><button class="pi-link" type="button" data-go="sign-in">{button('signup', 'sign-in')}</button></p>
        </section>

        <section class="pi-screen" data-screen="sign-in" aria-labelledby="pi-sign-in-title" hidden>
          <h2 id="pi-sign-in-title" tabindex="-1">{heading('sign-in')}</h2>
          <p>{paragraph('sign-in')}</p>
          <button class="pi-button pi-secondary" type="button" data-go="signup">{button('sign-in', 'signup')}</button>
        </section>

        <section class="pi-screen" data-screen="invoices" aria-labelledby="pi-invoices-title" hidden>
          <h2 id="pi-invoices-title" tabindex="-1">{heading('invoices-empty')}</h2>
          <div data-invoices-empty>
            <p>{paragraph('invoices-empty')}</p>
            <button class="pi-button" type="button" data-go="invoice-new">{button('invoices-empty', 'invoice-new')}</button>
          </div>
          <div data-invoices-list hidden>
            <table class="pi-table">
              <caption class="visually-hidden">Invoices you have sent</caption>
              <thead><tr>{tableColumns.map((column) => <th scope="col">{column}</th>)}</tr></thead>
              <tbody data-invoice-rows></tbody>
            </table>
            <button class="pi-button" type="button" data-go="invoice-new">{button('invoices-list', 'invoice-new')}</button>
          </div>
        </section>

        <section class="pi-screen" data-screen="new-invoice" aria-labelledby="pi-new-title" hidden>
          <div class="pi-error-summary" data-error-summary tabindex="-1" aria-labelledby="pi-new-errors" hidden>
            <h3 id="pi-new-errors" class="pi-error-title">There is a problem</h3>
            <ul data-error-list></ul>
          </div>
          <h2 id="pi-new-title" tabindex="-1">{heading('invoice-new')}</h2>
          <form data-form="invoice" novalidate>
            {invoiceFields.map((item) => (
              <div class="pi-field" data-field={item.name}>
                <label for={item.id}>{item.label}</label>
                {item.hint && <p class="pi-hint" id={item.id + '-hint'}>{item.hint}</p>}
                <p class="pi-error" id={item.id + '-error'} hidden></p>
                <input id={item.id} name={item.name} type={item.type} autocomplete={item.autocomplete} inputmode={item.inputmode} spellcheck="false" aria-describedby={item.hint ? item.id + '-hint' : undefined} />
              </div>
            ))}
            <div class="pi-actions">
              <button class="pi-button" type="submit">{button('invoice-new', 'invoice-review')}</button>
              <button class="pi-button pi-secondary" type="button" data-open-discard>{button('invoice-new', 'discard-dialog')}</button>
            </div>
          </form>
        </section>

        <section class="pi-screen" data-screen="review" aria-labelledby="pi-review-title" hidden>
          <h2 id="pi-review-title" tabindex="-1">{heading('invoice-review')}</h2>
          <dl class="pi-summary">
            {summaryKeys.map((key) => <div><dt>{key}</dt><dd data-summary-value={key}></dd></div>)}
          </dl>
          <div class="pi-actions">
            <button class="pi-button" type="button" data-send>{button('invoice-review', 'invoice-sent')}</button>
            <button class="pi-button pi-secondary" type="button" data-go="invoice-new">{button('invoice-review', 'invoice-new')}</button>
          </div>
        </section>

        <section class="pi-screen" data-screen="send-error" aria-labelledby="pi-send-error-title" hidden>
          <h2 id="pi-send-error-title" tabindex="-1">{heading('send-error')}</h2>
          <div class="pi-error-summary" aria-labelledby="pi-send-errors">
            <h3 id="pi-send-errors" class="pi-error-title">There is a problem</h3>
            <ul><li><a href="#pi-client-email" data-fix-email>{sendError}</a></li></ul>
          </div>
          <p>{paragraph('send-error')}</p>
          <button class="pi-button" type="button" data-fix-email>{button('send-error', 'invoice-new')}</button>
        </section>

        <section class="pi-screen" data-screen="sent" aria-labelledby="pi-sent-title" hidden>
          <div class="pi-success">
            <h2 id="pi-sent-title" tabindex="-1" data-sent-title>{heading('invoice-sent')}</h2>
            <p data-sent-text>{paragraph('invoice-sent')}</p>
          </div>
          <button class="pi-button" type="button" data-go="invoices-list">{button('invoice-sent', 'invoices-list')}</button>
        </section>

        <dialog class="pi-dialog" data-discard aria-labelledby="pi-discard-title">
          <h2 id="pi-discard-title">{heading('discard-dialog')}</h2>
          <p>{paragraph('discard-dialog')}</p>
          <div class="pi-actions">
            <button class="pi-button" type="button" data-keep autofocus>{button('discard-dialog', 'invoice-new')}</button>
            <button class="pi-button pi-secondary" type="button" data-discard-confirm>{button('discard-dialog', 'invoices-empty')}</button>
          </div>
        </dialog>
      </div>
    </div>
    <p class="pi-status visually-hidden" aria-live="polite" data-announce></p>
  </div></section>
</BaseLayout>

<script>
  import { VALIDATION, type StateId } from '../../data/pocket-invoice';

  type FieldRule = keyof Omit<typeof VALIDATION, 'deliverable'>;
  interface Invoice { number: string; client: string; clientEmail: string; work: string; amount: number }

  const app = document.querySelector<HTMLElement>('[data-pocket-invoice]');
  if (!app) throw new Error('Pocket Invoice: the example container is missing');
  const root: HTMLElement = app;
  const pick = <T extends Element>(selector: string, scope: ParentNode = root): T => {
    const found = scope.querySelector<T>(selector);
    if (!found) throw new Error('Pocket Invoice: missing ' + selector);
    return found;
  };
  const screens = new Map([...root.querySelectorAll<HTMLElement>('[data-screen]')].map((screen) => [screen.dataset['screen'] ?? '', screen]));
  const screenFor: Record<StateId, string> = {
    signup: 'start', 'signup-error': 'start', 'sign-in': 'sign-in', 'invoices-empty': 'invoices', 'invoices-list': 'invoices',
    'invoice-new': 'new-invoice', 'invoice-new-error': 'new-invoice', 'discard-dialog': 'new-invoice', 'invoice-review': 'review',
    'send-error': 'send-error', 'invoice-sent': 'sent',
  };
  const signupForm = pick<HTMLFormElement>('[data-form="signup"]');
  const invoiceForm = pick<HTMLFormElement>('[data-form="invoice"]');
  const dialog = pick<HTMLDialogElement>('[data-discard]');
  const announce = pick<HTMLElement>('[data-announce]', document);
  const baseTitle = document.title;
  const sent: Invoice[] = [];
  const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
  let current: StateId = 'signup';
  let beforeDialog: StateId = 'invoice-new';

  function setState(state: StateId, focus: HTMLElement | null): void {
    current = state;
    root.dataset['currentState'] = state;
    const screenId = screenFor[state];
    screens.forEach((screen, id) => { screen.hidden = id !== screenId; });
    const isError = state === 'signup-error' || state === 'invoice-new-error' || state === 'send-error';
    document.title = (isError ? 'Error: ' : '') + baseTitle;
    if (state === 'invoices-empty' || state === 'invoices-list') {
      pick<HTMLElement>('[data-invoices-empty]').hidden = state !== 'invoices-empty';
      pick<HTMLElement>('[data-invoices-list]').hidden = state !== 'invoices-list';
    }
    const target = focus ?? pick<HTMLElement>('h2', screens.get(screenId) ?? root);
    target.focus();
    if (!focus) announce.textContent = '';
  }

  function clearErrors(form: HTMLFormElement): void {
    const screen = form.closest<HTMLElement>('[data-screen]') ?? root;
    pick<HTMLElement>('[data-error-summary]', screen).hidden = true;
    form.querySelectorAll<HTMLElement>('[data-field]').forEach((wrapper) => {
      wrapper.classList.remove('pi-field-error');
      pick<HTMLElement>('.pi-error', wrapper).hidden = true;
      const input = pick<HTMLInputElement>('input', wrapper);
      input.removeAttribute('aria-invalid');
      const hint = wrapper.querySelector('.pi-hint');
      if (hint) input.setAttribute('aria-describedby', hint.id); else input.removeAttribute('aria-describedby');
    });
  }

  /** Validates every field, shows each problem next to its field and in the summary, and returns whether all passed. */
  function validate(form: HTMLFormElement, rules: Record<string, FieldRule>): boolean {
    clearErrors(form);
    const screen = form.closest<HTMLElement>('[data-screen]') ?? root;
    const list = pick<HTMLUListElement>('[data-error-list]', screen);
    list.replaceChildren();
    let valid = true;
    for (const [name, rule] of Object.entries(rules)) {
      const wrapper = pick<HTMLElement>('[data-field="' + name + '"]', form);
      const input = pick<HTMLInputElement>('input', wrapper);
      const message = VALIDATION[rule](input.value);
      if (!message) continue;
      valid = false;
      wrapper.classList.add('pi-field-error');
      const error = pick<HTMLElement>('.pi-error', wrapper);
      error.textContent = 'Error: ' + message;
      error.hidden = false;
      input.setAttribute('aria-invalid', 'true');
      input.setAttribute('aria-describedby', [wrapper.querySelector('.pi-hint')?.id, error.id].filter(Boolean).join(' '));
      const link = document.createElement('a');
      link.href = '#' + input.id;
      link.textContent = message;
      link.addEventListener('click', (event) => { event.preventDefault(); input.focus(); });
      const item = document.createElement('li');
      item.append(link);
      list.append(item);
    }
    if (!valid) pick<HTMLElement>('[data-error-summary]', screen).hidden = false;
    return valid;
  }

  const value = (form: HTMLFormElement, name: string): string => pick<HTMLInputElement>('[name="' + name + '"]', form).value.trim();

  signupForm.addEventListener('submit', (event) => {
    event.preventDefault();
    if (validate(signupForm, { email: 'email', workspace: 'workspace' })) setState(sent.length ? 'invoices-list' : 'invoices-empty', null);
    else setState('signup-error', pick<HTMLElement>('[data-error-summary]', screens.get('start') ?? root));
  });

  invoiceForm.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!validate(invoiceForm, { client: 'client', clientEmail: 'clientEmail', work: 'work', amount: 'amount' })) {
      setState('invoice-new-error', pick<HTMLElement>('[data-error-summary]', screens.get('new-invoice') ?? root));
      return;
    }
    const amount = Number(value(invoiceForm, 'amount').replace(/^\$/, ''));
    const values: Record<string, string> = {
      Client: value(invoiceForm, 'client'), 'Send to': value(invoiceForm, 'clientEmail'), Work: value(invoiceForm, 'work'),
      Amount: money.format(amount), Due: 'In 30 days',
    };
    root.querySelectorAll<HTMLElement>('[data-summary-value]').forEach((cell) => { cell.textContent = values[cell.dataset['summaryValue'] ?? ''] ?? ''; });
    setState('invoice-review', null);
  });

  root.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-go]') : null;
    if (!target) return;
    const destination = target.dataset['go'] as StateId;
    if (destination === 'invoice-new' && current !== 'invoice-review') {
      invoiceForm.reset();
      clearErrors(invoiceForm);
    }
    setState(destination, null);
  });

  pick<HTMLElement>('[data-open-discard]').addEventListener('click', () => {
    beforeDialog = current === 'invoice-new-error' ? 'invoice-new-error' : 'invoice-new';
    current = 'discard-dialog';
    root.dataset['currentState'] = 'discard-dialog';
    dialog.showModal();
  });
  pick<HTMLElement>('[data-keep]', dialog).addEventListener('click', () => dialog.close('keep'));
  pick<HTMLElement>('[data-discard-confirm]', dialog).addEventListener('click', () => dialog.close('discard'));
  dialog.addEventListener('close', () => {
    if (dialog.returnValue === 'discard') {
      invoiceForm.reset();
      clearErrors(invoiceForm);
      setState(sent.length ? 'invoices-list' : 'invoices-empty', null);
      announce.textContent = 'Invoice discarded.';
    } else {
      // Keep editing, or Escape: the browser returns focus to the Cancel button.
      current = beforeDialog;
      root.dataset['currentState'] = beforeDialog;
    }
    dialog.returnValue = '';
  });

  pick<HTMLElement>('[data-send]').addEventListener('click', () => {
    const clientEmail = value(invoiceForm, 'clientEmail');
    if (!VALIDATION.deliverable(clientEmail)) {
      setState('send-error', null);
      return;
    }
    const invoice: Invoice = {
      number: 'INV-' + String(sent.length + 1).padStart(4, '0'), client: value(invoiceForm, 'client'), clientEmail,
      work: value(invoiceForm, 'work'), amount: Number(value(invoiceForm, 'amount').replace(/^\$/, '')),
    };
    sent.push(invoice);
    pick<HTMLElement>('[data-sent-title]').textContent = 'Invoice ' + invoice.number + ' sent';
    pick<HTMLElement>('[data-sent-text]').textContent = invoice.client + ' will get it at ' + invoice.clientEmail + '. It is due in 30 days.';
    const rows = pick<HTMLTableSectionElement>('[data-invoice-rows]');
    rows.replaceChildren(...sent.map((item) => {
      const row = document.createElement('tr');
      for (const cell of [item.number, item.client, money.format(item.amount), 'Sent']) {
        const td = document.createElement('td');
        td.textContent = cell;
        row.append(td);
      }
      return row;
    }));
    setState('invoice-sent', null);
  });

  root.querySelectorAll<HTMLElement>('[data-fix-email]').forEach((control) => control.addEventListener('click', (event) => {
    event.preventDefault();
    setState('invoice-new', pick<HTMLInputElement>('#pi-client-email'));
  }));
</script>

<style>
  .narrow { max-width: 68rem; }
  .eyebrow { color: var(--rust-text); font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .intro { padding-bottom: 0; }
  .pi-noscript { font-weight: 700; }
  .pi {
    max-width: 40rem; margin-inline: auto; overflow: hidden;
    background: var(--pi-color-surface-page); color: var(--pi-color-text-default);
    border: var(--pi-border-width-thin) solid var(--pi-color-border-input); border-radius: var(--pi-radius-card);
    font-family: "Source Sans Pro", "Source Sans 3", system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: var(--pi-font-size-s); line-height: 1.5;
  }
  .pi-bar {
    display: flex; align-items: center; gap: var(--pi-spacing-3); box-sizing: border-box; height: calc(var(--pi-size-control) + 2 * var(--pi-spacing-2));
    padding: 0 var(--pi-space-page); background: var(--pi-color-surface-card); color: var(--pi-color-text-default);
    border-bottom: var(--pi-border-width-thin) solid var(--pi-color-border-subtle); font-size: var(--pi-font-size-m); font-weight: var(--pi-font-weight-bold);
  }
  .pi-mark {
    display: grid; place-items: center; width: var(--pi-spacing-8); height: var(--pi-spacing-8); border-radius: var(--pi-radius-card);
    background: var(--pi-color-action-primary); color: var(--pi-color-text-inverse);
  }
  .pi-body { padding: var(--pi-space-page); }
  .pi :global(h2) { margin: 0 0 var(--pi-space-stack); font-size: var(--pi-font-size-l); line-height: 1.2; color: var(--pi-color-text-default); }
  /* The design's two widths: font.size.l for a page heading on a phone and in a dialog, font.size.xl on a desktop. */
  @media (min-width: 48rem) { .pi :global(.pi-screen h2) { font-size: var(--pi-font-size-xl); } }
  .pi :global(h2:focus) { outline: none; }
  .pi :global(h2:focus-visible) { outline: 3px solid var(--pi-color-focus-ring); outline-offset: 4px; }
  .pi p { margin: 0 0 var(--pi-space-stack); color: var(--pi-color-text-muted); }
  .pi code { color: inherit; }
  .pi-field { margin-bottom: var(--pi-space-stack); }
  .pi-field-error { padding-left: var(--pi-spacing-3); border-left: var(--pi-border-width-bar) solid var(--pi-color-border-error); }
  .pi label { display: block; font-weight: var(--pi-font-weight-bold); color: var(--pi-color-text-default); }
  .pi .pi-hint { margin: 0; font-size: var(--pi-font-size-s); color: var(--pi-color-text-muted); }
  .pi .pi-error { margin: 0; font-weight: var(--pi-font-weight-bold); color: var(--pi-color-text-error); }
  .pi input {
    display: block; box-sizing: border-box; width: 100%; min-height: var(--pi-size-control); margin-top: var(--pi-spacing-1); padding: var(--pi-spacing-2) var(--pi-spacing-3);
    font: inherit; color: var(--pi-color-text-default); background: var(--pi-color-surface-card);
    border: var(--pi-border-width-thick) solid var(--pi-color-border-input); border-radius: var(--pi-radius-control);
  }
  .pi input[aria-invalid="true"] { border-color: var(--pi-color-border-error); }
  .pi input:focus-visible, .pi button:focus-visible, .pi a:focus-visible { outline: 3px solid var(--pi-color-focus-ring); outline-offset: 2px; }
  .pi-actions { display: flex; flex-wrap: wrap; gap: var(--pi-spacing-4); }
  .pi-button {
    min-height: var(--pi-size-control); padding: var(--pi-spacing-2) var(--pi-spacing-4); cursor: pointer;
    font: inherit; font-weight: var(--pi-font-weight-bold); color: var(--pi-color-text-inverse);
    background: var(--pi-color-action-primary); border: var(--pi-border-width-thick) solid var(--pi-color-action-primary); border-radius: var(--pi-radius-control);
  }
  .pi-button:hover { background: var(--pi-color-action-primary-hover); border-color: var(--pi-color-action-primary-hover); }
  .pi-secondary { color: var(--pi-color-text-default); background: var(--pi-color-surface-card); border-color: var(--pi-color-border-input); }
  .pi-secondary:hover { color: var(--pi-color-text-inverse); }
