---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ReviewRecord from '../components/ReviewRecord.astro';
import { loadReviewSubjects } from '../lib/review-subjects-content';

// The subjects come from the assessment map (ranks, shared specialist criteria) and the sector packs (each field's
// checks, Randori and qualified-review limit), so this form and /assessment-map cannot disagree (#90). Transfers come
// from the mission playbook's transfer practice, so a field's practice sheet and its review always match (#95).
// /review-request reads the same list, so a learner's request and this record cannot disagree.
const { subjects } = await loadReviewSubjects();
---
<BaseLayout title="Record an independent review" description="A review record for a rank, a specialist belt or a cross-field transfer: each criterion with its evidence, the unseen task, one strength and one gap, kept on the reviewer's device.">
  <PageHero compact eyebrow="Ranks · specialist belts · transfers · independent review" title="Record an independent review" subtitle="For the reviewer in a pilot review: record each criterion against real evidence, then copy the review log. Nothing leaves your device." ctas={[{ label: 'Start recording', href: '#rr-title', icon: 'arrow-right' }, { label: 'What each rank and belt asks', href: '/assessment-map', variant: 'ghost', icon: 'arrow-right' }]} />

  <section class="section"><div class="container content">
    <p class="boundary" data-record-boundary><strong>A record, not an award:</strong> Finishing a review record issues no belt and no rank, and the rubrics it uses are proposed, not approved. A rank certificate still follows the <a href="/certificates">certificate process</a>, with a separate Maintainer deciding. Dojo assessment is not professional licensure or accreditation. This website takes no authenticated submissions: the record stays on your device until you copy it.</p>
    <h2>How to use it</h2>
    <ol class="steps">
      <li><strong>Before the session,</strong> agree scope, access and consent with the learner in writing, and check you are independent. The form will not finish without both.</li>
      <li><strong>Choose what you review:</strong> a rank rubric, a specialist belt in one field at the Brown or Black stage, or a learner's transfer of the foundation technique into one field from the <a href="/mission-playbook#practice">mission playbook</a>. The criteria and, for a belt or a transfer, the field's own limit appear below. For a transfer you also see the field's reference, its review gate, the checks to rerun and the kind of unseen change to set.</li>
      <li><strong>Set the unseen task</strong> when the work starts, then open the original artifact and observe.</li>
      <li><strong>Record every criterion</strong> as Observed, Not yet observed or Unclear, each with an evidence reference: a file, a check result, a log line or a moment in the session. Absence of evidence is not a pass, so the form will not finish without a reference.</li>
      <li><strong>Finish and copy</strong> the review log into the confidential case issue. A finished record is locked; a mistake is fixed with a dated correction added below it, never by editing.</li>
    </ol>
  </div></section>

  <section class="section outcome"><div class="container content">
    <ReviewRecord subjects={subjects} />
    <p class="no-js">The review record needs JavaScript. Without it, write the review log by hand in the layout of the <a href="/assessment-map#pilot">review pilot</a>: the rubric, each criterion with its observation and evidence reference, the unseen task, the failures seen, one strength, one gap and the time taken. The criteria are on the <a href="/assessment-map#rubrics">assessment map</a>.</p>
    <p>The learner prepares their side with a <a href="/review-request">review request</a>: where each kind of evidence is, the scope of consent and the subject. Read it before the session.</p>
    <p>You can copy or delete everything this site saved in your browser from <a href="/train#device-data-title">Saved on this device</a>. Learner work and review notes stay private unless the learner gives written consent to share them.</p>
  </div></section>
</BaseLayout>
<style>
  .content { max-width: 75rem; }
  .content > p, .content > ol { max-width: 75ch; }
  .outcome { background: var(--paper-raised); }
  .boundary { padding: var(--space-4); border-left: 4px solid var(--tone-gold); background: var(--paper-sunk); }
  .steps li + li { margin-top: var(--space-2); }
</style>
