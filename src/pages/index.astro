---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import NoteCard from '../components/NoteCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import RankPath from '../components/RankPath.astro';
import DarkPanel from '../components/DarkPanel.astro';
import EventList from '../components/EventList.astro';
import ChallengeList from '../components/ChallengeList.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Pagoda from '../components/Pagoda.astro';

const learn = [
  { icon: 'lightbulb', title: 'Strategy and product', description: 'Decide which problem is worth solving, for whom, and why.', tone: 'gold' },
  { icon: 'users', title: 'Customers and design', description: 'Find real needs, shape the experience and the brand.', tone: 'olive' },
  { icon: 'list-checks', title: 'Epics and roadmaps', description: 'Write them yourself. People decide; AI never does.', tone: 'gold' },
  { icon: 'bot', title: 'Directing AI agents', description: 'Use, delegate, orchestrate and govern agents with clear briefs.', tone: 'olive' },
  { icon: 'shield-check', title: 'Verify and manage risk', description: 'Read the diff, check the output, ask the security and cost questions.', tone: 'gold' },
  { icon: 'rocket', title: 'Ship and operate', description: 'Launch to real users, measure, and improve.', tone: 'olive' },
] as const;

const bar = [
  { icon: 'compass', title: 'You decide', description: 'What to build and why, who it is for, and what good enough means. No agent decides this for you.', tone: 'gold' },
  { icon: 'bot', title: 'Agents do the lower-level work', description: 'Code, tests, drafts, data wrangling and routine tasks, from a brief you wrote.', tone: 'olive' },
  { icon: 'badge-check', title: 'You verify and answer for it', description: 'You check what comes back and you own the result with real users.', tone: 'rust' },
] as const;
---

<BaseLayout
  rawTitle
  title="Developer Dojo: free training for the new kind of developer"
  description="Developer Dojo is free training for the 2030 Product Development Manager: blend every discipline, direct AI agents to do the lower-level work, and ship real products."
>
  <PageHero
    title="Developer: the new bar"
    accent="."
    eyebrow="The 2030 Product Development Manager"
    highlight="Free training"
    subtitle="for the top 0.1% of product people. You blend strategy, product, design, finance, operations and engineering, and you direct AI agents to do the lower-level work. You decide what to build and why, and you verify what comes back."
    ctas={[
      { label: 'Start free', href: '/membership', icon: 'arrow-right' },
      { label: 'See the role', href: '/library/the-2030-product-development-manager', variant: 'ghost', icon: 'play' },
    ]}
  >
    <NoteCard
      slot="side"
      title="A 2030 Product Development Manager can..."
      items={[
        'Decide what to build and why',
        'Write the spec and acceptance criteria',
        'Own the epics and the roadmap',
        'Direct and orchestrate AI agents',
        'Verify what the agents produce',
        'Ship to real users and learn',
      ]}
    />
  </PageHero>

  <section class="section tight" aria-label="The bar">
    <div class="container">
      <SectionHeader
        eyebrow="Who we train"
        title="The bar is high on purpose."
        intro="Agents can now write the code. The scarce skill is deciding what is worth building and being sure it is right. That is the job we train for, and it is free."
      />
      <div class="bar-grid"><FeatureGrid items={bar} columns={3} /></div>
      <p class="bar-link"><a href="/library/the-2030-product-development-manager">Read what the role is <Icon name="arrow-right" size={16} /></a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="path-title">
    <div class="container path has-pagoda">
      <div id="path-title">
        <SectionHeader
          eyebrow="Training path"
          title="Your path to leading the product."
          intro="A clear, hands-on progression: own one product, then run a whole one with agents, then coach others to do the same."
        />
      </div>
      <RankPath linked />
      <Pagoda />
    </div>
  </section>

  <section class="section tight">
    <div class="container two-up">
      <DarkPanel
        split={false}
        art="bamboo"
        icon="monitor-play"
        title="Watch builders live."
        text="Members can watch developers build real products in real time, ask questions, and learn from their process, decisions, and tools (including AI agents)."
      >
        <h3 class="panel-sub">Upcoming live build sessions</h3>
        <EventList limit={3} />
      </DarkPanel>
      <div class="earn">
        <SectionHeader
          eyebrow="Contribute and be recognised"
          title="Share, mentor, and grow the community."
          intro="Senseis and advanced members earn points for the time they spend screen-sharing, mentoring, and collaborating with juniors. Reward tiers are being finalised."
        />
        <ul class="earn-list">
          <li><Icon name="clock" size={20} /> Hours shared</li>
          <li><Icon name="star" size={20} /> Mentoring points</li>
          <li><Icon name="award" size={20} /> Certification bonus</li>
          <li><Icon name="coins" size={20} /> Reward tiers (coming)</li>
        </ul>
        <Button href="/sensei" variant="outline" icon="arrow-right">How Sensei works</Button>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="learn-title">
    <div class="container">
      <div id="learn-title">
        <SectionHeader
          eyebrow="The academy"
          title="What you'll learn."
          intro="Enough depth in every discipline to direct agents and judge their work. We teach you to decide and verify, not to hand-type everything."
        />
      </div>
      <div class="learn">
        <FeatureGrid items={learn} columns={6} variant="inline" />
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container two-up">
      <DarkPanel
        split
        icon="calendar-days"
        title="Upcoming events"
        text="Live sessions, workshops, and community gatherings."
      >
        <EventList limit={3} />
      </DarkPanel>
      <DarkPanel
        split
        icon="trophy"
        title="Active challenges"
        text="Apply what you learn, build in public, and earn recognition."
      >
        <ChallengeList />
      </DarkPanel>
    </div>
  </section>
</BaseLayout>

<style>
  .bar-grid {
    margin-top: var(--space-5);
  }
  .bar-link {
    margin-top: var(--space-4);
    font-weight: 700;
  }
  .path {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  @media (min-width: 80rem) {
    .path {
      grid-template-columns: 17rem minmax(0, 1fr);
      align-items: center;
    }
  }
  .tight {
    padding-block: var(--space-4);
  }
  .two-up {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  @media (min-width: 62rem) {
    .two-up {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .panel-sub {
    margin: 0 0 var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--band-text);
  }
  .earn {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    align-content: center;
  }
  .earn-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .earn-list li {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-3);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-weight: 600;
  }
  .earn-list :global(svg) {
    color: var(--gold-text);
  }
  @media (max-width: 30rem) {
    /* A phone at 200 percent zoom: one tile per row, so a word is never squeezed into half a column. */
    .earn-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .earn :global(.btn) {
    justify-self: start;
  }
  .learn {
    margin-top: var(--space-5);
  }
</style>
