---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import RankPath from '../components/RankPath.astro';
import DarkPanel from '../components/DarkPanel.astro';
import EventList from '../components/EventList.astro';
import ChallengeList from '../components/ChallengeList.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Icon from '../components/Icon.astro';
import Pagoda from '../components/Pagoda.astro';
import QuickStack from '../components/QuickStack.astro';

const spaces = [
  { number: '01', title: 'Gallery', description: 'Find the outcomes that give a kata its purpose.', href: '/gallery', action: 'Visit the Gallery' },
  { number: '02', title: 'Katas', description: 'Study a repeatable technique, from outcome to evidence.', href: '/katas', action: 'Study the approach' },
  { number: '03', title: 'Stack Lab', description: 'Learn the common layers behind an agent development system.', href: '/stack-lab', action: 'Explore the stack' },
  { number: '04', title: 'Fields', description: 'See how shared foundations meet the needs of different fields.', href: '/fields', action: 'Explore fields' },
  { number: '05', title: 'Armory', description: 'Understand the tools and skills agents can be equipped with.', href: '/armory', action: 'Visit the Armory' },
  { number: '06', title: 'Arena', description: 'Learn how to compare models, harnesses and complete stacks.', href: '/arena', action: 'Visit the Arena' },
  { number: '07', title: 'Belts', description: 'See how a field-specific capability can be demonstrated.', href: '/belts', action: 'Explore belts' },
  { number: '08', title: 'Randori', description: 'Meet an unfamiliar challenge and decide how to solve it.', href: '/randori', action: 'Explore Randori' },
  { number: '09', title: 'Missions', description: 'Take what you practice into real work with appropriate review.', href: '/missions', action: 'Explore missions' },
] as const;

const fields = [
  { title: 'Digital products & UX', description: 'Journeys, prototypes, software and accessible experiences.' },
  { title: '3D, BIM & construction', description: 'Editable models, coordination and the built environment.' },
  { title: 'Robotics & manufacturing', description: 'Physical systems, simulation, design and production.' },
  { title: 'Science & health', description: 'Research, models and evidence with qualified review.' },
  { title: 'Energy & agriculture', description: 'Develop work for the natural and built world.' },
  { title: 'Media & business', description: 'Creative work, communication and useful workflows.' },
] as const;

const learn = [
  { icon: 'lightbulb', title: 'Outcomes and evidence', description: 'Define the goal, constraints and proof of success.', tone: 'gold' },
  { icon: 'users', title: 'Field expertise', description: 'Learn the tools, standards and reviews your field needs.', tone: 'olive' },
  { icon: 'list-checks', title: 'Instructions and context', description: 'Give agents clear direction and the information they need.', tone: 'gold' },
  { icon: 'bot', title: 'Agent stacks', description: 'Choose harnesses, models, skills and integrations for the work.', tone: 'olive' },
  { icon: 'shield-check', title: 'Verify and manage risk', description: 'Check results, permissions, limitations and costs.', tone: 'gold' },
  { icon: 'rocket', title: 'Practice and adapt', description: 'Repeat a technique, learn from the evidence and apply it to a new goal.', tone: 'olive' },
] as const;

const bar = [
  { icon: 'compass', title: 'Choose an outcome', description: 'Define what you want to develop, for whom, and how you will judge it.', tone: 'gold' },
  { icon: 'bot', title: 'Assemble your stack', description: 'Equip and orchestrate agents with the right context, tools and permissions.', tone: 'olive' },
  { icon: 'badge-check', title: 'Verify and adapt', description: 'Examine the evidence, improve the result and take responsibility for it.', tone: 'rust' },
] as const;
---

<BaseLayout
  rawTitle
  title="Developer Dojo: free training for the new kind of developer"
  description="Developer Dojo teaches the universal skills of developing outcomes with AI agents, from the shared stack to specialized fields."
>
  <PageHero
    title="What will you develop"
    accent="?"
    eyebrow="Master the stack. Master the katas. Develop anything."
    subtitle="Turn an idea into something real with AI, even from your phone. The orchestrator is the developer."
    ctas={[
      { label: 'Build a prototype', href: '/katas/first-prototype', icon: 'arrow-right' },
      { label: 'Turn an idea into a plan', href: '/katas/spark-ideas', variant: 'ghost', icon: 'play' },
    ]}
  >
    <div slot="side" class="hero-art">
      <img src="/images/kata-spark.webp" width="1672" height="941" alt="" />
      <p>Imagine it. Make it. Make it better.</p>
    </div>
  </PageHero>

  <section class="section showcase" aria-labelledby="showcase-title">
    <div class="container">
      <div id="showcase-title"><SectionHeader eyebrow="Start creating" title="Pick a result. Make it yours." intro="Choose a beginner kata or learn with a workshop." /></div>
      <div class="showcase-grid">
        <article class="showcase-card prototype-card">
          <div class="showcase-copy">
            <span class="showcase-tag">Beginner · about 15 minutes</span>
            <h3>Make a clickable prototype</h3>
            <p>Turn an idea into a small interactive experience. Try our working example, then build your own.</p>
            <a class="showcase-action" href="/katas/first-prototype">Start this kata <Icon name="arrow-right" size={18} /></a>
            <a class="showcase-secondary" href="/examples/pocket-garden.html">Open the working example</a>
          </div>
          <div class="example-window">
            <p>Try the example</p>
            <iframe src="/examples/pocket-garden.html" title="Pocket Garden working prototype example" loading="lazy" sandbox="allow-scripts"></iframe>
          </div>
        </article>
        <article class="showcase-card brief-card">
          <div class="showcase-copy">
            <span class="showcase-tag">Beginner · about 10 minutes</span>
            <h3>Turn an idea into a plan</h3>
            <p>Give your idea a purpose, an audience, and a first step with a one-page brief.</p>
            <a class="showcase-action" href="/katas/spark-ideas">Start the idea kata <Icon name="arrow-right" size={18} /></a>
          </div>
          <div class="brief-visual" aria-hidden="true">
            <span>YOUR IDEA</span><strong>→</strong><span>ONE CLEAR PLAN</span>
          </div>
        </article>
        <article class="showcase-card brief-card">
          <div class="showcase-copy">
            <span class="showcase-tag">Beginner · about 10 minutes</span>
            <h3>Rescue messy data</h3>
            <p>Turn a small fictional spreadsheet into a report you can check.</p>
            <a class="showcase-action" href="/katas/data-rescue">Start the data kata <Icon name="arrow-right" size={18} /></a>
          </div>
          <div class="brief-visual" aria-hidden="true"><span>MESSY DATA</span><strong>→</strong><span>CHECKED REPORT</span></div>
        </article>
        <article class="showcase-card brief-card">
          <div class="showcase-copy">
            <span class="showcase-tag">Official training · Dojo practice</span>
            <h3>Make something in your field</h3>
            <p>Explore creative work, design, business and more with an AI assistant and real provider training.</p>
            <a class="showcase-action" href="/katas/industry-workshops">Explore industry workshops <Icon name="arrow-right" size={18} /></a>
          </div>
          <div class="brief-visual" aria-hidden="true"><span>YOUR FIELD</span><strong>→</strong><span>YOUR CREATION</span></div>
        </article>
        <article class="showcase-card brief-card">
          <div class="showcase-copy">
            <span class="showcase-tag">Official provider training</span>
            <h3>Build in the cloud</h3>
            <p>Choose Azure, AWS, Oracle or Google Cloud and learn with their own tutorials.</p>
            <a class="showcase-action" href="/katas/cloud-workshops">Explore cloud workshops <Icon name="arrow-right" size={18} /></a>
          </div>
          <div class="brief-visual" aria-hidden="true"><span>LEARN</span><strong>→</strong><span>BUILD</span><strong>→</strong><span>CHECK</span></div>
        </article>
        <article class="showcase-card brief-card">
          <div class="showcase-copy">
            <span class="showcase-tag">Beginner · about 10 minutes</span>
            <h3>Spot the AI mistakes</h3>
            <p>Find three errors in a report and make it trustworthy.</p>
            <a class="showcase-action" href="/katas/error-clinic">Start the error clinic <Icon name="arrow-right" size={18} /></a>
          </div>
          <div class="brief-visual" aria-hidden="true"><span>CHECK</span><strong>→</strong><span>REPAIR</span></div>
        </article>
      </div>
      <p class="showcase-browse"><a href="/katas">Explore katas <Icon name="arrow-right" size={16} /></a></p>
      <p>More ways to practice: <a href="/katas/decision-replay">Decision Replay</a> · <a href="/katas/constraint-roulette">Constraint Roulette</a> · <a href="/katas/budget-boss">Compare two stacks</a> · <a href="/katas/portfolio">Make a portfolio</a> · <a href="/katas/pocket-dojo">Practice offline</a></p>
      <QuickStack />
    </div>
  </section>

  <section class="section tight" aria-label="The bar">
    <div class="container">
      <SectionHeader
        eyebrow="Who we train"
        title="Develop outcomes across fields."
        intro="A developer can orchestrate software, designs, research, workflows and more. Shared foundations travel across fields; each field adds its own expertise and standards."
      />
      <div class="bar-grid"><FeatureGrid items={bar} columns={3} /></div>
      <p class="bar-link"><a href="/membership">Start free <Icon name="arrow-right" size={16} /></a> <span aria-hidden="true"> · </span> <a href="/library/the-2030-product-development-manager">Explore the existing product development path <Icon name="arrow-right" size={16} /></a></p>
    </div>
  </section>

  <section class="section explore" aria-labelledby="explore-title">
    <div class="container">
      <div id="explore-title">
        <SectionHeader
          eyebrow="Explore the Dojo"
          title="From an outcome to the skills to develop it."
          intro="Discover the spaces that make up the Dojo. Some are starting points while their complete collections and assessments are being developed."
        />
      </div>
      <div class="space-grid">
        {spaces.map((space) => (
          <article class="space-card">
            <span class="space-number" aria-hidden="true">{space.number}</span>
            <h3>{space.title}</h3>
            <p>{space.description}</p>
            <a href={space.href}>{space.action} <Icon name="arrow-right" size={16} /></a>
          </article>
        ))}
      </div>
      <p class="sensei-link">Ready to share what you learn? <a href="/sensei">Meet the Sensei community <Icon name="arrow-right" size={16} /></a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="field-title">
    <div class="container">
      <div id="field-title">
        <SectionHeader
          eyebrow="One foundation, many fields"
          title="Development crosses industries."
          intro="Your foundation in harnesses, models, instructions, tools and verification can travel with you. Each field adds its own skills, standards and forms of review."
        />
      </div>
      <ul class="field-grid">
        {fields.map((field) => (
          <li><strong>{field.title}</strong><span>{field.description}</span></li>
        ))}
      </ul>
      <p class="field-note">These are examples of where the Dojo can grow; a full set of katas is not yet available for every field. <a href="/fields">Explore the fields <Icon name="arrow-right" size={16} /></a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="path-title">
    <div class="container path has-pagoda">
      <div id="path-title">
        <SectionHeader
          eyebrow="Training path"
          title="Grow as a developer."
          intro="Practice, adapt and teach. Our existing product training remains available as the Dojo grows into more fields."
        />
      </div>
      <RankPath linked />
      <Pagoda />
    </div>
  </section>

  <section class="section" aria-labelledby="learn-title">
    <div class="container">
      <div id="learn-title">
        <SectionHeader
          eyebrow="The academy"
          title="What you'll learn."
          intro="Build shared development skills, then apply them with the expertise and review your chosen field requires."
        />
      </div>
      <div class="learn">
        <FeatureGrid items={learn} columns={6} variant="inline" />
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container two-up">
      <DarkPanel
        split
        icon="calendar-days"
        title="Upcoming events"
        text="Live sessions, workshops, and community gatherings."
      >
        <EventList limit={3} />
      </DarkPanel>
      <DarkPanel
        split
        icon="trophy"
        title="Active challenges"
        text="Apply what you learn, build in public, and earn recognition."
      >
        <ChallengeList />
      </DarkPanel>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-art { overflow: hidden; border-radius: var(--radius); border: 1px solid rgb(255 255 255 / .3); background: var(--band); box-shadow: var(--shadow); }
  .hero-art img { display: block; width: 100%; height: 15rem; object-fit: cover; }
  .hero-art p { margin: 0; padding: var(--space-3) var(--space-4); color: var(--band-text); font-weight: 700; }
  .showcase { padding-block: var(--space-6); }
  .showcase-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); margin-top: var(--space-5); }
  .showcase-card { display: grid; grid-template-columns: minmax(0, 1fr); overflow: hidden; background: var(--paper-raised); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
  .showcase-copy { display: grid; align-content: start; justify-items: start; gap: var(--space-3); padding: var(--space-5); }
  .showcase-copy h3 { margin: 0; font-size: var(--text-2xl); overflow-wrap: anywhere; }
  .showcase-copy p { margin: 0; max-width: 42ch; }
  .showcase-tag { color: var(--olive-text); font-size: var(--text-sm); font-weight: 700; }
  .showcase-action { display: inline-flex; align-items: center; gap: var(--space-2); padding: .75rem 1rem; background: #294333; color: #fff; border-radius: var(--radius); font-weight: 700; text-decoration: none; }
  .showcase-action:hover { text-decoration: underline; }
  .showcase-secondary, .showcase-browse a { font-weight: 700; }
  .showcase-browse { margin: var(--space-4) 0; }
  .showcase-browse a { display: inline-flex; align-items: center; gap: var(--space-2); }
  .example-window { padding: var(--space-4); background: var(--paper-sunk); }
  .example-window p { margin: 0 0 var(--space-2); color: var(--ink-muted); font-size: var(--text-sm); font-weight: 700; }
  .example-window iframe { display: block; width: 100%; height: 22rem; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .brief-visual { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-3); min-height: 8rem; padding: var(--space-4); background: var(--paper-sunk); color: var(--olive-text); font-weight: 700; text-align: center; }
  .brief-visual strong { font-size: var(--text-2xl); }
  @media (min-width: 62rem) {
    .prototype-card { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); }
    .showcase-grid { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
    .brief-card { grid-template-rows: 1fr auto; }
  }
  .bar-grid {
    margin-top: var(--space-5);
  }
  .bar-link {
    margin-top: var(--space-4);
    font-weight: 700;
  }
  .path {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  @media (min-width: 80rem) {
    .path {
      grid-template-columns: 17rem minmax(0, 1fr);
      align-items: center;
    }
  }
  .tight {
    padding-block: var(--space-4);
  }
  .two-up {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  @media (min-width: 62rem) {
    .two-up {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .explore {
    background: var(--paper-sunk);
  }
  .space-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .space-card {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-top: 4px solid var(--tone-olive);
    border-radius: var(--radius);
    background: var(--paper-raised);
    box-shadow: var(--shadow);
  }
  .space-card:nth-child(3n + 2) { border-top-color: var(--tone-gold); }
  .space-card:nth-child(3n) { border-top-color: var(--tone-rust); }
  .space-number {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }
  .space-card h3 { margin: 0; font-size: var(--text-xl); }
  .space-card p { margin: 0 0 var(--space-2); color: var(--ink-muted); }
  .space-card a, .sensei-link a, .field-note a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
  }
  .sensei-link { margin: var(--space-5) 0 0; }
  .field-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0 var(--space-4);
  }
  .field-grid li {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border-left: 3px solid var(--tone-gold);
    background: var(--paper-raised);
  }
  .field-grid span { color: var(--ink-muted); }
  .field-note { max-width: 70ch; }
  @media (min-width: 40rem) {
    .space-grid, .field-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 62rem) {
    .space-grid, .field-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .learn {
    margin-top: var(--space-5);
  }
</style>
