<?xml version="1.0" encoding="UTF-8"?>
<!-- Three requirement cards for the BIM Randori (BIM-R01). A partner reveals one after the learner has started. Invented for teaching. Not a client, regulatory or professional requirement. MIT licence. -->
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <ids:info>
    <ids:title>Developer Dojo BIM Randori cards</ids:title>
    <ids:copyright>Developer Dojo, MIT licence</ids:copyright>
    <ids:version>1.0.0</ids:version>
    <ids:description>Three requirement cards for the BIM Randori (BIM-R01). A partner reveals one after the learner has started.</ids:description>
    <ids:date>2026-11-21</ids:date>
    <ids:purpose>Teaching: an unseen requirement change</ids:purpose>
    <ids:milestone>Practice</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification name="Card A: windows carry a fire rating label too" ifcVersion="IFC4" identifier="CARD-A" description="Every window has Pset_WindowCommon.FireRating in the practice format, for example REI 30." instructions="The label comes from the practice brief. It is not a fire assessment.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity><ids:name><ids:simpleValue>IFCWINDOW</ids:simpleValue></ids:name></ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL">
          <ids:propertySet><ids:simpleValue>Pset_WindowCommon</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>FireRating</ids:simpleValue></ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="REI [0-9]{2,3}"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Card B: every wall has a material" ifcVersion="IFC4" identifier="CARD-B" description="Every wall has a material assigned." instructions="Prove it from the model; do not assume it.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity><ids:name><ids:simpleValue>IFCWALL</ids:simpleValue></ids:name></ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:material/>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Card C: wall thermal transmittance at most 0.30 W/(m2 K)" ifcVersion="IFC4" identifier="CARD-C" description="Every wall has Pset_WallCommon.ThermalTransmittance of 0.30 W/(m2 K) or less. IDS values are in SI units." instructions="Check the unit before you compare the number.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity><ids:name><ids:simpleValue>IFCWALL</ids:simpleValue></ids:name></ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTHERMALTRANSMITTANCEMEASURE">
          <ids:propertySet><ids:simpleValue>Pset_WallCommon</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>ThermalTransmittance</ids:simpleValue></ids:baseName>
          <ids:value>
            <xs:restriction base="xs:double">
              <xs:maxInclusive value="0.30"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>
