{
  "about": "Worked UX Randori rounds (UX-R01) for the partner cards in the kata download. Each round is one brief and one hidden constraint: the first flow is the sitemap drawn before the constraint was revealed, the adapted flow is the one that meets it. Written by the Dojo maintainers, who also wrote the cards, so the constraint was not hidden from them. tools/ux_randori.mjs checks both flows and records what the constraint changed. A round whose constraint is about the screens (place on an element: its row and column on the screen) is also written out as one HTML page per state, which a browser test walks with the Tab key.",
  "rounds": [
    {
      "id": "A",
      "brief": "A library app: a member reserves a book, is told when it is ready, and can cancel.",
      "constraint": { "id": "undo-30s", "text": "The user must be able to undo the last action for 30 seconds." },
      "changed": "Reserving and cancelling now show Undo for 30 seconds. The confirmation dialog before cancelling is gone: Undo protects the user better, with one step fewer.",
      "first": {
        "product": { "name": "Library reservations", "job": "A member reserves a book, hears when it is ready, and can cancel.", "audience": "Library members on a phone or a computer." },
        "screens": [
          { "id": "catalogue", "name": "Catalogue" },
          { "id": "book", "name": "Book" },
          { "id": "reservations", "name": "My reservations" }
        ],
        "start": "search",
        "states": [
          { "id": "search", "screen": "catalogue", "kind": "screen", "title": "Find a book", "purpose": "The member searches by title or author.", "elements": [
            { "type": "heading", "text": "Find a book" },
            { "type": "field", "label": "Title or author", "value": "The Night Garden" },
            { "type": "button", "label": "Search", "variant": "primary", "to": "results" }
          ] },
          { "id": "results", "screen": "catalogue", "kind": "screen", "title": "2 books found", "purpose": "The matches, with whether a copy is on the shelf.", "elements": [
            { "type": "heading", "text": "2 books found" },
            { "type": "button", "label": "The Night Garden", "variant": "link", "to": "book" },
            { "type": "button", "label": "Change the search", "variant": "link", "to": "search" }
          ] },
          { "id": "book", "screen": "book", "kind": "screen", "title": "The Night Garden", "purpose": "One book: whether it is on loan and how long the wait is.", "elements": [
            { "type": "heading", "text": "The Night Garden" },
            { "type": "text", "text": "All 3 copies are on loan. The wait is about 2 weeks." },
            { "type": "button", "label": "Reserve", "variant": "primary", "to": "reserved" },
            { "type": "button", "label": "Back to the results", "variant": "link", "to": "results" }
          ] },
          { "id": "reserved", "screen": "reservations", "kind": "success", "title": "Reserved", "purpose": "Says what happens next.", "elements": [
            { "type": "heading", "text": "Reserved" },
            { "type": "text", "text": "We will email you when it is ready to collect." },
            { "type": "button", "label": "My reservations", "variant": "primary", "to": "my-reservations" }
          ] },
          { "id": "my-reservations", "screen": "reservations", "kind": "screen", "title": "My reservations", "purpose": "Every reservation and its place in the queue.", "elements": [
            { "type": "heading", "text": "My reservations" },
            { "type": "text", "text": "The Night Garden: waiting, number 2 in the queue." },
            { "type": "button", "label": "Cancel reservation", "variant": "secondary", "to": "cancel-dialog" },
            { "type": "button", "label": "Find another book", "variant": "link", "to": "search" }
          ] },
          { "id": "cancel-dialog", "screen": "reservations", "kind": "overlay", "title": "Cancel this reservation?", "purpose": "Asks before the member loses their place.", "elements": [
            { "type": "heading", "text": "Cancel this reservation?" },
            { "type": "text", "text": "You lose your place in the queue." },
            { "type": "button", "label": "Keep it", "variant": "primary", "to": "my-reservations" },
            { "type": "button", "label": "Cancel reservation", "variant": "secondary", "to": "cancelled" }
          ] },
          { "id": "cancelled", "screen": "reservations", "kind": "success", "title": "Reservation cancelled", "purpose": "Confirms the cancellation.", "elements": [
            { "type": "heading", "text": "Reservation cancelled" },
            { "type": "button", "label": "Find another book", "variant": "primary", "to": "search" }
          ] },
          { "id": "ready", "screen": "reservations", "kind": "screen", "title": "Ready to collect", "purpose": "Where the email sends the member when the book comes back.", "elements": [
            { "type": "heading", "text": "Ready to collect" },
            { "type": "text", "text": "Collect The Night Garden from the front desk within 7 days." },
            { "type": "button", "label": "My reservations", "variant": "link", "to": "my-reservations" }
          ] }
        ],
        "transitions": [
          { "from": "search", "to": "results", "kind": "forward", "trigger": "Search" },
          { "from": "results", "to": "book", "kind": "forward", "trigger": "Choose a book" },
          { "from": "results", "to": "search", "kind": "back", "trigger": "Change the search" },
          { "from": "book", "to": "reserved", "kind": "forward", "trigger": "Reserve", "commits": true },
          { "from": "book", "to": "results", "kind": "back", "trigger": "Back to the results" },
          { "from": "reserved", "to": "my-reservations", "kind": "forward", "trigger": "My reservations" },
          { "from": "my-reservations", "to": "cancel-dialog", "kind": "overlay-open", "trigger": "Cancel reservation" },
          { "from": "my-reservations", "to": "search", "kind": "back", "trigger": "Find another book" },
          { "from": "my-reservations", "to": "ready", "kind": "branch", "trigger": "The book comes back; the email links here" },
          { "from": "cancel-dialog", "to": "my-reservations", "kind": "overlay-close", "trigger": "Keep it, or Escape" },
          { "from": "cancel-dialog", "to": "cancelled", "kind": "forward", "trigger": "Cancel reservation", "commits": true },
          { "from": "cancelled", "to": "search", "kind": "forward", "trigger": "Find another book" },
          { "from": "ready", "to": "my-reservations", "kind": "back", "trigger": "My reservations" }
        ]
      },
