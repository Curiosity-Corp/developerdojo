            { "type": "button", "label": "Reserve", "variant": "primary", "to": "reserved" },
            { "type": "button", "label": "Back to the results", "variant": "link", "to": "results" }
          ] },
          { "id": "reserved", "screen": "reservations", "kind": "success", "title": "Reserved", "purpose": "Says what happens next, and offers Undo for 30 seconds.", "undoSeconds": 30, "elements": [
            { "type": "heading", "text": "Reserved" },
            { "type": "text", "text": "We will email you when it is ready to collect. You can undo this for 30 seconds." },
            { "type": "button", "label": "Undo", "variant": "secondary", "to": "book" },
